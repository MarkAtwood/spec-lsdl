# -----------------------------------------------------------------------------
# insular.d - Insular D shape (rounded)
# Used for Old English/Irish manuscripts
# -----------------------------------------------------------------------------
@elem insular.d.cap
zone: cap
path: p1 p2 p3 p4 p5
p1 = [10,0]
p2 = [2,0]
p3 = C([0,0] [0,4])
p4 = C([0,8] [6,8])
p5 = C([10,8] [10,4])
close: true
width: 1
anchors: top=[6,0] base=[6,8]
@end

@elem insular.d.small
zone: full
path: p1 p2 p3 p4 p5
p1 = [10,1]
p2 = [10,6]
p3 = C([10,8] [6,8])
p4 = C([2,8] [2,6])
p5 = C([2,4] [10,4])
close: true
width: 1
anchors: top=[10,1] base=[6,8]
@end

