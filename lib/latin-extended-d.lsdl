@lsdl 1.0

# =============================================================================
# LSDL Latin Extended-D Character Library (U+A720-A7FF)
# =============================================================================
#
# This file defines the 199 characters in the Latin Extended-D Unicode block.
# These characters are used for medieval manuscripts, Africanist linguistics,
# Old English/Irish (insular forms), Visigothic texts, and various historical
# orthographies.
#
# Categories:
#   - Modifier letters (stress/tone marks)
#   - Egyptological letters (alef, ain)
#   - Medieval abbreviation letters (heng, tresillo, cuatrillo)
#   - Ligatures (AA, AO, AU, AV, AY, OO, TZ, VY)
#   - K variants with strokes (medieval)
#   - Insular letters (D, F, G, R, S, T for Old English/Irish)
#   - Africanist letters (turned forms)
#   - Visigothic letters (Z variant)
#   - P/Q variants with descender strokes
#   - Volapuk letters (AE, OE, UE)
#   - Greek-derived letters (beta, omega, chi, lambda)
#   - Epigraphic letters (reversed F, P, inverted M, etc.)
#
# Composition patterns:
#   - DIA: Single diacritic attachment
#   - OVR: Stroke overlays
#   - FRAME: Complex letterforms with hooks, tails
#   - LR: Digraphs and compound letters
#   - sc: Rotations and mirroring
#
# =============================================================================

# =============================================================================
# SPECIAL ELEMENTS FOR LATIN EXTENDED-D
# =============================================================================

# -----------------------------------------------------------------------------
# egyptological.alef - Egyptological alef shape (like half-ring)
# For Egyptological Alef letters
# -----------------------------------------------------------------------------
@elem egyptological.alef.cap
zone: cap
path: p1 p2 p3
p1 = [8,0]
p2 = C([2,0] [2,4])
p3 = C([2,8] [8,8])
close: false
width: 1
anchors: top=[6,0] base=[6,8]
@end

@elem egyptological.alef.small
zone: x-height
path: p1 p2 p3
p1 = [8,4]
p2 = C([2,4] [2,6])
p3 = C([2,8] [8,8])
close: false
width: 1
anchors: top=[6,4] base=[6,8]
@end

# -----------------------------------------------------------------------------
# egyptological.ain - Egyptological ain shape (like reversed half-ring)
# -----------------------------------------------------------------------------
@elem egyptological.ain.cap
zone: cap
path: p1 p2 p3
p1 = [4,0]
p2 = C([10,0] [10,4])
p3 = C([10,8] [4,8])
close: false
width: 1
anchors: top=[6,0] base=[6,8]
@end

@elem egyptological.ain.small
zone: x-height
path: p1 p2 p3
