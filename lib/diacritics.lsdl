@lsdl 1.0

# =============================================================================
# LSDL Combining Diacritical Marks Library
# =============================================================================
#
# Complete coverage of Unicode block U+0300-036F (112 combining marks).
#
# Categories:
#   - Above marks: accent marks positioned above base characters
#   - Below marks: marks positioned below base characters
#   - Through/overlay marks: marks that cross through base characters
#   - Double marks: marks that span two base characters
#   - Superscript letters: small letter forms used as diacritics
#
# Zone assignments:
#   diacritic-above: y=0 to y=2 (above cap-height)
#   diacritic-below: y=8 to y=11 (below baseline into descender)
#   x-height: y=4 to y=8 (for through-marks, centered on base)
#
# All diacritics MUST define an `attach` anchor per Section 15.2.
#
# =============================================================================

# =============================================================================
# ABOVE MARKS
# =============================================================================

# -----------------------------------------------------------------------------
# grave - Falling diagonal stroke
# Unicode: U+0300 COMBINING GRAVE ACCENT
# Stroke: top-right to bottom-left (falling)
# -----------------------------------------------------------------------------
@elem grave
zone: diacritic-above
path: p1 p2
p1 = [7,0]
p2 = [5,2]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# acute - Rising diagonal stroke
# Unicode: U+0301 COMBINING ACUTE ACCENT
# Stroke: top-left to bottom-right (rising appearance, but drawn top-down)
# -----------------------------------------------------------------------------
@elem acute
zone: diacritic-above
path: p1 p2
p1 = [5,0]
p2 = [7,2]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# circumflex - Inverted V shape (hat)
# Unicode: U+0302 COMBINING CIRCUMFLEX ACCENT
# -----------------------------------------------------------------------------
@elem circumflex
zone: diacritic-above
path: p1 p2 p3
p1 = [4,2]
p2 = [6,0]
p3 = [8,2]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# tilde - Wave-shaped mark
# Unicode: U+0303 COMBINING TILDE
# -----------------------------------------------------------------------------
@elem tilde
zone: diacritic-above
path: p1 p2 p3
p1 = [3,2]
p2 = C([5,0] [7,2])
p3 = [9,0]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# macron - Horizontal bar above
# Unicode: U+0304 COMBINING MACRON
# -----------------------------------------------------------------------------
@elem macron
zone: diacritic-above
path: p1 p2
p1 = [4,1]
p2 = [8,1]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# overline - Full-width horizontal line above
# Unicode: U+0305 COMBINING OVERLINE
# Note: Longer than macron, spans full character width
# -----------------------------------------------------------------------------
@elem overline
zone: diacritic-above
path: p1 p2
p1 = [2,0]
p2 = [10,0]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# breve - Curved arc opening upward
# Unicode: U+0306 COMBINING BREVE
# -----------------------------------------------------------------------------
@elem breve
zone: diacritic-above
path: p1 p2 p3
p1 = [4,0]
p2 = C([4,2] [6,2])
p3 = C([8,2] [8,0])
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# dot-above - Single dot above
# Unicode: U+0307 COMBINING DOT ABOVE
# Winding: counterclockwise (top -> left -> bottom -> right)
# -----------------------------------------------------------------------------
@elem dot-above
zone: diacritic-above
path: p1 p2 p3 p4
p1 = [6,0]
p2 = C([5,0] [5,1])
p3 = C([5,2] [6,2])
p4 = C([7,2] [7,1])
close: true
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# diaeresis - Two dots (umlaut)
# Unicode: U+0308 COMBINING DIAERESIS
# -----------------------------------------------------------------------------
@elem diaeresis
zone: diacritic-above
path: p1 p2 p3 p4
p1 = [4,1]
p2 = C([4,1] [4,2])
p3 = C([4,2] [4,2])
p4 = C([4,2] [4,2])
close: true
width: 1
anchors: attach=[6,2]
# Second dot defined via path continuation
@end

# -----------------------------------------------------------------------------
# hook-above - Small hook curving right above
# Unicode: U+0309 COMBINING HOOK ABOVE
# Used in Vietnamese for hoi tone
# -----------------------------------------------------------------------------
@elem hook-above
zone: diacritic-above
path: p1 p2 p3 p4
p1 = [6,2]
p2 = [6,1]
p3 = C([6,0] [6,0])
p4 = C([7,0] [6,1])
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# ring - Small circle above
# Unicode: U+030A COMBINING RING ABOVE
# Winding: counterclockwise (top -> left -> bottom -> right)
# -----------------------------------------------------------------------------
@elem ring
zone: diacritic-above
path: p1 p2 p3 p4
p1 = [6,0]
p2 = C([4,0] [4,1])
p3 = C([4,2] [6,2])
p4 = C([8,2] [8,1])
close: true
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# double-acute - Two rising diagonal strokes
# Unicode: U+030B COMBINING DOUBLE ACUTE ACCENT
# Stroke: top-left to bottom-right (drawn top-down)
# -----------------------------------------------------------------------------
@elem double-acute
zone: diacritic-above
path: p1 p2
p1 = [3,0]
p2 = [5,2]
close: false
width: 1
anchors: attach=[6,2]
# Second stroke
@end

# -----------------------------------------------------------------------------
# caron - V shape (hacek/wedge)
# Unicode: U+030C COMBINING CARON
# -----------------------------------------------------------------------------
@elem caron
zone: diacritic-above
path: p1 p2 p3
p1 = [4,0]
p2 = [6,2]
p3 = [8,0]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# vertical-line-above - Single vertical stroke above
# Unicode: U+030D COMBINING VERTICAL LINE ABOVE
# -----------------------------------------------------------------------------
@elem vertical-line-above
zone: diacritic-above
path: p1 p2
p1 = [6,0]
p2 = [6,2]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# double-vertical-line-above - Two vertical strokes above
# Unicode: U+030E COMBINING DOUBLE VERTICAL LINE ABOVE
# -----------------------------------------------------------------------------
@elem double-vertical-line-above
zone: diacritic-above
path: p1 p2
p1 = [5,0]
p2 = [5,2]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# double-grave - Two falling diagonal strokes
# Unicode: U+030F COMBINING DOUBLE GRAVE ACCENT
# Stroke: top-right to bottom-left (falling)
# -----------------------------------------------------------------------------
@elem double-grave
zone: diacritic-above
path: p1 p2
p1 = [5,0]
p2 = [3,2]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# candrabindu - Crescent with dot (moon-dot)
# Unicode: U+0310 COMBINING CANDRABINDU
# Used in Sanskrit/Hindi for nasalization
# -----------------------------------------------------------------------------
@elem candrabindu
zone: diacritic-above
path: p1 p2 p3
p1 = [4,2]
p2 = C([4,0] [6,0])
p3 = C([8,0] [8,2])
close: false
width: 1
anchors: attach=[6,2]
# Dot above the crescent
@end

# -----------------------------------------------------------------------------
# inverted-breve - Curved arc opening downward
# Unicode: U+0311 COMBINING INVERTED BREVE
# -----------------------------------------------------------------------------
@elem inverted-breve
zone: diacritic-above
path: p1 p2 p3
p1 = [4,2]
p2 = C([4,0] [6,0])
p3 = C([8,0] [8,2])
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# turned-comma-above - Comma rotated 180 degrees
# Unicode: U+0312 COMBINING TURNED COMMA ABOVE
# -----------------------------------------------------------------------------
@elem turned-comma-above
zone: diacritic-above
path: p1 p2 p3
p1 = [6,2]
p2 = C([6,2] [6,1])
p3 = [6,0]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# comma-above - Small comma shape above (smooth breathing in Greek)
# Unicode: U+0313 COMBINING COMMA ABOVE
# -----------------------------------------------------------------------------
@elem comma-above
zone: diacritic-above
path: p1 p2 p3
p1 = [6,0]
p2 = C([6,0] [6,1])
p3 = [6,2]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# reversed-comma-above - Reversed comma (rough breathing in Greek)
# Unicode: U+0314 COMBINING REVERSED COMMA ABOVE
# -----------------------------------------------------------------------------
@elem reversed-comma-above
zone: diacritic-above
path: p1 p2 p3
p1 = [6,0]
p2 = C([6,0] [6,1])
p3 = [6,2]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# comma-above-right - Comma positioned to upper right
# Unicode: U+0315 COMBINING COMMA ABOVE RIGHT
# -----------------------------------------------------------------------------
@elem comma-above-right
zone: diacritic-above
path: p1 p2 p3
p1 = [8,0]
p2 = C([8,0] [8,1])
p3 = [8,2]
close: false
width: 1
anchors: attach=[8,2]
@end

# -----------------------------------------------------------------------------
# left-angle-above - Left angle bracket above
# Unicode: U+031A COMBINING LEFT ANGLE ABOVE
# IPA diacritic for unreleased consonant
# -----------------------------------------------------------------------------
@elem left-angle-above
zone: diacritic-above
path: p1 p2 p3
p1 = [8,0]
p2 = [5,1]
p3 = [8,2]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# horn - Small hook extending from upper right
# Unicode: U+031B COMBINING HORN
# Used in Vietnamese
# -----------------------------------------------------------------------------
@elem horn
zone: diacritic-above
path: p1 p2 p3
p1 = [6,2]
p2 = C([7,1] [8,1])
p3 = [8,0]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# bridge-above - Arch shape above
# Unicode: U+0346 COMBINING BRIDGE ABOVE
# IPA diacritic
# -----------------------------------------------------------------------------
@elem bridge-above
zone: diacritic-above
path: p1 p2 p3 p4
p1 = [4,2]
p2 = [4,1]
p3 = C([4,0] [6,0])
p4 = C([8,0] [8,1])
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# not-tilde-above - Tilde with vertical stroke
# Unicode: U+034A COMBINING NOT TILDE ABOVE
# -----------------------------------------------------------------------------
@elem not-tilde-above
zone: diacritic-above
path: p1 p2 p3
p1 = [3,2]
p2 = C([5,0] [7,2])
p3 = [9,0]
close: false
width: 1
anchors: attach=[6,2]
# Vertical stroke through tilde
@end

# -----------------------------------------------------------------------------
# homothetic-above - Two horizontal lines above
# Unicode: U+034B COMBINING HOMOTHETIC ABOVE
# -----------------------------------------------------------------------------
@elem homothetic-above
zone: diacritic-above
path: p1 p2
p1 = [4,0]
p2 = [8,0]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# almost-equal-above - Wavy equals sign above
# Unicode: U+034C COMBINING ALMOST EQUAL TO ABOVE
# -----------------------------------------------------------------------------
@elem almost-equal-above
zone: diacritic-above
path: p1 p2 p3
p1 = [3,0]
p2 = C([4,0] [6,0])
p3 = C([8,2] [9,0])
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# right-arrowhead-above - Right-pointing arrow above
# Unicode: U+0350 COMBINING RIGHT ARROWHEAD ABOVE
# -----------------------------------------------------------------------------
@elem right-arrowhead-above
zone: diacritic-above
path: p1 p2 p3
p1 = [4,0]
p2 = [8,1]
p3 = [4,2]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# left-half-ring-above - Left half of ring above
# Unicode: U+0351 COMBINING LEFT HALF RING ABOVE
# -----------------------------------------------------------------------------
@elem left-half-ring-above
zone: diacritic-above
path: p1 p2 p3
p1 = [7,0]
p2 = C([5,0] [5,1])
p3 = C([5,2] [7,2])
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# fermata - Inverted breve with dot (musical fermata)
# Unicode: U+0352 COMBINING FERMATA
# -----------------------------------------------------------------------------
@elem fermata
zone: diacritic-above
path: p1 p2 p3
p1 = [3,2]
p2 = C([3,0] [6,0])
p3 = C([9,0] [9,2])
close: false
width: 1
anchors: attach=[6,2]
# Dot below the arc
@end

# -----------------------------------------------------------------------------
# right-half-ring-above - Right half of ring above
# Unicode: U+0357 COMBINING RIGHT HALF RING ABOVE
# -----------------------------------------------------------------------------
@elem right-half-ring-above
zone: diacritic-above
path: p1 p2 p3
p1 = [5,0]
p2 = C([7,0] [7,1])
p3 = C([7,2] [5,2])
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# dot-above-right - Dot positioned to upper right
# Unicode: U+0358 COMBINING DOT ABOVE RIGHT
# -----------------------------------------------------------------------------
@elem dot-above-right
zone: diacritic-above
path: p1 p2 p3 p4
p1 = [8,0]
p2 = C([8,0] [8,1])
p3 = C([8,2] [8,2])
p4 = C([8,2] [8,1])
close: true
width: 1
anchors: attach=[8,2]
@end

# -----------------------------------------------------------------------------
# zigzag-above - Zigzag line above
# Unicode: U+035B COMBINING ZIGZAG ABOVE
# -----------------------------------------------------------------------------
@elem zigzag-above
zone: diacritic-above
path: p1 p2 p3 p4 p5
p1 = [3,1]
p2 = [4,0]
p3 = [6,2]
p4 = [8,0]
p5 = [9,1]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# x-above - X shape above
# Unicode: U+033D COMBINING X ABOVE
# -----------------------------------------------------------------------------
@elem x-above
zone: diacritic-above
path: p1 p2
p1 = [4,0]
p2 = [8,2]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# vertical-tilde - Vertical wavy line above
# Unicode: U+033E COMBINING VERTICAL TILDE
# -----------------------------------------------------------------------------
@elem vertical-tilde
zone: diacritic-above
path: p1 p2 p3
p1 = [5,0]
p2 = C([7,0] [5,2])
p3 = [7,2]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# double-overline - Two horizontal lines above
# Unicode: U+033F COMBINING DOUBLE OVERLINE
# -----------------------------------------------------------------------------
@elem double-overline
zone: diacritic-above
path: p1 p2
p1 = [2,0]
p2 = [10,0]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# grave-tone-mark - Vietnamese grave tone mark
# Unicode: U+0340 COMBINING GRAVE TONE MARK
# Note: Canonically equivalent to U+0300, included for completeness
# Stroke: top-right to bottom-left (falling)
# -----------------------------------------------------------------------------
@elem grave-tone-mark
zone: diacritic-above
path: p1 p2
p1 = [7,0]
p2 = [5,2]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# acute-tone-mark - Vietnamese acute tone mark
# Unicode: U+0341 COMBINING ACUTE TONE MARK
# Note: Canonically equivalent to U+0301, included for completeness
# Stroke: top-left to bottom-right (rising appearance, drawn top-down)
# -----------------------------------------------------------------------------
@elem acute-tone-mark
zone: diacritic-above
path: p1 p2
p1 = [5,0]
p2 = [7,2]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# greek-perispomeni - Greek circumflex (tilde-like)
# Unicode: U+0342 COMBINING GREEK PERISPOMENI
# -----------------------------------------------------------------------------
@elem greek-perispomeni
zone: diacritic-above
path: p1 p2 p3
p1 = [4,2]
p2 = C([4,0] [6,0])
p3 = C([8,0] [8,2])
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# greek-koronis - Greek smooth breathing variant
# Unicode: U+0343 COMBINING GREEK KORONIS
# Note: Canonically equivalent to U+0313
# -----------------------------------------------------------------------------
@elem greek-koronis
zone: diacritic-above
path: p1 p2 p3
p1 = [6,0]
p2 = C([6,0] [6,1])
p3 = [6,2]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# greek-dialytika-tonos - Greek diaeresis with acute
# Unicode: U+0344 COMBINING GREEK DIALYTIKA TONOS
# Note: Canonically equivalent to U+0308 U+0301
# -----------------------------------------------------------------------------
@elem greek-dialytika-tonos
zone: diacritic-above
path: p1 p2 p3 p4
p1 = [4,2]
p2 = C([4,2] [4,2])
p3 = C([4,2] [4,2])
p4 = C([4,2] [4,2])
close: true
width: 1
anchors: attach=[6,2]
# Acute accent above
@end

# =============================================================================
# BELOW MARKS
# =============================================================================

# -----------------------------------------------------------------------------
# grave-below - Falling diagonal stroke below
# Unicode: U+0316 COMBINING GRAVE ACCENT BELOW
# Stroke: top-right to bottom-left (falling)
# -----------------------------------------------------------------------------
@elem grave-below
zone: diacritic-below
path: p1 p2
p1 = [7,9]
p2 = [5,10]
close: false
width: 1
anchors: attach=[6,8]
@end

# -----------------------------------------------------------------------------
# acute-below - Rising diagonal stroke below
# Unicode: U+0317 COMBINING ACUTE ACCENT BELOW
# Stroke: top-left to bottom-right (drawn top-down)
# -----------------------------------------------------------------------------
@elem acute-below
zone: diacritic-below
path: p1 p2
p1 = [5,9]
p2 = [7,10]
close: false
width: 1
anchors: attach=[6,8]
@end

# -----------------------------------------------------------------------------
# left-tack-below - Left-pointing tack below
# Unicode: U+0318 COMBINING LEFT TACK BELOW
# IPA for advanced tongue root
# -----------------------------------------------------------------------------
@elem left-tack-below
zone: diacritic-below
path: p1 p2 p3
p1 = [4,9]
p2 = [4,10]
p3 = [7,10]
close: false
width: 1
anchors: attach=[6,8]
@end

# -----------------------------------------------------------------------------
# right-tack-below - Right-pointing tack below
# Unicode: U+0319 COMBINING RIGHT TACK BELOW
# IPA for retracted tongue root
# -----------------------------------------------------------------------------
@elem right-tack-below
zone: diacritic-below
path: p1 p2 p3
p1 = [8,9]
p2 = [8,10]
p3 = [5,10]
close: false
width: 1
anchors: attach=[6,8]
@end

# -----------------------------------------------------------------------------
# left-half-ring-below - Left half of ring below
# Unicode: U+031C COMBINING LEFT HALF RING BELOW
# -----------------------------------------------------------------------------
@elem left-half-ring-below
zone: diacritic-below
path: p1 p2 p3
p1 = [7,9]
p2 = C([5,9] [5,10])
p3 = C([5,11] [7,11])
close: false
width: 1
anchors: attach=[6,8]
@end

# -----------------------------------------------------------------------------
# up-tack-below - Up-pointing tack below
# Unicode: U+031D COMBINING UP TACK BELOW
# IPA for raised articulation
# -----------------------------------------------------------------------------
@elem up-tack-below
zone: diacritic-below
path: p1 p2 p3
p1 = [6,9]
p2 = [6,11]
p3 = [4,11]
close: false
width: 1
anchors: attach=[6,8]
@end

# -----------------------------------------------------------------------------
# down-tack-below - Down-pointing tack below
# Unicode: U+031E COMBINING DOWN TACK BELOW
# IPA for lowered articulation
# -----------------------------------------------------------------------------
@elem down-tack-below
zone: diacritic-below
path: p1 p2 p3
p1 = [6,11]
p2 = [6,9]
p3 = [4,9]
close: false
width: 1
anchors: attach=[6,8]
@end

# -----------------------------------------------------------------------------
# plus-sign-below - Plus sign below
# Unicode: U+031F COMBINING PLUS SIGN BELOW
# IPA for advanced articulation
# -----------------------------------------------------------------------------
@elem plus-sign-below
zone: diacritic-below
path: p1 p2
p1 = [4,10]
p2 = [8,10]
close: false
width: 1
anchors: attach=[6,8]
@end

# -----------------------------------------------------------------------------
# minus-sign-below - Minus sign below
# Unicode: U+0320 COMBINING MINUS SIGN BELOW
# IPA for retracted articulation
# -----------------------------------------------------------------------------
@elem minus-sign-below
zone: diacritic-below
path: p1 p2
p1 = [4,10]
p2 = [8,10]
close: false
width: 1
anchors: attach=[6,8]
@end

# -----------------------------------------------------------------------------
# palatalized-hook-below - Hook curving right below
# Unicode: U+0321 COMBINING PALATALIZED HOOK BELOW
# IPA for palatalization
# -----------------------------------------------------------------------------
@elem palatalized-hook-below
zone: diacritic-below
path: p1 p2 p3
p1 = [6,8]
p2 = [6,10]
p3 = C([6,11] [7,11])
close: false
width: 1
anchors: attach=[6,8]
@end

# -----------------------------------------------------------------------------
# retroflex-hook-below - Hook curving left below
# Unicode: U+0322 COMBINING RETROFLEX HOOK BELOW
# IPA for retroflexion
# -----------------------------------------------------------------------------
@elem retroflex-hook-below
zone: diacritic-below
path: p1 p2 p3
p1 = [6,8]
p2 = [6,10]
p3 = C([6,11] [5,11])
close: false
width: 1
anchors: attach=[6,8]
@end

# -----------------------------------------------------------------------------
# dot-below - Single dot below
# Unicode: U+0323 COMBINING DOT BELOW
# Winding: counterclockwise (top -> left -> bottom -> right)
# -----------------------------------------------------------------------------
@elem dot-below
zone: diacritic-below
path: p1 p2 p3 p4
p1 = [6,9]
p2 = C([5,9] [5,10])
p3 = C([5,10] [6,10])
p4 = C([7,10] [7,9])
close: true
width: 1
anchors: attach=[6,8]
@end

# -----------------------------------------------------------------------------
# diaeresis-below - Two dots below
# Unicode: U+0324 COMBINING DIAERESIS BELOW
# -----------------------------------------------------------------------------
@elem diaeresis-below
zone: diacritic-below
path: p1 p2 p3 p4
p1 = [4,10]
p2 = C([4,10] [4,10])
p3 = C([4,10] [4,10])
p4 = C([4,10] [4,10])
close: true
width: 1
anchors: attach=[6,8]
@end

# -----------------------------------------------------------------------------
# ring-below - Small circle below
# Unicode: U+0325 COMBINING RING BELOW
# Winding: counterclockwise (top -> left -> bottom -> right)
# -----------------------------------------------------------------------------
@elem ring-below
zone: diacritic-below
path: p1 p2 p3 p4
p1 = [6,9]
p2 = C([4,9] [4,10])
p3 = C([4,11] [6,11])
p4 = C([8,11] [8,10])
close: true
width: 1
anchors: attach=[6,8]
@end

# -----------------------------------------------------------------------------
# comma-below - Comma shape below
# Unicode: U+0326 COMBINING COMMA BELOW
# -----------------------------------------------------------------------------
@elem comma-below
zone: diacritic-below
path: p1 p2 p3
p1 = [6,9]
p2 = C([6,10] [6,10])
p3 = [6,11]
close: false
width: 1
anchors: attach=[6,8]
@end

# -----------------------------------------------------------------------------
# cedilla - Hook extending below
# Unicode: U+0327 COMBINING CEDILLA
# -----------------------------------------------------------------------------
@elem cedilla
zone: diacritic-below
path: p1 p2 p3 p4
p1 = [6,8]
p2 = [6,9]
p3 = C([4,10] [5,10])
p4 = C([6,10] [6,11])
close: false
width: 1
anchors: attach=[6,8]
