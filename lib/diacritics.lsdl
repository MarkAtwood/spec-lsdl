@elem double-breve-below
zone: diacritic-below
path: p1 p2 p3
p1 = [0,9]
p2 = C([0,11] [6,11])
p3 = C([12,11] [12,9])
close: false
width: 1
anchors: attach=[6,8]
@end

# -----------------------------------------------------------------------------
# double-breve - Breve spanning two characters above
# Unicode: U+035D COMBINING DOUBLE BREVE
# Note: Spans from one character to the next
