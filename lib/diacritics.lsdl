@elem double-breve
zone: diacritic-above
path: p1 p2 p3
p1 = [0,0]
p2 = C([0,2] [6,2])
p3 = C([12,2] [12,0])
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
