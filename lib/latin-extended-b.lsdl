@lsdl 1.0

# =============================================================================
# LSDL Latin Extended-B Character Library (U+0180-024F)
# =============================================================================
#
# This file defines the 208 characters in the Latin Extended-B Unicode block.
# These characters are used for African languages, Croatian/Slovenian,
# Pinyin romanization, Romanian, and various phonetic extensions.
#
# Categories:
#   - African language letters (Ɓ, Ɔ, Ɗ, Ə, Ɛ, etc.)
#   - Croatian/Slovenian digraphs (DŽ, LJ, NJ)
#   - Pinyin vowels with tone marks (ǎ, ǐ, ǔ, ǚ)
#   - Romanian letters (Ș, Ț with comma below)
#   - Phonetic extensions (turned, hooked, stroked letters)
#   - Double diacritic combinations
#
# Composition patterns:
#   - DIA: Single diacritic attachment
#   - DIA2: Double diacritic attachment
#   - OVR: Stroke overlays
#   - FRAME: Complex letterforms with hooks, tails
#   - LR: Digraphs and compound letters
#
# =============================================================================

# =============================================================================
# SPECIAL ELEMENTS FOR LATIN EXTENDED-B
# =============================================================================

# -----------------------------------------------------------------------------
# hook.top.cap - Capital letter hook (for African Ɓ, Ɗ, Ƙ, etc.)
# Hook extending from top of letter, curving left
# -----------------------------------------------------------------------------
@elem hook.top.cap
zone: cap
path: p1 p2 p3
p1 = [4,0]
p2 = C([2,0] [2,2])
p3 = [3,3]
close: false
width: 1
anchors: attach=[4,0] base=[3,3]
@end

# -----------------------------------------------------------------------------
# topbar - Horizontal bar at top extending both sides
# Used for Ƃ, Ƌ (letters with topbar)
# -----------------------------------------------------------------------------
@elem topbar
zone: cap
path: p1 p2
p1 = [3,0]
p2 = [9,0]
close: false
width: 1
anchors: mid=[6,0]
@end

# -----------------------------------------------------------------------------
# topbar.small - Shorter topbar for lowercase
# -----------------------------------------------------------------------------
@elem topbar.small
zone: x-height
path: p1 p2
p1 = [4,4]
p2 = [8,4]
close: false
width: 1
anchors: mid=[6,4]
@end

# -----------------------------------------------------------------------------
# open.o.cap - Open O shape (like C but more curved)
# For Ɔ (Latin Capital Letter Open O)
# -----------------------------------------------------------------------------
@elem open.o.cap
zone: cap
path: p1 p2 p3 p4
p1 = [2,2]
p2 = C([2,0] [6,0])
p3 = C([10,0] [10,4])
p4 = C([10,8] [6,8])
close: false
width: 1
anchors: top=[6,0] base=[6,8] left=[2,4]
@end

# -----------------------------------------------------------------------------
# open.e.cap - Open E shape (epsilon-like)
# For Ɛ (Latin Capital Letter Open E)
# -----------------------------------------------------------------------------
@elem open.e.cap
zone: cap
path: p1 p2 p3 p4 p5
p1 = [10,0]
p2 = C([4,0] [2,2])
p3 = [6,4]
p4 = C([2,6] [4,8])
p5 = [10,8]
close: false
width: 1
anchors: top=[6,0] base=[6,8] mid=[6,4]
@end

# -----------------------------------------------------------------------------
# schwa.cap - Capital schwa (turned e)
# For Ə (Latin Capital Letter Schwa)
# -----------------------------------------------------------------------------
@elem schwa.cap
zone: cap
path: p1 p2 p3 p4 p5
p1 = [2,0]
p2 = C([8,0] [10,2])
p3 = C([10,6] [6,4])
p4 = C([2,6] [2,8])
p5 = [10,8]
close: false
width: 1
anchors: top=[6,0] base=[6,8] mid=[6,4]
@end

# -----------------------------------------------------------------------------
# schwa.small - Small schwa (turned e)
# For ə (Latin Small Letter Schwa)
# -----------------------------------------------------------------------------
@elem schwa.small
zone: x-height
path: p1 p2 p3 p4 p5
p1 = [2,4]
p2 = C([8,4] [10,5])
p3 = C([10,7] [6,6])
p4 = C([2,7] [2,8])
p5 = [10,8]
close: false
width: 1
anchors: top=[6,4] base=[6,8] mid=[6,6]
@end

# -----------------------------------------------------------------------------
# gamma.cap - Capital Gamma shape
# For Ɣ (Latin Capital Letter Gamma)
# -----------------------------------------------------------------------------
@elem gamma.cap
zone: cap
path: p1 p2 p3 p4
p1 = [2,0]
p2 = [6,4]
p3 = [10,0]
p4 = [6,8]
close: false
width: 1
anchors: top=[6,0] base=[6,8]
@end

# -----------------------------------------------------------------------------
# iota.cap - Capital Iota shape
# For Ɩ (Latin Capital Letter Iota)
# -----------------------------------------------------------------------------
@elem iota.cap
zone: cap
path: p1 p2 p3
p1 = [6,0]
p2 = [6,8]
p3 = C([6,10] [4,10])
close: false
width: 1
anchors: top=[6,0] base=[4,10]
@end

# -----------------------------------------------------------------------------
# upsilon.cap - Capital Upsilon shape
# For Ʊ (Latin Capital Letter Upsilon)
# -----------------------------------------------------------------------------
@elem upsilon.cap
zone: cap
path: p1 p2 p3 p4 p5
p1 = [2,0]
p2 = C([2,5] [4,6])
p3 = C([8,6] [10,5])
p4 = [10,0]
p5 = [6,4]
close: false
width: 1
anchors: top=[6,0] base=[6,4]
@end

# -----------------------------------------------------------------------------
# esh.cap - Capital Esh shape (elongated S)
# For Ʃ (Latin Capital Letter Esh)
# -----------------------------------------------------------------------------
@elem esh.cap
zone: cap
path: p1 p2 p3 p4 p5 p6
p1 = [10,0]
p2 = C([4,0] [4,2])
p3 = C([4,4] [8,4])
p4 = C([8,6] [8,8])
p5 = C([8,10] [4,10])
p6 = [2,10]
close: false
width: 1
anchors: top=[6,0] base=[4,10]
@end

# -----------------------------------------------------------------------------
# esh.small - Small esh shape
# For IPA usage
# -----------------------------------------------------------------------------
@elem esh.small
zone: full
path: p1 p2 p3 p4 p5 p6
p1 = [8,1]
p2 = C([4,1] [4,3])
p3 = [4,6]
p4 = C([4,9] [6,9])
p5 = C([8,9] [8,10])
p6 = [6,10]
close: false
width: 1
anchors: top=[6,1] base=[6,10]
@end

# -----------------------------------------------------------------------------
# ezh.cap - Capital Ezh shape (like 3)
# For Ʒ (Latin Capital Letter Ezh)
# -----------------------------------------------------------------------------
@elem ezh.cap
zone: cap
path: p1 p2 p3 p4 p5
p1 = [2,0]
p2 = [10,0]
p3 = C([10,2] [6,4])
p4 = C([10,6] [10,8])
p5 = [2,8]
close: false
width: 1
anchors: top=[6,0] base=[6,8]
@end

# -----------------------------------------------------------------------------
# ezh.small - Small ezh shape
# -----------------------------------------------------------------------------
@elem ezh.small
zone: x-height
path: p1 p2 p3 p4 p5
p1 = [2,4]
p2 = [10,4]
p3 = C([10,5] [6,6])
p4 = C([10,7] [10,8])
p5 = [2,8]
close: false
width: 1
anchors: top=[6,4] base=[6,8]
@end

# -----------------------------------------------------------------------------
# yogh.cap - Capital Yogh shape
# For Ȝ (Latin Capital Letter Yogh)
# -----------------------------------------------------------------------------
@elem yogh.cap
zone: cap
path: p1 p2 p3 p4 p5
p1 = [2,0]
p2 = [10,0]
p3 = [6,4]
p4 = C([8,6] [8,10])
p5 = [4,10]
close: false
width: 1
anchors: top=[6,0] base=[4,10]
@end

# -----------------------------------------------------------------------------
# yogh.small - Small yogh shape
# -----------------------------------------------------------------------------
@elem yogh.small
zone: full
path: p1 p2 p3 p4 p5
p1 = [2,4]
p2 = [10,4]
p3 = [6,6]
p4 = C([8,8] [8,10])
p5 = [4,10]
close: false
width: 1
anchors: top=[6,4] base=[4,10]
@end

# -----------------------------------------------------------------------------
# wynn.cap - Capital Wynn shape
# For Ƿ (Latin Capital Letter Wynn)
# -----------------------------------------------------------------------------
@elem wynn.cap
zone: cap
path: p1 p2 p3 p4
p1 = [2,0]
p2 = [2,8]
p3 = C([2,4] [8,4])
p4 = C([10,6] [8,8])
close: false
width: 1
anchors: top=[2,0] base=[2,8]
@end

# -----------------------------------------------------------------------------
# wynn.small - Small wynn shape
# -----------------------------------------------------------------------------
@elem wynn.small
zone: x-height
path: p1 p2 p3 p4
p1 = [2,4]
p2 = [2,8]
p3 = C([2,5] [8,5])
p4 = C([10,6] [8,8])
close: false
width: 1
anchors: top=[2,4] base=[2,8]
@end

# -----------------------------------------------------------------------------
# ou.cap - Capital OU ligature shape
# For Ȣ (Latin Capital Letter OU)
# -----------------------------------------------------------------------------
@elem ou.cap
zone: cap
path: p1 p2 p3 p4 p5 p6
p1 = [6,0]
p2 = C([0,0] [0,4])
p3 = C([0,8] [6,8])
p4 = C([12,8] [12,4])
p5 = C([12,0] [6,0])
p6 = [6,4]
close: true
width: 1
anchors: top=[6,0] base=[6,8]
@end

# -----------------------------------------------------------------------------
# glottal.cap - Capital glottal stop shape
# For Ɂ (Latin Capital Letter Glottal Stop)
# -----------------------------------------------------------------------------
@elem glottal.cap
zone: cap
path: p1 p2 p3 p4
p1 = [2,0]
p2 = C([10,0] [10,3])
p3 = [6,4]
p4 = [6,8]
close: false
width: 1
anchors: top=[6,0] base=[6,8]
@end

# -----------------------------------------------------------------------------
# glottal.small - Small glottal stop shape
# -----------------------------------------------------------------------------
@elem glottal.small
zone: x-height
path: p1 p2 p3 p4
p1 = [2,4]
p2 = C([10,4] [10,5])
p3 = [6,6]
p4 = [6,8]
close: false
width: 1
anchors: top=[6,4] base=[6,8]
@end

# -----------------------------------------------------------------------------
# click.dental - Dental click shape (|)
# For ǀ (Latin Letter Dental Click)
# -----------------------------------------------------------------------------
@elem click.dental
zone: cap
path: p1 p2
p1 = [6,0]
p2 = [6,8]
close: false
width: 1
anchors: top=[6,0] base=[6,8]
@end

# -----------------------------------------------------------------------------
# click.lateral - Lateral click shape (||)
# For ǁ (Latin Letter Lateral Click)
# -----------------------------------------------------------------------------
@elem click.lateral
zone: cap
path: p1 p2
p1 = [4,0]
p2 = [4,8]
close: false
width: 1
anchors: top=[4,0] base=[4,8]
@end

# -----------------------------------------------------------------------------
# click.alveolar - Alveolar click shape (≠ like)
# For ǂ (Latin Letter Alveolar Click)
# -----------------------------------------------------------------------------
@elem click.alveolar
zone: cap
path: p1 p2 p3 p4 p5
p1 = [2,2]
p2 = [10,2]
p3 = [6,0]
p4 = [6,8]
p5 = [2,6]
close: false
width: 1
anchors: top=[6,0] base=[6,8]
@end

# -----------------------------------------------------------------------------
# click.retroflex - Retroflex click shape (!)
# For ǃ (Latin Letter Retroflex Click)
# -----------------------------------------------------------------------------
@elem click.retroflex
zone: cap
path: p1 p2 p3 p4
p1 = [6,0]
p2 = [6,6]
p3 = [6,7]
p4 = [6,8]
close: false
width: 1
anchors: top=[6,0] base=[6,8]
@end

# =============================================================================
# CHARACTERS U+0180-018F
# =============================================================================

# ƀ - Latin Small Letter B with Stroke
ƀ  LATIN-SMALL-B-STROKE = OVR(b, stroke.horiz) cp:U+0180 script:Latn

# Ɓ - Latin Capital Letter B with Hook
Ɓ  LATIN-CAPITAL-B-HOOK = FRAME(B, hook.top.cap) cp:U+0181 script:Latn

# Ƃ - Latin Capital Letter B with Topbar
Ƃ  LATIN-CAPITAL-B-TOPBAR = FRAME(B, topbar) cp:U+0182 script:Latn

# ƃ - Latin Small Letter B with Topbar
ƃ  LATIN-SMALL-B-TOPBAR = FRAME(b, topbar.small) cp:U+0183 script:Latn

# Ƅ - Latin Capital Letter Tone Six
Ƅ  LATIN-CAPITAL-TONE-SIX = FRAME(bowl.cap, stem.l) cp:U+0184 script:Latn

# ƅ - Latin Small Letter Tone Six
ƅ  LATIN-SMALL-TONE-SIX = FRAME(bowl.full, stem) cp:U+0185 script:Latn

# Ɔ - Latin Capital Letter Open O
Ɔ  LATIN-CAPITAL-OPEN-O = open.o.cap cp:U+0186 script:Latn

# Ƈ - Latin Capital Letter C with Hook
Ƈ  LATIN-CAPITAL-C-HOOK = FRAME(C, hook.top.cap) cp:U+0187 script:Latn

# ƈ - Latin Small Letter C with Hook
ƈ  LATIN-SMALL-C-HOOK = FRAME(c, hook.top) cp:U+0188 script:Latn

# Ɖ - Latin Capital Letter African D
Ɖ  LATIN-CAPITAL-AFRICAN-D = OVR(D, stroke.horiz) cp:U+0189 script:Latn

# Ɗ - Latin Capital Letter D with Hook
Ɗ  LATIN-CAPITAL-D-HOOK = FRAME(D, hook.top.cap) cp:U+018A script:Latn

# Ƌ - Latin Capital Letter D with Topbar
Ƌ  LATIN-CAPITAL-D-TOPBAR = FRAME(D, topbar) cp:U+018B script:Latn

# ƌ - Latin Small Letter D with Topbar
ƌ  LATIN-SMALL-D-TOPBAR = FRAME(d, topbar.small) cp:U+018C script:Latn

# ƍ - Latin Small Letter Turned Delta
# This is a phonetic symbol, delta shape rotated 180 degrees
ƍ  LATIN-SMALL-TURNED-DELTA = sc(apex.x, sx=10, sy=10) cp:U+018D script:Latn

# Ǝ - Latin Capital Letter Reversed E
Ǝ  LATIN-CAPITAL-REVERSED-E = sc(E, sx=-12, sy=12) cp:U+018E script:Latn

# Ə - Latin Capital Letter Schwa
Ə  LATIN-CAPITAL-SCHWA = schwa.cap cp:U+018F script:Latn

# =============================================================================
# CHARACTERS U+0190-019F
# =============================================================================

# Ɛ - Latin Capital Letter Open E
Ɛ  LATIN-CAPITAL-OPEN-E = open.e.cap cp:U+0190 script:Latn

# Ƒ - Latin Capital Letter F with Hook
Ƒ  LATIN-CAPITAL-F-HOOK = FRAME(F, hook.bot) cp:U+0191 script:Latn

# ƒ - Latin Small Letter F with Hook (florin)
ƒ  LATIN-SMALL-F-HOOK = FRAME(f, hook.bot) cp:U+0192 script:Latn

# Ɠ - Latin Capital Letter G with Hook
Ɠ  LATIN-CAPITAL-G-HOOK = FRAME(G, hook.top.cap) cp:U+0193 script:Latn

# Ɣ - Latin Capital Letter Gamma
Ɣ  LATIN-CAPITAL-GAMMA = gamma.cap cp:U+0194 script:Latn

# ƕ - Latin Small Letter HV (hwair)
ƕ  LATIN-SMALL-HV = LR(h, v, 6/6) cp:U+0195 script:Latn

# Ɩ - Latin Capital Letter Iota
Ɩ  LATIN-CAPITAL-IOTA = iota.cap cp:U+0196 script:Latn

# Ɨ - Latin Capital Letter I with Stroke
Ɨ  LATIN-CAPITAL-I-STROKE = OVR(I, stroke.horiz) cp:U+0197 script:Latn

# Ƙ - Latin Capital Letter K with Hook
Ƙ  LATIN-CAPITAL-K-HOOK = FRAME(K, hook.top.cap) cp:U+0198 script:Latn

# ƙ - Latin Small Letter K with Hook
ƙ  LATIN-SMALL-K-HOOK = FRAME(k, hook.top) cp:U+0199 script:Latn

# ƚ - Latin Small Letter L with Bar
ƚ  LATIN-SMALL-L-BAR = OVR(l, stroke.horiz) cp:U+019A script:Latn

# ƛ - Latin Small Letter Lambda with Stroke
ƛ  LATIN-SMALL-LAMBDA-STROKE = OVR(apex.x, stroke.diag) cp:U+019B script:Latn

# Ɯ - Latin Capital Letter Turned M
Ɯ  LATIN-CAPITAL-TURNED-M = sc(M, sx=12, sy=-12) cp:U+019C script:Latn

# Ɲ - Latin Capital Letter N with Left Hook
Ɲ  LATIN-CAPITAL-N-LEFT-HOOK = FRAME(N, hook.top.cap) cp:U+019D script:Latn

# ƞ - Latin Small Letter N with Long Right Leg
ƞ  LATIN-SMALL-N-LONG-RIGHT-LEG = FRAME(n, descender.r) cp:U+019E script:Latn

# Ɵ - Latin Capital Letter O with Middle Tilde
Ɵ  LATIN-CAPITAL-O-MIDDLE-TILDE = OVR(O, stroke.horiz) cp:U+019F script:Latn

# =============================================================================
# CHARACTERS U+01A0-01AF
# =============================================================================

# Ơ - Latin Capital Letter O with Horn
Ơ  LATIN-CAPITAL-O-HORN = DIA(O, horn, attach:top-right) cp:U+01A0 script:Latn ortho:Vie

# ơ - Latin Small Letter O with Horn
ơ  LATIN-SMALL-O-HORN = DIA(o, horn, attach:top-right) cp:U+01A1 script:Latn ortho:Vie

# Ƣ - Latin Capital Letter OI
Ƣ  LATIN-CAPITAL-OI = ou.cap cp:U+01A2 script:Latn

# ƣ - Latin Small Letter OI
ƣ  LATIN-SMALL-OI = FRAME(bowl.full, stem) cp:U+01A3 script:Latn

# Ƥ - Latin Capital Letter P with Hook
Ƥ  LATIN-CAPITAL-P-HOOK = FRAME(P, hook.top.cap) cp:U+01A4 script:Latn

# ƥ - Latin Small Letter P with Hook
ƥ  LATIN-SMALL-P-HOOK = FRAME(p, hook.top) cp:U+01A5 script:Latn

# Ʀ - Latin Letter Yr
Ʀ  LATIN-LETTER-YR = FRAME(R, descender) cp:U+01A6 script:Latn

# Ƨ - Latin Capital Letter Tone Two
Ƨ  LATIN-CAPITAL-TONE-TWO = sc(S, sx=-12, sy=12) cp:U+01A7 script:Latn

# ƨ - Latin Small Letter Tone Two
ƨ  LATIN-SMALL-TONE-TWO = sc(s, sx=-12, sy=12) cp:U+01A8 script:Latn

# Ʃ - Latin Capital Letter Esh
Ʃ  LATIN-CAPITAL-ESH = esh.cap cp:U+01A9 script:Latn

# ƪ - Latin Letter Reversed Esh Loop
ƪ  LATIN-LETTER-REVERSED-ESH-LOOP = sc(esh.small, sx=-12, sy=12) cp:U+01AA script:Latn

# ƫ - Latin Small Letter T with Palatal Hook
ƫ  LATIN-SMALL-T-PALATAL-HOOK = FRAME(t, hook.bot) cp:U+01AB script:Latn

# Ƭ - Latin Capital Letter T with Hook
Ƭ  LATIN-CAPITAL-T-HOOK = FRAME(T, hook.top.cap) cp:U+01AC script:Latn

# ƭ - Latin Small Letter T with Hook
ƭ  LATIN-SMALL-T-HOOK = FRAME(t, hook.top) cp:U+01AD script:Latn

# Ʈ - Latin Capital Letter T with Retroflex Hook
Ʈ  LATIN-CAPITAL-T-RETROFLEX-HOOK = FRAME(T, hook.bot) cp:U+01AE script:Latn

# Ư - Latin Capital Letter U with Horn
Ư  LATIN-CAPITAL-U-HORN = DIA(U, horn, attach:top-right) cp:U+01AF script:Latn ortho:Vie

# =============================================================================
# CHARACTERS U+01B0-01BF
# =============================================================================

# ư - Latin Small Letter U with Horn
ư  LATIN-SMALL-U-HORN = DIA(u, horn, attach:top-right) cp:U+01B0 script:Latn ortho:Vie

# Ʊ - Latin Capital Letter Upsilon
Ʊ  LATIN-CAPITAL-UPSILON = upsilon.cap cp:U+01B1 script:Latn

# Ʋ - Latin Capital Letter V with Hook
Ʋ  LATIN-CAPITAL-V-HOOK = FRAME(V, hook.bot) cp:U+01B2 script:Latn

# Ƴ - Latin Capital Letter Y with Hook
Ƴ  LATIN-CAPITAL-Y-HOOK = FRAME(Y, hook.bot) cp:U+01B3 script:Latn

# ƴ - Latin Small Letter Y with Hook
ƴ  LATIN-SMALL-Y-HOOK = FRAME(y, hook.bot.right) cp:U+01B4 script:Latn

# Ƶ - Latin Capital Letter Z with Stroke
Ƶ  LATIN-CAPITAL-Z-STROKE = OVR(Z, stroke.horiz) cp:U+01B5 script:Latn

# ƶ - Latin Small Letter Z with Stroke
ƶ  LATIN-SMALL-Z-STROKE = OVR(z, stroke.horiz) cp:U+01B6 script:Latn

# Ʒ - Latin Capital Letter Ezh
Ʒ  LATIN-CAPITAL-EZH = ezh.cap cp:U+01B7 script:Latn

# Ƹ - Latin Capital Letter Ezh Reversed
Ƹ  LATIN-CAPITAL-EZH-REVERSED = sc(ezh.cap, sx=-12, sy=12) cp:U+01B8 script:Latn

# ƹ - Latin Small Letter Ezh Reversed
ƹ  LATIN-SMALL-EZH-REVERSED = sc(ezh.small, sx=-12, sy=12) cp:U+01B9 script:Latn

# ƺ - Latin Small Letter Ezh with Tail
ƺ  LATIN-SMALL-EZH-TAIL = FRAME(ezh.small, tail) cp:U+01BA script:Latn

# ƻ - Latin Letter Two with Stroke
ƻ  LATIN-LETTER-TWO-STROKE = OVR(ezh.cap, stroke.horiz) cp:U+01BB script:Latn

# Ƽ - Latin Capital Letter Tone Five
Ƽ  LATIN-CAPITAL-TONE-FIVE = FRAME(stem.l, diagonal, arc.bot.cap) cp:U+01BC script:Latn

# ƽ - Latin Small Letter Tone Five
ƽ  LATIN-SMALL-TONE-FIVE = FRAME(stem, diagonal.x, arc.bot) cp:U+01BD script:Latn

# ƾ - Latin Letter Inverted Glottal Stop with Stroke
ƾ  LATIN-LETTER-INV-GLOTTAL-STROKE = OVR(glottal.small, stroke.horiz) cp:U+01BE script:Latn

# ƿ - Latin Letter Wynn
ƿ  LATIN-LETTER-WYNN = wynn.small cp:U+01BF script:Latn

# =============================================================================
# CHARACTERS U+01C0-01CF (Click consonants and Caron letters)
# =============================================================================

# ǀ - Latin Letter Dental Click
ǀ  LATIN-LETTER-DENTAL-CLICK = click.dental cp:U+01C0 script:Latn

# ǁ - Latin Letter Lateral Click
ǁ  LATIN-LETTER-LATERAL-CLICK = LR(click.dental, click.dental, 6/6) cp:U+01C1 script:Latn

# ǂ - Latin Letter Alveolar Click
ǂ  LATIN-LETTER-ALVEOLAR-CLICK = click.alveolar cp:U+01C2 script:Latn

# ǃ - Latin Letter Retroflex Click
ǃ  LATIN-LETTER-RETROFLEX-CLICK = click.retroflex cp:U+01C3 script:Latn

# Ǆ - Latin Capital Letter DZ with Caron
Ǆ  LATIN-CAPITAL-DZ-CARON = LR(D, DIA(Z, caron), 6/6) cp:U+01C4 script:Latn ortho:Hrv,Slv

# ǅ - Latin Capital Letter D with Small Letter Z with Caron
ǅ  LATIN-CAPITAL-D-SMALL-Z-CARON = LR(D, DIA(z, caron), 7/5) cp:U+01C5 script:Latn ortho:Hrv,Slv

# ǆ - Latin Small Letter DZ with Caron
ǆ  LATIN-SMALL-DZ-CARON = LR(d, DIA(z, caron), 6/6) cp:U+01C6 script:Latn ortho:Hrv,Slv

# Ǉ - Latin Capital Letter LJ
Ǉ  LATIN-CAPITAL-LJ = LR(L, J, 6/6) cp:U+01C7 script:Latn ortho:Hrv,Slv

# ǈ - Latin Capital Letter L with Small Letter J
ǈ  LATIN-CAPITAL-L-SMALL-J = LR(L, j, 7/5) cp:U+01C8 script:Latn ortho:Hrv,Slv

# ǉ - Latin Small Letter LJ
ǉ  LATIN-SMALL-LJ = LR(l, j, 6/6) cp:U+01C9 script:Latn ortho:Hrv,Slv

# Ǌ - Latin Capital Letter NJ
Ǌ  LATIN-CAPITAL-NJ = LR(N, J, 6/6) cp:U+01CA script:Latn ortho:Hrv,Slv

# ǋ - Latin Capital Letter N with Small Letter J
ǋ  LATIN-CAPITAL-N-SMALL-J = LR(N, j, 7/5) cp:U+01CB script:Latn ortho:Hrv,Slv

# ǌ - Latin Small Letter NJ
ǌ  LATIN-SMALL-NJ = LR(n, j, 6/6) cp:U+01CC script:Latn ortho:Hrv,Slv

# Ǎ - Latin Capital Letter A with Caron
