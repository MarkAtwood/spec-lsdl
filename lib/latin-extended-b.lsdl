# =============================================================================
# CASE MAPPINGS
# =============================================================================
#
# Standard uppercase/lowercase pairs within this block.
# Note: Many African letters have lowercase forms in IPA Extensions (U+0250+),
# not in Latin Extended-B. Those case pairs will be added when IPA Extensions
# is implemented.
#
# =============================================================================

# B variants (both forms in this block)
@case Ƃ ƃ

# C variants
@case Ƈ ƈ
@case Ȼ ȼ

# D variants
@case Ƌ ƌ

# E variants (Ǝ->ǝ is in this block)
@case Ǝ ǝ
@case Ȅ ȅ
@case Ȇ ȇ
@case Ɇ ɇ

# F variants
@case Ƒ ƒ

# G variants
@case Ǥ ǥ
@case Ǧ ǧ
@case Ǵ ǵ

# H variants
@case Ƕ ƕ
@case Ȟ ȟ

# I variants
@case Ǐ ǐ
@case Ȉ ȉ
@case Ȋ ȋ

# J variants
@case Ɉ ɉ

# K variants
@case Ƙ ƙ
@case Ǩ ǩ

# L variants
@case Ƚ ƚ

# N variants
@case Ƞ ƞ
@case Ǹ ǹ

# O variants
@case Ơ ơ
@case Ǒ ǒ
@case Ǫ ǫ
@case Ǭ ǭ
@case Ȍ ȍ
@case Ȏ ȏ
@case Ȫ ȫ
@case Ȭ ȭ
@case Ȯ ȯ
@case Ȱ ȱ

# P variants
@case Ƥ ƥ

# Q variants
@case Ɋ ɋ

# R variants
@case Ȑ ȑ
@case Ȓ ȓ
@case Ɍ ɍ

# S variants (Ʃ->ʃ is in IPA block)
@case Ș ș

# T variants
@case Ƭ ƭ
@case Ț ț

# U variants
@case Ư ư
@case Ǔ ǔ
