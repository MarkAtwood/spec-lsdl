@lsdl 1.0

# =============================================================================
# LSDL Cyrillic Alphabet Library
# =============================================================================
#
# Complete Cyrillic character definitions for Russian (33 uppercase + 33
# lowercase) with Ukrainian extensions (4 additional letters).
#
# All characters tagged with:
#   - script:Cyrl (ISO 15924 script code for Cyrillic)
#   - ortho:Rus for Russian standard forms
#   - ortho:Ukr for Ukrainian-specific letters
#
# Structural Notes:
#   - Many Cyrillic capitals share structure with Latin (A=А, E=Е, etc.)
#   - Cyrillic-specific forms: Б, Г, Д, Ж, З, И, Л, П, Ф, Ц, Ч, Ш, Щ, Ъ, Ы, Ь, Э, Ю, Я
#   - Uses .cyr element variants for Cyrillic-specific strokes
#
# =============================================================================

# =============================================================================
# LOCAL DIACRITIC COPIES (from diacritics.lsdl)
# =============================================================================

@elem double-grave
zone: diacritic-above
path: p1 p2 p3 p4
p1 = [4,2]
p2 = [3,0]
p3 = [8,2]
p4 = [7,0]
close: false
width: 1
anchors: attach=[6,2]
@end

@elem overline
zone: diacritic-above
path: p1 p2
p1 = [2,0]
p2 = [10,0]
close: false
width: 1
anchors: attach=[6,2]
@end

# =============================================================================
# CYRILLIC-SPECIFIC ELEMENT DEFINITIONS
# =============================================================================

# -----------------------------------------------------------------------------
# stem.cyr - Centered Cyrillic stem (for Т, Ж, etc.)
# -----------------------------------------------------------------------------
@elem stem.cyr
zone: cap
path: p1 p2
p1 = [6,0]
p2 = [6,8]
close: false
width: 1
anchors: top=[6,0] base=[6,8] mid=[6,4]
  mark-above=[6,0] mark-below=[6,9]
@end

# -----------------------------------------------------------------------------
# hook.cyr - Cyrillic hook form (for Ч)
# Left-side curved entry connecting to right stem
# -----------------------------------------------------------------------------
@elem hook.cyr
zone: x-height
path: p1 p2 p3
p1 = [2,4]
p2 = C([2,6] [4,8])
p3 = [6,8]
close: false
width: 1
anchors: attach=[2,4] base=[6,8] top=[2,4]
@end

# -----------------------------------------------------------------------------
# tail.cyr - Cyrillic descending tail (for Ц, Щ)
# Short descender at right edge
# -----------------------------------------------------------------------------
@elem tail.cyr
zone: descender
path: p1 p2 p3
p1 = [10,8]
p2 = [10,10]
p3 = [8,10]
close: false
width: 1
anchors: attach=[10,8] base=[10,10]
@end

# -----------------------------------------------------------------------------
# tick.cyr - Upturn tick (for Ukrainian Ґ)
# Small ascending tick at right of top bar
# -----------------------------------------------------------------------------
@elem tick.cyr
zone: cap
path: p1 p2
p1 = [10,2]
p2 = [12,0]
close: false
width: 1
anchors: attach=[10,2] top=[12,0]
@end

# -----------------------------------------------------------------------------
# soft-sign.base - Base form for Ь and component of Ъ, Ы
# Vertical stem with rightward bowl at bottom
# -----------------------------------------------------------------------------
@elem soft-sign.base
zone: x-height
path: p1 p2 p3 p4
p1 = [2,4]
p2 = [2,8]
p3 = C([2,8] [8,8])
p4 = C([8,6] [2,6])
close: true
width: 1
anchors: top=[2,4] base=[2,8] attach=[5,7]
  mark-above=[2,3] mark-below=[5,9]
@end

# -----------------------------------------------------------------------------
# hard-sign.top - Top bar component for Ъ
# Horizontal bar extending left from soft sign
# -----------------------------------------------------------------------------
@elem hard-sign.top
zone: cap
path: p1 p2
p1 = [0,4]
p2 = [4,4]
close: false
width: 1
anchors: attach=[4,4] left=[0,4]
@end

# =============================================================================
# CROSS-SCRIPT HOMOGLYPH ALIASES
# =============================================================================
# Many Cyrillic characters appear identical to Latin or Greek but have
# distinct Unicode code points. These aliases enable script-aware lookup.

@alias Cyrl:A = А   # U+0410 (not Latin A U+0041)
@alias Cyrl:B = В   # U+0412 (looks like Latin B, sounds like V)
@alias Cyrl:E = Е   # U+0415 (not Latin E U+0045)
@alias Cyrl:H = Н   # U+041D (looks like Latin H, sounds like N)
@alias Cyrl:K = К   # U+041A (not Latin K U+004B)
@alias Cyrl:M = М   # U+041C (not Latin M U+004D)
@alias Cyrl:O = О   # U+041E (not Latin O U+004F)
@alias Cyrl:P = Р   # U+0420 (looks like Latin P, sounds like R)
@alias Cyrl:C = С   # U+0421 (looks like Latin C, sounds like S)
@alias Cyrl:T = Т   # U+0422 (not Latin T U+0054)
@alias Cyrl:X = Х   # U+0425 (not Latin X U+0058)
@alias Cyrl:Y = У   # U+0423 (looks like Latin Y)

# Lowercase homoglyphs
@alias Cyrl:a = а   # U+0430
@alias Cyrl:e = е   # U+0435
@alias Cyrl:o = о   # U+043E
@alias Cyrl:p = р   # U+0440 (looks like Latin p, sounds like r)
@alias Cyrl:c = с   # U+0441
@alias Cyrl:x = х   # U+0445
@alias Cyrl:y = у   # U+0443

# =============================================================================
# CASE MAPPINGS
# =============================================================================
# Russian alphabet (33 pairs)

@case А а
@case Б б
@case В в
@case Г г
@case Д д
@case Е е
@case Ж ж
@case З з
@case И и
@case Й й
@case К к
@case Л л
@case М м
@case Н н
@case О о
@case П п
@case Р р
@case С с
@case Т т
@case У у
@case Ф ф
@case Х х
@case Ц ц
@case Ч ч
@case Ш ш
@case Щ щ
@case Ъ ъ
@case Ы ы
@case Ь ь
@case Э э
@case Ю ю
@case Я я

# Ukrainian extensions (4 pairs)
@case Ґ ґ
@case Є є
@case І і
@case Ї ї

# Accented Cyrillic (U+0400-040F / U+0450-045F)
@case Ѐ ѐ
@case Ё ё
@case Ђ ђ
@case Ѓ ѓ
@case Ѕ ѕ
@case Ј ј
@case Љ љ
@case Њ њ
@case Ћ ћ
@case Ќ ќ
@case Ѝ ѝ
@case Ў ў
@case Џ џ

# Historical Cyrillic (U+0460-047F)
@case Ѡ ѡ
@case Ѣ ѣ
@case Ѥ ѥ
@case Ѧ ѧ
@case Ѩ ѩ
@case Ѫ ѫ
@case Ѭ ѭ
@case Ѯ ѯ
@case Ѱ ѱ
@case Ѳ ѳ
@case Ѵ ѵ
@case Ѷ ѷ
@case Ѹ ѹ
@case Ѻ ѻ
@case Ѽ ѽ
@case Ѿ ѿ

# =============================================================================
# CYRILLIC CAPITAL LETTERS (33 Russian)
# =============================================================================

# -----------------------------------------------------------------------------
# Letters sharing Latin structure
# -----------------------------------------------------------------------------

А  CYRILLIC-CAPITAL-A = APEX(stem.l, stem.r, crossbar.cap) script:Cyrl ortho:Rus
  # Identical to Latin A: two diagonals meeting at apex with crossbar

Е  CYRILLIC-CAPITAL-IE = FRAME(stem.l, arm.top, arm.mid, arm.bot) script:Cyrl ortho:Rus
  # Identical to Latin E: vertical stem with three horizontal arms

К  CYRILLIC-CAPITAL-KA = FRAME(stem.l, diagonal.l, leg.cap) script:Cyrl ortho:Rus
  # Identical to Latin K: stem with diagonal arm and leg

М  CYRILLIC-CAPITAL-EM = FRAME(stem.l, apex, stem.r) script:Cyrl ortho:Rus
  # Identical to Latin M: two stems joined by apex

Н  CYRILLIC-CAPITAL-EN = FRAME(stem.l, stem.r, crossbar.cap) script:Cyrl ortho:Rus
  # Identical to Latin H: two stems, then crossbar (stroke order: stems first)

О  CYRILLIC-CAPITAL-O = bowl.cap script:Cyrl ortho:Rus
  # Identical to Latin O: closed bowl

Р  CYRILLIC-CAPITAL-ER = LR(stem.l, bowl.upper, 3/9) script:Cyrl ortho:Rus
  # Looks like Latin P but represents sound /r/

С  CYRILLIC-CAPITAL-ES = STACK(arc.top.cap, arc.bot.cap) script:Cyrl ortho:Rus
  # Identical to Latin C: open bowl (arcs)

Т  CYRILLIC-CAPITAL-TE = FRAME(stem, bar.top) script:Cyrl ortho:Rus
  # Identical to Latin T: stem first, then top bar (stroke order)

У  CYRILLIC-CAPITAL-U = FRAME(diagonal.l, diagonal, stem) script:Cyrl ortho:Rus
  # Looks like Latin Y: diagonals first, stem last (stroke order)

Х  CYRILLIC-CAPITAL-HA = OVR(diagonal, diagonal.l) script:Cyrl ortho:Rus
  # Identical to Latin X: two crossing diagonals

# -----------------------------------------------------------------------------
# Cyrillic-specific letters
# -----------------------------------------------------------------------------

Б  CYRILLIC-CAPITAL-BE = FRAME(bar.top, stem.l, bowl.r.lower.cap) script:Cyrl ortho:Rus
  # Like Latin B but top bar extends past stem; single lower bowl

В  CYRILLIC-CAPITAL-VE = LR(stem.l, STACK(bowl.upper, bowl.lower), 3/9) script:Cyrl ortho:Rus
  # Identical to Latin B: stem with stacked upper and lower bowls

Г  CYRILLIC-CAPITAL-GHE = FRAME(stem.l, bar.top) script:Cyrl ortho:Rus
  # Like Latin L rotated 180 degrees or Greek Gamma (stroke order: stem first)

Д  CYRILLIC-CAPITAL-DE = FRAME(apex, bar.bot.cap, tail.cyr, tail.cyr) script:Cyrl ortho:Rus
  # Triangular top with legs descending below baseline

Ж  CYRILLIC-CAPITAL-ZHE = LR3(STACK(leg.cap.rev, leg.cap), stem.cyr, STACK(leg.cap, leg.cap.rev)) script:Cyrl ortho:Rus
  # Three-part: diagonal pairs flanking central stem (like K-stem-mirrored-K)

З  CYRILLIC-CAPITAL-ZE = STACK(arc.top.cap.r, arc.bot.cap.r) script:Cyrl ortho:Rus
  # Like numeral 3: two right-facing arcs stacked

И  CYRILLIC-CAPITAL-I = LR3(stem.l, diagonal, stem.r) script:Cyrl ortho:Rus
  # Like Latin N reversed: diagonal goes from lower-left to upper-right

Й  CYRILLIC-CAPITAL-SHORT-I = DIA(И, breve) script:Cyrl ortho:Rus
  # И with breve diacritic above

Л  CYRILLIC-CAPITAL-EL = apex script:Cyrl ortho:Rus
  # Like Greek Lambda or inverted V (no crossbar)

П  CYRILLIC-CAPITAL-PE = FRAME(stem.l, stem.r, bar.top) script:Cyrl ortho:Rus
  # Like Greek Pi: stems first, then top bar (stroke order)

Ф  CYRILLIC-CAPITAL-EF = OVR(bowl.cap, stem.cyr) script:Cyrl ortho:Rus
  # Stem through center of full bowl (like Greek Phi)

Ц  CYRILLIC-CAPITAL-TSE = FRAME(stem.l, bar.bot.cap, stem.r, tail.cyr) script:Cyrl ortho:Rus
  # Like П (Pe) but with descending tail at right

Ч  CYRILLIC-CAPITAL-CHE = FRAME(hook.cyr, stem.r) script:Cyrl ortho:Rus
  # Like inverted Latin L or numeral 4 without crossbar

Ш  CYRILLIC-CAPITAL-SHA = FRAME(stem.l, bar.bot.cap, stem.cyr, stem.r) script:Cyrl ortho:Rus
  # Like Latin W inverted: three stems on baseline bar

Щ  CYRILLIC-CAPITAL-SHCHA = FRAME(stem.l, bar.bot.cap, stem.cyr, stem.r, tail.cyr) script:Cyrl ortho:Rus
  # Ш (Sha) with descending tail at right

Ъ  CYRILLIC-CAPITAL-HARD-SIGN = FRAME(hard-sign.top, soft-sign.base) script:Cyrl ortho:Rus
  # Soft sign with horizontal bar extending left from top

Ы  CYRILLIC-CAPITAL-YERU = LR(soft-sign.base, stem.r) script:Cyrl ortho:Rus
  # Soft sign followed by separate vertical stem

Ь  CYRILLIC-CAPITAL-SOFT-SIGN = soft-sign.base script:Cyrl ortho:Rus
  # Vertical stem with rightward bowl at bottom

Э  CYRILLIC-CAPITAL-E = FRAME(STACK(arc.top.cap.r, arc.bot.cap.r), crossbar.cap) script:Cyrl ortho:Rus
  # Reversed Latin C (Є) with horizontal crossbar

Ю  CYRILLIC-CAPITAL-YU = LR(FRAME(stem.l, crossbar.cap.short), bowl.cap) script:Cyrl ortho:Rus
  # Stem with arm connecting to adjacent bowl (like IO ligature)

Я  CYRILLIC-CAPITAL-YA = FRAME(STACK(bowl.l.upper.cap, leg.cap.l), stem.r) script:Cyrl ortho:Rus
  # Like reversed Latin R: right stem with left-facing bowl and leg

# =============================================================================
# CYRILLIC LOWERCASE LETTERS (33 Russian)
# =============================================================================

# -----------------------------------------------------------------------------
# Letters sharing Latin structure
# -----------------------------------------------------------------------------

а  CYRILLIC-SMALL-A = LR(bowl.l, stem) script:Cyrl ortho:Rus
  # Like Latin a: left bowl with right stem

е  CYRILLIC-SMALL-IE = FRAME(crossbar.low, arc.top, arc.bot) script:Cyrl ortho:Rus
  # Like Latin e: crossbar first, then arcs (stroke order)

к  CYRILLIC-SMALL-KA = LR(stem, STACK(leg, leg.rev)) script:Cyrl ortho:Rus
  # Like Latin k but at x-height

м  CYRILLIC-SMALL-EM = FRAME(stem, vertex.inv, stem) script:Cyrl ortho:Rus
  # Like Latin m but constructed differently

н  CYRILLIC-SMALL-EN = FRAME(stem, crossbar, stem) script:Cyrl ortho:Rus
  # Like Latin n with extra stem (or small H)

о  CYRILLIC-SMALL-O = bowl.full script:Cyrl ortho:Rus
  # Identical to Latin o: closed bowl

р  CYRILLIC-SMALL-ER = STACK(bowl.r, descender) script:Cyrl ortho:Rus
  # Like Latin p but represents sound /r/

с  CYRILLIC-SMALL-ES = STACK(arc.top, arc.bot) script:Cyrl ortho:Rus
  # Identical to Latin c: open bowl

т  CYRILLIC-SMALL-TE = FRAME(stem, bar.top.x) script:Cyrl ortho:Rus
  # Miniature Т: stem first, then top bar (stroke order)

у  CYRILLIC-SMALL-U = FRAME(vertex, descender.curved) script:Cyrl ortho:Rus
  # Like Latin y: vertex with curved descender

х  CYRILLIC-SMALL-HA = OVR(diagonal.x, diagonal.l) script:Cyrl ortho:Rus
  # Identical to Latin x: crossing diagonals at x-height

# -----------------------------------------------------------------------------
# Cyrillic-specific letters
# -----------------------------------------------------------------------------

б  CYRILLIC-SMALL-BE = STACK(hook.top.cyr, bowl.full) script:Cyrl ortho:Rus
  # Ascender with curved top flowing into bowl (like numeral 6)

в  CYRILLIC-SMALL-VE = LR(stem, STACK(bowl.r.upper, bowl.r.lower)) script:Cyrl ortho:Rus
  # Like small Latin b with two stacked bowls

г  CYRILLIC-SMALL-GHE = FRAME(stem, bar.top.x) script:Cyrl ortho:Rus
  # Like lowercase Г: stem first, then top bar (stroke order)

д  CYRILLIC-SMALL-DE = FRAME(apex.x, bar.bot, tail.cyr, tail.cyr) script:Cyrl ortho:Rus
  # Like small Д: triangular with descending tails

ж  CYRILLIC-SMALL-ZHE = LR3(STACK(leg.rev, leg), stem, STACK(leg, leg.rev)) script:Cyrl ortho:Rus
  # Like small Ж: central stem with diagonal pairs

з  CYRILLIC-SMALL-ZE = STACK(arc.top.r, arc.bot.r) script:Cyrl ortho:Rus
  # Like numeral 3 at x-height

и  CYRILLIC-SMALL-I = LR3(stem, diagonal.x, stem) script:Cyrl ortho:Rus
  # Like small И: reversed n diagonal

й  CYRILLIC-SMALL-SHORT-I = DIA(и, breve) script:Cyrl ortho:Rus
  # и with breve above

л  CYRILLIC-SMALL-EL = apex.x script:Cyrl ortho:Rus
  # Like inverted v at x-height

п  CYRILLIC-SMALL-PE = FRAME(stem, stem, bar.top.x) script:Cyrl ortho:Rus
  # Like small п: stems first, then top bar (stroke order)

ф  CYRILLIC-SMALL-EF = STACK(ascender, bowl.full, descender) script:Cyrl ortho:Rus
  # Vertical line through bowl, extending above and below

ц  CYRILLIC-SMALL-TSE = FRAME(stem, bar.bot, stem, tail.cyr) script:Cyrl ortho:Rus
  # Like п with descending tail

ч  CYRILLIC-SMALL-CHE = FRAME(hook.cyr, stem) script:Cyrl ortho:Rus
  # Like inverted small h

ш  CYRILLIC-SMALL-SHA = FRAME(stem, bar.bot, stem, stem) script:Cyrl ortho:Rus
  # Three stems on baseline

щ  CYRILLIC-SMALL-SHCHA = FRAME(stem, bar.bot, stem, stem, tail.cyr) script:Cyrl ortho:Rus
  # ш with descending tail

ъ  CYRILLIC-SMALL-HARD-SIGN = FRAME(hard-sign.top, soft-sign.base) script:Cyrl ortho:Rus
  # Small hard sign

ы  CYRILLIC-SMALL-YERU = LR(soft-sign.base, stem) script:Cyrl ortho:Rus
  # Soft sign with separate stem

ь  CYRILLIC-SMALL-SOFT-SIGN = soft-sign.base script:Cyrl ortho:Rus
  # Stem with rightward bowl at bottom

э  CYRILLIC-SMALL-E = FRAME(STACK(arc.top.r, arc.bot.r), crossbar) script:Cyrl ortho:Rus
  # Reversed c with crossbar

ю  CYRILLIC-SMALL-YU = LR(FRAME(stem, crossbar.short), bowl.full) script:Cyrl ortho:Rus
  # Stem connected to adjacent bowl

я  CYRILLIC-SMALL-YA = FRAME(STACK(bowl.l.upper, leg.l), stem) script:Cyrl ortho:Rus
  # Reversed r at x-height

# =============================================================================
# UKRAINIAN EXTENSIONS (4 letters)
# =============================================================================
# Ukrainian uses the Russian alphabet plus these four additional letters

Ґ  CYRILLIC-CAPITAL-GHE-UPTURN = FRAME(stem.l, bar.top, tick.cyr) script:Cyrl ortho:Ukr
  # Г with small ascending tick: stem first, then bar, then tick (stroke order)

ґ  CYRILLIC-SMALL-GHE-UPTURN = FRAME(stem, bar.top.x, tick.cyr) script:Cyrl ortho:Ukr
  # Small г with ascending tick: stem first (stroke order)

Є  CYRILLIC-CAPITAL-UKRAINIAN-IE = FRAME(STACK(arc.top.cap, arc.bot.cap), crossbar.cap) script:Cyrl ortho:Ukr
  # Like Latin E but curved (reversed Э)

є  CYRILLIC-SMALL-UKRAINIAN-IE = FRAME(STACK(arc.top, arc.bot), crossbar) script:Cyrl ortho:Ukr
  # Like reversed small э

І  CYRILLIC-CAPITAL-BYELORUSSIAN-UKRAINIAN-I = stem.l script:Cyrl ortho:Ukr
  # Identical to Latin I (vertical stem)

і  CYRILLIC-SMALL-BYELORUSSIAN-UKRAINIAN-I = STACK(tittle, stem) script:Cyrl ortho:Ukr
  # Identical to Latin i (stem with tittle)

Ї  CYRILLIC-CAPITAL-YI = DIA(І, diaeresis) script:Cyrl ortho:Ukr
  # І with diaeresis (two dots above)

ї  CYRILLIC-SMALL-YI = DIA(і, diaeresis) script:Cyrl ortho:Ukr
  # і with diaeresis (two dots above)

# =============================================================================
# ACCENTED CYRILLIC (U+0400-040F / U+0450-045F)
# =============================================================================
# These are mostly base letters with diacritics, used in various Slavic
# and non-Slavic languages using the Cyrillic script.

# -----------------------------------------------------------------------------
# Accented Capital Letters (U+0400-040F)
# -----------------------------------------------------------------------------

Ѐ  CYRILLIC-CAPITAL-IE-GRAVE = DIA(Е, grave) script:Cyrl ortho:Mac
  # Е with grave accent (Macedonian)

Ё  CYRILLIC-CAPITAL-IO = DIA(Е, diaeresis) script:Cyrl ortho:Rus
  # Е with diaeresis (Russian ё)

Ђ  CYRILLIC-CAPITAL-DJE = FRAME(soft-sign.base, bar.top.x) script:Cyrl ortho:Srp
  # Serbian Dje - like Ћ with top bar (voiced)

Ѓ  CYRILLIC-CAPITAL-GJE = DIA(Г, acute) script:Cyrl ortho:Mac
  # Macedonian Gje - Г with acute

Ѕ  CYRILLIC-CAPITAL-DZE = spine.cap script:Cyrl ortho:Mac
  # Macedonian Dze - like Latin S

Ј  CYRILLIC-CAPITAL-JE = STACK(hook.bot, stem.l) script:Cyrl ortho:Srp
  # Serbian/Macedonian Je - like Latin J

Љ  CYRILLIC-CAPITAL-LJE = LR(apex, soft-sign.base) script:Cyrl ortho:Srp
  # Serbian/Macedonian Lje - Л + soft sign ligature

Њ  CYRILLIC-CAPITAL-NJE = LR(FRAME(stem.l, crossbar.cap, stem.r), soft-sign.base) script:Cyrl ortho:Srp
  # Serbian/Macedonian Nje - Н + soft sign ligature

Ћ  CYRILLIC-CAPITAL-TSHE = FRAME(soft-sign.base, bar.top.x) script:Cyrl ortho:Srp
  # Serbian Tshe - like soft sign with top bar (voiceless)

Ќ  CYRILLIC-CAPITAL-KJE = DIA(К, acute) script:Cyrl ortho:Mac
  # Macedonian Kje - К with acute

Ѝ  CYRILLIC-CAPITAL-I-GRAVE = DIA(И, grave) script:Cyrl ortho:Mac
  # И with grave (Macedonian, Bulgarian)

Ў  CYRILLIC-CAPITAL-SHORT-U = DIA(У, breve) script:Cyrl ortho:Blr
  # Belarusian short U - У with breve

Џ  CYRILLIC-CAPITAL-DZHE = FRAME(hook.cyr, stem.cyr, stem.r) script:Cyrl ortho:Srp
  # Serbian Dzhe - like Ч with extra stem

# -----------------------------------------------------------------------------
# Accented Small Letters (U+0450-045F)
# -----------------------------------------------------------------------------

ѐ  CYRILLIC-SMALL-IE-GRAVE = DIA(е, grave) script:Cyrl ortho:Mac
  # е with grave accent

ё  CYRILLIC-SMALL-IO = DIA(е, diaeresis) script:Cyrl ortho:Rus
  # е with diaeresis

ђ  CYRILLIC-SMALL-DJE = FRAME(ascender.l, bar.top.x, soft-sign.base) script:Cyrl ortho:Srp
  # Serbian small dje

ѓ  CYRILLIC-SMALL-GJE = DIA(г, acute) script:Cyrl ortho:Mac
  # Macedonian small gje

ѕ  CYRILLIC-SMALL-DZE = FRAME(arc.top, spine, arc.bot) script:Cyrl ortho:Mac
  # Macedonian small dze - like Latin s

ј  CYRILLIC-SMALL-JE = STACK(tittle, hook.bot, stem) script:Cyrl ortho:Srp
  # Small je - like Latin j

љ  CYRILLIC-SMALL-LJE = LR(apex.x, soft-sign.base) script:Cyrl ortho:Srp
  # Small lje - л + ь ligature

њ  CYRILLIC-SMALL-NJE = LR(FRAME(stem, crossbar, stem), soft-sign.base) script:Cyrl ortho:Srp
  # Small nje - н + ь ligature

ћ  CYRILLIC-SMALL-TSHE = FRAME(ascender.l, bar.top.x, soft-sign.base) script:Cyrl ortho:Srp
  # Small tshe

ќ  CYRILLIC-SMALL-KJE = DIA(к, acute) script:Cyrl ortho:Mac
  # Macedonian small kje

ѝ  CYRILLIC-SMALL-I-GRAVE = DIA(и, grave) script:Cyrl ortho:Mac
  # и with grave

ў  CYRILLIC-SMALL-SHORT-U = DIA(у, breve) script:Cyrl ortho:Blr
  # Belarusian small short u

џ  CYRILLIC-SMALL-DZHE = FRAME(hook.cyr, stem, stem) script:Cyrl ortho:Srp
  # Serbian small dzhe

# =============================================================================
# HISTORICAL CYRILLIC (U+0460-047F)
# =============================================================================
# Letters used in Old Church Slavonic and historical texts.

# -----------------------------------------------------------------------------
# Historical Capital Letters
# -----------------------------------------------------------------------------

Ѡ  CYRILLIC-CAPITAL-OMEGA = FRAME(bowl.cap, bowl.cap) script:Cyrl ortho:OCS
  # Omega - two joined bowls like Latin W inverted base

Ѣ  CYRILLIC-CAPITAL-YAT = FRAME(stem.cyr, bar.top, soft-sign.base) script:Cyrl ortho:OCS
  # Yat - historical vowel, like Ъ with top extension

Ѥ  CYRILLIC-CAPITAL-IOTIFIED-E = LR(stem.l, Є) script:Cyrl ortho:OCS
  # Iotified E - І + Є ligature

Ѧ  CYRILLIC-CAPITAL-LITTLE-YUS = FRAME(apex, crossbar.cap) script:Cyrl ortho:OCS
  # Little yus - like Л with crossbar (nasal vowel)

Ѩ  CYRILLIC-CAPITAL-IOTIFIED-LITTLE-YUS = LR(stem.l, Ѧ) script:Cyrl ortho:OCS
  # Iotified little yus - І + Ѧ ligature

Ѫ  CYRILLIC-CAPITAL-BIG-YUS = FRAME(apex, crossbar.cap, stem.cyr) script:Cyrl ortho:OCS
  # Big yus - like Ѧ with central descender

Ѭ  CYRILLIC-CAPITAL-IOTIFIED-BIG-YUS = LR(stem.l, Ѫ) script:Cyrl ortho:OCS
  # Iotified big yus - І + Ѫ ligature

Ѯ  CYRILLIC-CAPITAL-KSI = FRAME(STACK(arc.top.cap.r, arc.bot.cap.r), crossbar.cap) script:Cyrl ortho:OCS
  # Ksi - borrowed from Greek Ξ

Ѱ  CYRILLIC-CAPITAL-PSI = FRAME(vertex.cap, stem.cyr) script:Cyrl ortho:OCS
  # Psi - borrowed from Greek Ψ

Ѳ  CYRILLIC-CAPITAL-FITA = OVR(bowl.cap, crossbar.cap) script:Cyrl ortho:OCS
  # Fita - borrowed from Greek Θ (theta)

Ѵ  CYRILLIC-CAPITAL-IZHITSA = vertex.cap script:Cyrl ortho:OCS
  # Izhitsa - borrowed from Greek Υ (upsilon)

# -----------------------------------------------------------------------------
# Historical Small Letters
# -----------------------------------------------------------------------------

ѡ  CYRILLIC-SMALL-OMEGA = FRAME(bowl.full, bowl.full) script:Cyrl ortho:OCS
  # Small omega - two joined bowls

ѣ  CYRILLIC-SMALL-YAT = FRAME(ascender, bar.top.x, soft-sign.base) script:Cyrl ortho:OCS
  # Small yat - like ъ with ascender

ѥ  CYRILLIC-SMALL-IOTIFIED-E = LR(stem, є) script:Cyrl ortho:OCS
  # Small iotified e - і + є ligature

ѧ  CYRILLIC-SMALL-LITTLE-YUS = FRAME(apex.x, crossbar) script:Cyrl ortho:OCS
  # Small little yus

ѩ  CYRILLIC-SMALL-IOTIFIED-LITTLE-YUS = LR(stem, ѧ) script:Cyrl ortho:OCS
  # Small iotified little yus

ѫ  CYRILLIC-SMALL-BIG-YUS = FRAME(apex.x, crossbar, descender) script:Cyrl ortho:OCS
  # Small big yus - like ѧ with central descender

ѭ  CYRILLIC-SMALL-IOTIFIED-BIG-YUS = LR(stem, ѫ) script:Cyrl ortho:OCS
  # Small iotified big yus

ѯ  CYRILLIC-SMALL-KSI = FRAME(STACK(arc.top.r, arc.bot.r), crossbar) script:Cyrl ortho:OCS
  # Small ksi

ѱ  CYRILLIC-SMALL-PSI = FRAME(vertex, descender) script:Cyrl ortho:OCS
  # Small psi

ѳ  CYRILLIC-SMALL-FITA = OVR(bowl.full, crossbar) script:Cyrl ortho:OCS
  # Small fita

ѵ  CYRILLIC-SMALL-IZHITSA = vertex script:Cyrl ortho:OCS
  # Small izhitsa

Ѷ  CYRILLIC-CAPITAL-IZHITSA-DOUBLE-GRAVE = DIA(Ѵ, double-grave) script:Cyrl ortho:OCS
  # Izhitsa with double grave accent

ѷ  CYRILLIC-SMALL-IZHITSA-DOUBLE-GRAVE = DIA(ѵ, double-grave) script:Cyrl ortho:OCS
  # Small izhitsa with double grave

Ѹ  CYRILLIC-CAPITAL-UK = LR(О, У) script:Cyrl ortho:OCS
  # Uk digraph - O + У ligature

ѹ  CYRILLIC-SMALL-UK = LR(о, у) script:Cyrl ortho:OCS
  # Small uk digraph

Ѻ  CYRILLIC-CAPITAL-ROUND-OMEGA = bowl.cap script:Cyrl ortho:OCS
  # Round Omega - like O but semantically distinct

ѻ  CYRILLIC-SMALL-ROUND-OMEGA = bowl.full script:Cyrl ortho:OCS
  # Small round omega

Ѽ  CYRILLIC-CAPITAL-OMEGA-TITLO = DIA(Ѡ, overline) script:Cyrl ortho:OCS
  # Omega with titlo (abbreviation mark, rendered as overline)

ѽ  CYRILLIC-SMALL-OMEGA-TITLO = DIA(ѡ, overline) script:Cyrl ortho:OCS
  # Small omega with titlo (rendered as overline)

Ѿ  CYRILLIC-CAPITAL-OT = LR(Ѡ, Т) script:Cyrl ortho:OCS
  # Ot - Omega + Te ligature

ѿ  CYRILLIC-SMALL-OT = LR(ѡ, т) script:Cyrl ortho:OCS
  # Small ot

# =============================================================================
# END OF CYRILLIC ALPHABET LIBRARY
# =============================================================================
