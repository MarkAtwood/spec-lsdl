@lsdl 1.0

# =============================================================================
# LSDL IPA Extensions Character Library (U+0250-U+02AF)
# =============================================================================
#
# This file defines the 96 characters in the IPA Extensions Unicode block.
# These characters are phonetic symbols used in the International Phonetic
# Alphabet and related transcription systems.
#
# Categories:
#   - Turned letters (rotated 180 degrees): ɐ, ɒ, ɔ, ɜ, ɥ, ɯ, ɹ, ʌ
#   - Variant letters (modified forms): ɑ (alpha), ɛ (epsilon), ə (schwa)
#   - Hooked letters: ɓ, ɗ, ɠ, ʄ
#   - Tail letters: ɖ, ɭ, ɳ, ɽ, ʈ
#   - Special IPA forms: ɡ (script g), ʃ (esh), ʒ (ezh), ŋ (eng)
#   - Small capitals: ʀ, ʜ, ɪ, ʏ
#
# Composition patterns:
#   - sc(expr, sx=-12, sy=-12): 180-degree rotation (turned)
#   - sc(expr, sx=-12, sy=12): Horizontal mirror (reversed)
#   - sc(expr, sx=12, sy=-12): Vertical mirror (inverted)
#   - FRAME: Complex letterforms with hooks, tails
#   - Direct element references for unique shapes
#
# Note: Many IPA characters are lowercase forms corresponding to capital
# letters in Latin Extended-B. Case mappings connect across blocks.
#
# =============================================================================

# =============================================================================
# SPECIAL ELEMENTS FOR IPA EXTENSIONS
# =============================================================================

# -----------------------------------------------------------------------------
# turned.a - Turned lowercase a shape
# For ɐ (Latin Small Letter Turned A)
# Stroke order: counterclockwise from top (top -> left -> bottom -> right)
# -----------------------------------------------------------------------------
@elem turned.a
zone: x-height
path: p1 p2 p3 p4 p5
p1 = [6,4]
p2 = C([0,4] [0,6])
p3 = C([0,8] [4,8])
p4 = C([10,8] [10,6])
p5 = [10,4]
close: true
width: 1
anchors: top=[6,4] base=[6,8] mid=[5,6]
  mark-above=[6,3] mark-below=[6,9]
@end

# -----------------------------------------------------------------------------
# alpha.small - Latin alpha shape (open at top right)
# For ɑ (Latin Small Letter Alpha)
# Stroke order: counterclockwise from top-center (top -> left -> bottom -> right)
# Open path ends at right side
# -----------------------------------------------------------------------------
@elem alpha.small
zone: x-height
path: p1 p2 p3 p4 p5
p1 = [6,4]
p2 = C([2,4] [2,6])
p3 = C([2,8] [6,8])
p4 = C([10,8] [10,6])
p5 = [10,4]
close: false
width: 1
anchors: top=[6,4] base=[6,8] mid=[6,6]
  mark-above=[6,3] mark-below=[6,9]
@end

# -----------------------------------------------------------------------------
# turned.alpha - Turned alpha shape
# For ɒ (Latin Small Letter Turned Alpha)
# Stroke order: counterclockwise from top (top -> right -> bottom)
# Open path ends at left side (mirror of alpha.small)
# -----------------------------------------------------------------------------
@elem turned.alpha
zone: x-height
path: p1 p2 p3 p4 p5
p1 = [6,4]
p2 = C([10,4] [10,6])
p3 = C([10,8] [6,8])
p4 = C([2,8] [2,6])
p5 = [2,4]
close: false
width: 1
anchors: top=[6,4] base=[6,8] mid=[6,6]
  mark-above=[6,3] mark-below=[6,9]
@end

# -----------------------------------------------------------------------------
# open.o.small - Open O shape (like reversed C)
# For ɔ (Latin Small Letter Open O)
# Stroke order: counterclockwise from top (top -> left -> bottom)
# Open path for reversed C shape
# -----------------------------------------------------------------------------
@elem open.o.small
zone: x-height
path: p1 p2 p3 p4
p1 = [6,4]
p2 = C([2,4] [2,6])
p3 = C([2,8] [6,8])
p4 = C([10,8] [10,6])
close: false
width: 1
anchors: top=[6,4] base=[6,8] left=[2,6]
  mark-above=[6,3] mark-below=[6,9]
@end

# -----------------------------------------------------------------------------
# open.e.small - Open E shape (epsilon-like)
# For ɛ (Latin Small Letter Open E)
# -----------------------------------------------------------------------------
@elem open.e.small
zone: x-height
path: p1 p2 p3 p4 p5
p1 = [10,4]
p2 = C([4,4] [2,5])
p3 = [6,6]
p4 = C([2,7] [4,8])
p5 = [10,8]
close: false
width: 1
anchors: top=[6,4] base=[6,8] mid=[6,6]
  mark-above=[6,3] mark-below=[6,9]
@end

# -----------------------------------------------------------------------------
# reversed.open.e - Reversed open E (for ɜ)
# For ɜ (Latin Small Letter Reversed Open E)
# -----------------------------------------------------------------------------
@elem reversed.open.e
zone: x-height
path: p1 p2 p3 p4 p5
p1 = [2,4]
p2 = C([8,4] [10,5])
p3 = [6,6]
p4 = C([10,7] [8,8])
p5 = [2,8]
close: false
width: 1
anchors: top=[6,4] base=[6,8] mid=[6,6]
  mark-above=[6,3] mark-below=[6,9]
@end

# -----------------------------------------------------------------------------
# script.g - Script g shape (single-storey)
# For ɡ (Latin Small Letter Script G)
# Stroke order: counterclockwise from top-center (top -> left -> bottom -> right)
# Open path with descender loop
# -----------------------------------------------------------------------------
@elem script.g
zone: descender
path: p1 p2 p3 p4 p5 p6
p1 = [6,4]
p2 = C([2,4] [2,6])
p3 = C([2,8] [2,10])
p4 = C([2,10] [6,10])
p5 = C([10,10] [10,8])
p6 = [10,4]
close: false
width: 1
anchors: top=[6,4] base=[6,10] mid=[6,7]
  mark-above=[6,3] mark-below=[6,11]
@end

# -----------------------------------------------------------------------------
# turned.h - Turned h shape
# For ɥ (Latin Small Letter Turned H)
# -----------------------------------------------------------------------------
@elem turned.h
zone: descender
path: p1 p2 p3 p4 p5 p6
p1 = [2,4]
p2 = [2,10]
p3 = [10,10]
p4 = [10,6]
p5 = C([10,4] [6,4])
p6 = C([2,4] [2,6])
close: false
width: 1
anchors: top=[6,4] base=[6,10]
  mark-above=[6,3] mark-below=[6,11]
@end

# -----------------------------------------------------------------------------
# turned.m - Turned m shape
# For ɯ (Latin Small Letter Turned M)
# -----------------------------------------------------------------------------
@elem turned.m
zone: x-height
path: p1 p2 p3 p4 p5 p6 p7
p1 = [0,4]
p2 = [0,8]
p3 = C([0,6] [3,6])
p4 = C([6,6] [6,8])
p5 = C([6,6] [9,6])
p6 = C([12,6] [12,8])
p7 = [12,4]
close: false
width: 1
anchors: top=[6,4] base=[6,8]
  mark-above=[6,3] mark-below=[6,9]
@end

# -----------------------------------------------------------------------------
# turned.r - Turned r shape
# For ɹ (Latin Small Letter Turned R)
# -----------------------------------------------------------------------------
@elem turned.r
zone: x-height
path: p1 p2 p3 p4
p1 = [6,4]
p2 = [6,8]
p3 = C([6,6] [4,6])
p4 = C([2,6] [2,8])
close: false
width: 1
anchors: top=[6,4] base=[6,8]
  mark-above=[6,3] mark-below=[6,9]
@end

# -----------------------------------------------------------------------------
# small.cap.r.inverted - Small capital inverted R
# For ʁ (Latin Letter Small Capital Inverted R)
# -----------------------------------------------------------------------------
@elem small.cap.r.inverted
zone: x-height
path: p1 p2 p3 p4 p5 p6
p1 = [10,4]
p2 = [10,8]
p3 = [4,8]
p4 = C([10,8] [10,6])
p5 = C([10,4] [6,4])
p6 = [2,8]
close: false
width: 1
anchors: top=[6,4] base=[6,8]
  mark-above=[6,3] mark-below=[6,9]
@end

# -----------------------------------------------------------------------------
# esh - IPA esh shape (long S with descender)
# For ʃ (Latin Small Letter Esh) - already defined in latin-extended-b as esh.small
# Redefine here for clarity
# -----------------------------------------------------------------------------
@elem esh.ipa
zone: full
path: p1 p2 p3 p4 p5 p6
p1 = [8,1]
p2 = C([4,1] [4,3])
p3 = [4,6]
p4 = C([4,9] [6,9])
p5 = C([8,9] [8,10])
p6 = [6,10]
close: false
width: 1
anchors: top=[6,1] base=[6,10]
  mark-above=[6,0] mark-below=[6,11]
@end

# -----------------------------------------------------------------------------
# upsilon.small - Small upsilon shape
# For ʊ (Latin Small Letter Upsilon)
# -----------------------------------------------------------------------------
@elem upsilon.small
zone: x-height
path: p1 p2 p3 p4 p5
p1 = [2,4]
p2 = C([2,7] [4,8])
p3 = C([8,8] [10,7])
p4 = [10,4]
p5 = [6,6]
close: false
width: 1
anchors: top=[6,4] base=[6,8]
  mark-above=[6,3] mark-below=[6,9]
@end

# -----------------------------------------------------------------------------
# turned.v - Turned v shape (caret)
# For ʌ (Latin Small Letter Turned V)
# -----------------------------------------------------------------------------
@elem turned.v
zone: x-height
path: p1 p2 p3
p1 = [0,8]
p2 = [6,4]
p3 = [12,8]
close: false
width: 1
anchors: top=[6,4] base=[6,8]
  mark-above=[6,3] mark-below=[6,9]
@end

# -----------------------------------------------------------------------------
# ezh.ipa - IPA ezh shape (like 3)
# For ʒ (Latin Small Letter Ezh) - similar to latin-extended-b but x-height
# -----------------------------------------------------------------------------
@elem ezh.ipa
zone: x-height
path: p1 p2 p3 p4 p5
p1 = [2,4]
p2 = [10,4]
p3 = C([10,5] [6,6])
p4 = C([10,7] [10,8])
p5 = [2,8]
close: false
width: 1
anchors: top=[6,4] base=[6,8]
  mark-above=[6,3] mark-below=[6,9]
@end

# -----------------------------------------------------------------------------
# eng.small - Eng shape (n with descender hook)
# For ŋ (Latin Small Letter Eng) - note: this is U+014B from Latin Extended-A
# but we include the element for reference
# -----------------------------------------------------------------------------
@elem eng.small
zone: descender
path: p1 p2 p3 p4 p5 p6
p1 = [2,4]
p2 = [2,8]
p3 = C([2,5] [6,4])
p4 = C([10,4] [10,6])
p5 = [10,10]
p6 = C([10,11] [8,11])
close: false
width: 1
anchors: top=[6,4] base=[8,11]
  mark-above=[6,3] mark-below=[6,12]
@end

# -----------------------------------------------------------------------------
# hooked.b - b with hook (implosive)
# For ɓ (Latin Small Letter B with Hook)
# Stroke order: hook top-down, then bowl counterclockwise from junction
# Bowl: top-left junction -> top-right -> bottom-right -> bottom-left
# -----------------------------------------------------------------------------
@elem hooked.b
zone: full
path: p1 p2 p3 p4 p5 p6 p7
p1 = [4,0]
p2 = C([2,0] [2,2])
p3 = [2,4]
p4 = C([2,4] [6,4])
p5 = C([10,4] [10,6])
p6 = C([10,8] [6,8])
p7 = [2,8]
close: false
width: 1
anchors: top=[4,0] base=[6,8]
  mark-above=[4,0] mark-below=[6,9]
@end

# -----------------------------------------------------------------------------
# retroflex.d - D with tail (retroflex)
# For ɖ (Latin Small Letter D with Tail)
# -----------------------------------------------------------------------------
@elem retroflex.d
zone: full
path: p1 p2 p3 p4 p5 p6
p1 = [10,1]
p2 = [10,9]
p3 = C([10,10] [8,10])
p4 = [6,4]
p5 = C([2,4] [2,6])
p6 = C([2,8] [6,8])
close: false
width: 1
anchors: top=[10,1] base=[8,10]
  mark-above=[6,0] mark-below=[6,11]
@end

# -----------------------------------------------------------------------------
# hooked.d - d with hook (implosive)
# For ɗ (Latin Small Letter D with Hook)
# -----------------------------------------------------------------------------
@elem hooked.d
zone: full
path: p1 p2 p3 p4 p5 p6 p7
p1 = [8,0]
p2 = C([10,0] [10,2])
p3 = [10,8]
p4 = C([10,8] [6,8])
p5 = C([2,8] [2,6])
p6 = C([2,4] [6,4])
p7 = [10,4]
close: false
width: 1
anchors: top=[8,0] base=[6,8]
  mark-above=[8,0] mark-below=[6,9]
@end

# -----------------------------------------------------------------------------
# schwa.small.ipa - Small schwa (turned e) for IPA
# Identical to schwa.small in latin-extended-b
# -----------------------------------------------------------------------------
@elem schwa.ipa
zone: x-height
path: p1 p2 p3 p4 p5
p1 = [2,4]
p2 = C([8,4] [10,5])
p3 = C([10,7] [6,6])
p4 = C([2,7] [2,8])
p5 = [10,8]
close: false
width: 1
anchors: top=[6,4] base=[6,8] mid=[6,6]
  mark-above=[6,3] mark-below=[6,9]
@end

# -----------------------------------------------------------------------------
# small.cap.i - Small capital I
# For ɪ (Latin Letter Small Capital I)
# -----------------------------------------------------------------------------
@elem small.cap.i
zone: x-height
path: p1 p2
p1 = [6,4]
p2 = [6,8]
close: false
width: 1
anchors: top=[6,4] base=[6,8]
  mark-above=[6,3] mark-below=[6,9]
@end

# -----------------------------------------------------------------------------
# small.cap.y - Small capital Y
# For ʏ (Latin Letter Small Capital Y)
# -----------------------------------------------------------------------------
@elem small.cap.y
zone: x-height
path: p1 p2 p3 p4
p1 = [2,4]
p2 = [6,6]
p3 = [10,4]
p4 = [6,8]
close: false
width: 1
anchors: top=[6,4] base=[6,8]
  mark-above=[6,3] mark-below=[6,9]
@end

# -----------------------------------------------------------------------------
# bilabial.click - Bilabial click shape
# For ʘ (Latin Letter Bilabial Click)
# -----------------------------------------------------------------------------
@elem bilabial.click
zone: x-height
path: p1 p2 p3 p4 p5 p6 p7
p1 = [6,4]
p2 = C([2,4] [2,6])
p3 = C([2,8] [6,8])
p4 = C([10,8] [10,6])
p5 = C([10,4] [6,4])
p6 = [6,5]
p7 = [6,7]
close: false
width: 1
anchors: top=[6,4] base=[6,8]
  mark-above=[6,3] mark-below=[6,9]
@end

# -----------------------------------------------------------------------------
# gamma.ipa - Gamma shape for IPA
# For ɣ (Latin Small Letter Gamma)
# -----------------------------------------------------------------------------
@elem gamma.ipa
zone: x-height
path: p1 p2 p3 p4
p1 = [2,4]
p2 = [6,6]
p3 = [10,4]
p4 = [6,8]
close: false
width: 1
anchors: top=[6,4] base=[6,8]
  mark-above=[6,3] mark-below=[6,9]
@end

# -----------------------------------------------------------------------------
# iota.ipa - Iota shape for IPA
# For ɩ (Latin Small Letter Iota)
# -----------------------------------------------------------------------------
@elem iota.ipa
zone: x-height
path: p1 p2 p3
p1 = [6,4]
p2 = [6,8]
p3 = C([6,9] [4,9])
close: false
width: 1
anchors: top=[6,4] base=[4,9]
  mark-above=[6,3] mark-below=[4,10]
@end

# -----------------------------------------------------------------------------
# glottal.ipa - Glottal stop shape for IPA
# For ʔ (Latin Letter Glottal Stop)
# -----------------------------------------------------------------------------
@elem glottal.ipa
zone: x-height
path: p1 p2 p3 p4
p1 = [2,4]
p2 = C([10,4] [10,5])
p3 = [6,6]
p4 = [6,8]
close: false
width: 1
anchors: top=[6,4] base=[6,8]
  mark-above=[6,3] mark-below=[6,9]
@end

# =============================================================================
# CHARACTERS U+0250-025F
# =============================================================================

# ɐ - Latin Small Letter Turned A
ɐ  LATIN-SMALL-TURNED-A = turned.a cp:U+0250 script:Latn

# ɑ - Latin Small Letter Alpha
ɑ  LATIN-SMALL-ALPHA = alpha.small cp:U+0251 script:Latn

# ɒ - Latin Small Letter Turned Alpha
ɒ  LATIN-SMALL-TURNED-ALPHA = turned.alpha cp:U+0252 script:Latn

# ɓ - Latin Small Letter B with Hook
ɓ  LATIN-SMALL-B-HOOK = hooked.b cp:U+0253 script:Latn

# ɔ - Latin Small Letter Open O
ɔ  LATIN-SMALL-OPEN-O = open.o.small cp:U+0254 script:Latn

# ɕ - Latin Small Letter C with Curl
ɕ  LATIN-SMALL-C-CURL = FRAME(c, hook.bot.right) cp:U+0255 script:Latn

# ɖ - Latin Small Letter D with Tail
ɖ  LATIN-SMALL-D-TAIL = retroflex.d cp:U+0256 script:Latn

# ɗ - Latin Small Letter D with Hook
ɗ  LATIN-SMALL-D-HOOK = hooked.d cp:U+0257 script:Latn

# ɘ - Latin Small Letter Reversed E
ɘ  LATIN-SMALL-REVERSED-E = sc(e, sx=-12, sy=12) cp:U+0258 script:Latn

# ə - Latin Small Letter Schwa
ə  LATIN-SMALL-SCHWA = schwa.ipa cp:U+0259 script:Latn

# ɚ - Latin Small Letter Schwa with Hook
ɚ  LATIN-SMALL-SCHWA-HOOK = FRAME(schwa.ipa, hook.bot.right) cp:U+025A script:Latn

# ɛ - Latin Small Letter Open E
ɛ  LATIN-SMALL-OPEN-E = open.e.small cp:U+025B script:Latn

# ɜ - Latin Small Letter Reversed Open E
ɜ  LATIN-SMALL-REVERSED-OPEN-E = reversed.open.e cp:U+025C script:Latn

# ɝ - Latin Small Letter Reversed Open E with Hook
ɝ  LATIN-SMALL-REVERSED-OPEN-E-HOOK = FRAME(reversed.open.e, hook.bot.right) cp:U+025D script:Latn

# ɞ - Latin Small Letter Closed Reversed Open E
ɞ  LATIN-SMALL-CLOSED-REVERSED-OPEN-E = sc(reversed.open.e, sx=12, sy=-12) cp:U+025E script:Latn

# ɟ - Latin Small Letter Dotless J with Stroke
ɟ  LATIN-SMALL-DOTLESS-J-STROKE = OVR(STACK(stem, hook.bot), stroke.horiz) cp:U+025F script:Latn

# =============================================================================
# CHARACTERS U+0260-026F
# =============================================================================

# ɠ - Latin Small Letter G with Hook
ɠ  LATIN-SMALL-G-HOOK = FRAME(g, hook.top) cp:U+0260 script:Latn

# ɡ - Latin Small Letter Script G
ɡ  LATIN-SMALL-SCRIPT-G = script.g cp:U+0261 script:Latn

# ɢ - Latin Letter Small Capital G
ɢ  LATIN-LETTER-SMALL-CAPITAL-G = sc(G, sx=9, sy=6) cp:U+0262 script:Latn

# ɣ - Latin Small Letter Gamma
ɣ  LATIN-SMALL-GAMMA = gamma.ipa cp:U+0263 script:Latn

# ɤ - Latin Small Letter Rams Horn
ɤ  LATIN-SMALL-RAMS-HORN = FRAME(vertex, shoulder) cp:U+0264 script:Latn

# ɥ - Latin Small Letter Turned H
ɥ  LATIN-SMALL-TURNED-H = turned.h cp:U+0265 script:Latn

# ɦ - Latin Small Letter H with Hook
ɦ  LATIN-SMALL-H-HOOK = FRAME(h, hook.bot) cp:U+0266 script:Latn

# ɧ - Latin Small Letter Heng with Hook
ɧ  LATIN-SMALL-HENG-HOOK = FRAME(h, hook.bot, ear) cp:U+0267 script:Latn

# ɨ - Latin Small Letter I with Stroke
ɨ  LATIN-SMALL-I-STROKE = OVR(i, stroke.horiz) cp:U+0268 script:Latn

# ɩ - Latin Small Letter Iota
ɩ  LATIN-SMALL-IOTA = iota.ipa cp:U+0269 script:Latn

# ɪ - Latin Letter Small Capital I
ɪ  LATIN-LETTER-SMALL-CAPITAL-I = small.cap.i cp:U+026A script:Latn

# ɫ - Latin Small Letter L with Middle Tilde
ɫ  LATIN-SMALL-L-MIDDLE-TILDE = OVR(l, tilde) cp:U+026B script:Latn

# ɬ - Latin Small Letter L with Belt
ɬ  LATIN-SMALL-L-BELT = OVR(l, stroke.horiz) cp:U+026C script:Latn

# ɭ - Latin Small Letter L with Retroflex Hook
ɭ  LATIN-SMALL-L-RETROFLEX-HOOK = FRAME(l, hook.bot.right) cp:U+026D script:Latn

# ɮ - Latin Small Letter Lezh
ɮ  LATIN-SMALL-LEZH = FRAME(l, ezh.ipa) cp:U+026E script:Latn

# ɯ - Latin Small Letter Turned M
ɯ  LATIN-SMALL-TURNED-M = turned.m cp:U+026F script:Latn

# =============================================================================
# CHARACTERS U+0270-027F
# =============================================================================

# ɰ - Latin Small Letter Turned M with Long Leg
ɰ  LATIN-SMALL-TURNED-M-LONG-LEG = FRAME(turned.m, descender.r) cp:U+0270 script:Latn

# ɱ - Latin Small Letter M with Hook
ɱ  LATIN-SMALL-M-HOOK = FRAME(m, hook.bot) cp:U+0271 script:Latn

# ɲ - Latin Small Letter N with Left Hook
ɲ  LATIN-SMALL-N-LEFT-HOOK = FRAME(n, hook.top) cp:U+0272 script:Latn

# ɳ - Latin Small Letter N with Retroflex Hook
ɳ  LATIN-SMALL-N-RETROFLEX-HOOK = FRAME(n, hook.bot.right) cp:U+0273 script:Latn

# ɴ - Latin Letter Small Capital N
ɴ  LATIN-LETTER-SMALL-CAPITAL-N = sc(N, sx=9, sy=6) cp:U+0274 script:Latn

# ɵ - Latin Small Letter Barred O
ɵ  LATIN-SMALL-BARRED-O = OVR(o, stroke.horiz) cp:U+0275 script:Latn

# ɶ - Latin Letter Small Capital OE
ɶ  LATIN-LETTER-SMALL-CAPITAL-OE = sc(LR(O, E, 6/6), sx=9, sy=6) cp:U+0276 script:Latn

# ɷ - Latin Small Letter Closed Omega
ɷ  LATIN-SMALL-CLOSED-OMEGA = sc(bowl.full, sx=11, sy=10) cp:U+0277 script:Latn

# ɸ - Latin Small Letter Phi
ɸ  LATIN-SMALL-PHI = FRAME(bowl.full, stem) cp:U+0278 script:Latn

# ɹ - Latin Small Letter Turned R
ɹ  LATIN-SMALL-TURNED-R = turned.r cp:U+0279 script:Latn

# ɺ - Latin Small Letter Turned R with Long Leg
ɺ  LATIN-SMALL-TURNED-R-LONG-LEG = FRAME(turned.r, descender.r) cp:U+027A script:Latn

# ɻ - Latin Small Letter Turned R with Hook
ɻ  LATIN-SMALL-TURNED-R-HOOK = FRAME(turned.r, hook.bot.right) cp:U+027B script:Latn

# ɼ - Latin Small Letter R with Long Leg
ɼ  LATIN-SMALL-R-LONG-LEG = FRAME(r, descender) cp:U+027C script:Latn

# ɽ - Latin Small Letter R with Tail
ɽ  LATIN-SMALL-R-TAIL = FRAME(r, hook.bot.right) cp:U+027D script:Latn

# ɾ - Latin Small Letter R with Fishhook
ɾ  LATIN-SMALL-R-FISHHOOK = FRAME(stem, ear) cp:U+027E script:Latn

# ɿ - Latin Small Letter Reversed R with Fishhook
ɿ  LATIN-SMALL-REVERSED-R-FISHHOOK = sc(FRAME(stem, ear), sx=-12, sy=12) cp:U+027F script:Latn

# =============================================================================
# CHARACTERS U+0280-028F
# =============================================================================

# ʀ - Latin Letter Small Capital R
ʀ  LATIN-LETTER-SMALL-CAPITAL-R = sc(R, sx=9, sy=6) cp:U+0280 script:Latn

# ʁ - Latin Letter Small Capital Inverted R
ʁ  LATIN-LETTER-SMALL-CAPITAL-INVERTED-R = small.cap.r.inverted cp:U+0281 script:Latn

# ʂ - Latin Small Letter S with Hook
