path: p1 p2 p3 p4
p1 = [6,4]
p2 = [6,7]
p3 = [4,7]
p4 = [8,7]
close: false
width: 1
anchors: top=[6,4] base=[6,7]
@end

# mod.tack.down - Down tack modifier
@elem mod.tack.down
zone: x-height
path: p1 p2 p3 p4
p1 = [6,8]
p2 = [6,5]
p3 = [4,5]
p4 = [8,5]
close: false
width: 1
anchors: top=[6,5] base=[6,8]
@end

