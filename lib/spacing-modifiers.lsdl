zone: x-height
path: p1 p2 p3
p1 = [4,4]
p2 = C([4,7] [7,7])
p3 = C([9,6] [9,5])
close: false
width: 1
anchors: top=[4,4] base=[9,5]
@end

# mod.cross - Cross accent (plus sign shaped)
@elem mod.cross
zone: x-height
path: p1 p2 p3 p4
p1 = [6,3]
p2 = [6,7]
p3 = [4,5]
p4 = [8,5]
close: false
width: 1
anchors: mid=[6,5]
@end

# mod.prime - Prime mark (short diagonal)
@elem mod.prime
zone: x-height
path: p1 p2
p1 = [5,3]
p2 = [7,7]
close: false
width: 1
anchors: top=[5,3] base=[7,7]
@end

# mod.double.prime - Double prime mark
@elem mod.double.prime
zone: x-height
path: p1 p2 p3 p4
p1 = [3,3]
p2 = [5,7]
p3 = [6,3]
p4 = [8,7]
close: false
width: 1
anchors: mid=[5,5]
@end

