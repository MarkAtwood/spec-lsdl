@lsdl 1.0

# =============================================================================
# LSDL Spacing Modifier Letters Library
# =============================================================================
#
# This file defines characters from the Unicode Spacing Modifier Letters block
# (U+02B0-02FF). These are spacing characters used as phonetic modifiers and
# diacritical marks in various writing systems.
#
# Character count: 80
#
# Categories:
#   - Superscript letter forms (U+02B0-02B8, U+02E0-02E4): scaled Latin letters
#   - Prime marks and apostrophes (U+02B9-02BF): vertical/curved strokes
#   - Glottal stops (U+02C0-02C1): question-mark-like forms
#   - Arrowhead modifiers (U+02C2-02C5, U+02EF-02F2): triangular points
#   - Spacing diacritical marks (U+02C6-02C7, U+02D8-02DD): accent shapes
#   - IPA stress/length marks (U+02C8-02D1): vertical lines and colons
#   - Phonetic modifiers (U+02D2-02D7, U+02DE-02DF): various shapes
#   - Tone letters (U+02E5-02E9): horizontal bars at different heights
#   - Yin/Yang tone marks (U+02EA-02EE): angled strokes
#   - Low modifiers (U+02EF-02FF): positioned below baseline
#
# Approach:
#   - Superscript letters: use sc() to scale base letters to ~65% (sx=8, sy=8)
#   - Stress marks: simple vertical lines at different vertical positions
#   - Tone bars: horizontal bars positioned at 5 different heights
#   - Arrowheads: small triangular forms
#
# =============================================================================

# =============================================================================
# LOCAL ELEMENTS FOR SPACING MODIFIERS
# =============================================================================

# -----------------------------------------------------------------------------
# Base letter elements (for superscript forms)
# -----------------------------------------------------------------------------

# curve.s - Lowercase s: single continuous S-curve (copied from basic-latin.lsdl)
@elem curve.s
zone: x-height
path: p1 p2 p3
p1 = [9,2]
p2 = C([9,0] [2,0] [2,4])
p3 = C([2,8] [9,8] [9,6])
close: false
width: 1
anchors: attach=[5,4] mark-above=[5,0] mark-below=[5,9]
@end

# -----------------------------------------------------------------------------
# Vertical line elements for stress marks
# -----------------------------------------------------------------------------

# mod.vert.high - High vertical line (primary stress mark)
@elem mod.vert.high
zone: x-height
path: p1 p2
p1 = [6,2]
p2 = [6,5]
close: false
width: 1
anchors: top=[6,2] base=[6,5] mid=[6,3]
@end

# mod.vert.low - Low vertical line (secondary stress mark)
@elem mod.vert.low
zone: x-height
path: p1 p2
p1 = [6,6]
p2 = [6,9]
close: false
width: 1
anchors: top=[6,6] base=[6,9] mid=[6,7]
@end

# -----------------------------------------------------------------------------
# Tone bar elements (5 heights for IPA tone notation)
# -----------------------------------------------------------------------------

# mod.tone.extra.high - Extra-high tone bar (position 5, highest)
@elem mod.tone.extra.high
zone: x-height
path: p1 p2
p1 = [4,2]
p2 = [8,2]
close: false
width: 1
anchors: left=[4,2] right=[8,2] mid=[6,2]
@end

# mod.tone.high - High tone bar (position 4)
@elem mod.tone.high
zone: x-height
path: p1 p2
p1 = [4,3]
p2 = [8,3]
close: false
width: 1
anchors: left=[4,3] right=[8,3] mid=[6,3]
@end

# mod.tone.mid - Mid tone bar (position 3)
@elem mod.tone.mid
zone: x-height
path: p1 p2
p1 = [4,5]
p2 = [8,5]
close: false
width: 1
anchors: left=[4,5] right=[8,5] mid=[6,5]
@end

# mod.tone.low - Low tone bar (position 2)
@elem mod.tone.low
zone: x-height
path: p1 p2
p1 = [4,7]
p2 = [8,7]
close: false
width: 1
anchors: left=[4,7] right=[8,7] mid=[6,7]
@end

# mod.tone.extra.low - Extra-low tone bar (position 1, lowest)
@elem mod.tone.extra.low
zone: x-height
path: p1 p2
p1 = [4,8]
p2 = [8,8]
close: false
width: 1
anchors: left=[4,8] right=[8,8] mid=[6,8]
@end

# mod.tone.stem - Vertical stem for tone bars
@elem mod.tone.stem
zone: x-height
path: p1 p2
p1 = [4,2]
p2 = [4,8]
close: false
width: 1
anchors: top=[4,2] base=[4,8]
@end

# -----------------------------------------------------------------------------
# Triangle/arrow elements
# -----------------------------------------------------------------------------

# mod.triangle.left - Left-pointing triangle
@elem mod.triangle.left
zone: x-height
path: p1 p2 p3
p1 = [4,4]
p2 = [8,6]
p3 = [4,8]
close: true
width: 1
anchors: left=[4,6] right=[8,6]
@end

# mod.triangle.right - Right-pointing triangle
@elem mod.triangle.right
zone: x-height
path: p1 p2 p3
p1 = [8,4]
p2 = [4,6]
p3 = [8,8]
close: true
width: 1
anchors: left=[4,6] right=[8,6]
@end

# mod.triangle.up - Up-pointing triangle
@elem mod.triangle.up
zone: x-height
path: p1 p2 p3
p1 = [6,3]
p2 = [3,7]
p3 = [9,7]
close: true
width: 1
anchors: top=[6,3] base=[6,7]
@end

# mod.triangle.down - Down-pointing triangle
@elem mod.triangle.down
zone: x-height
path: p1 p2 p3
p1 = [6,8]
p2 = [3,4]
p3 = [9,4]
close: true
width: 1
anchors: top=[6,4] base=[6,8]
@end

# -----------------------------------------------------------------------------
# Triangular colon elements (for length marks)
# -----------------------------------------------------------------------------

# mod.tri.upper - Upper triangular point
@elem mod.tri.upper
zone: x-height
path: p1 p2 p3
p1 = [6,3]
p2 = [4,5]
p3 = [8,5]
close: true
width: 1
anchors: top=[6,3] base=[6,5]
@end

# mod.tri.lower - Lower triangular point
@elem mod.tri.lower
zone: x-height
path: p1 p2 p3
p1 = [4,6]
p2 = [8,6]
p3 = [6,8]
close: true
width: 1
anchors: top=[6,6] base=[6,8]
@end

# -----------------------------------------------------------------------------
# Half-ring and apostrophe elements
# -----------------------------------------------------------------------------

# mod.halfring.right - Right half ring (opening to left)
@elem mod.halfring.right
zone: x-height
path: p1 p2 p3
p1 = [7,3]
p2 = C([9,5] [9,7])
p3 = [7,8]
close: false
width: 1
anchors: top=[7,3] base=[7,8] mid=[8,5]
@end

# mod.halfring.left - Left half ring (opening to right)
@elem mod.halfring.left
zone: x-height
path: p1 p2 p3
p1 = [5,3]
p2 = C([3,5] [3,7])
p3 = [5,8]
close: false
width: 1
anchors: top=[5,3] base=[5,8] mid=[4,5]
@end

# mod.comma.turned - Turned comma shape
@elem mod.comma.turned
zone: x-height
path: p1 p2 p3
p1 = [7,3]
p2 = C([5,4] [5,5])
p3 = [6,6]
close: false
width: 1
anchors: top=[7,3] base=[6,6]
@end

# mod.comma.reversed - Reversed comma shape
@elem mod.comma.reversed
zone: x-height
path: p1 p2 p3
p1 = [5,3]
p2 = C([7,4] [7,5])
p3 = [6,6]
close: false
width: 1
anchors: top=[5,3] base=[6,6]
@end

# mod.apostrophe - Apostrophe shape (comma-like above)
@elem mod.apostrophe
zone: x-height
path: p1 p2 p3
p1 = [6,3]
p2 = C([7,4] [6,5])
p3 = [5,6]
close: false
width: 1
anchors: top=[6,3] base=[5,6]
@end

# -----------------------------------------------------------------------------
# Glottal stop elements
# -----------------------------------------------------------------------------

# mod.glottal - Glottal stop (like small question mark without dot)
@elem mod.glottal
zone: x-height
path: p1 p2 p3 p4
p1 = [4,3]
p2 = C([4,2] [8,2])
p3 = C([8,4] [6,5])
p4 = [6,7]
close: false
width: 1
anchors: top=[6,2] base=[6,7]
@end

# mod.glottal.reversed - Reversed glottal stop
@elem mod.glottal.reversed
zone: x-height
path: p1 p2 p3 p4
p1 = [8,3]
p2 = C([8,2] [4,2])
p3 = C([4,4] [6,5])
p4 = [6,7]
close: false
width: 1
anchors: top=[6,2] base=[6,7]
@end

# -----------------------------------------------------------------------------
# Accent elements (spacing versions)
# -----------------------------------------------------------------------------

# mod.circumflex - Circumflex accent
@elem mod.circumflex
zone: x-height
path: p1 p2 p3
p1 = [3,6]
p2 = [6,3]
p3 = [9,6]
close: false
width: 1
anchors: top=[6,3] base=[6,6]
@end

# mod.caron - Caron/hacek
@elem mod.caron
zone: x-height
path: p1 p2 p3
p1 = [3,3]
p2 = [6,6]
p3 = [9,3]
close: false
width: 1
anchors: top=[6,3] base=[6,6]
@end

# mod.macron - Macron bar
@elem mod.macron
zone: x-height
path: p1 p2
p1 = [3,4]
p2 = [9,4]
close: false
width: 1
anchors: left=[3,4] right=[9,4] mid=[6,4]
@end

# mod.macron.low - Low macron bar
@elem mod.macron.low
zone: x-height
path: p1 p2
p1 = [3,8]
p2 = [9,8]
close: false
width: 1
anchors: left=[3,8] right=[9,8] mid=[6,8]
@end

# mod.acute - Acute accent
@elem mod.acute
zone: x-height
path: p1 p2
p1 = [4,5]
p2 = [8,2]
close: false
width: 1
anchors: top=[8,2] base=[4,5]
@end

# mod.grave - Grave accent
