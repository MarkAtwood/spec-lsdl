zone: x-height
path: p1 p2
p1 = [4,2]
p2 = [8,5]
close: false
width: 1
anchors: top=[4,2] base=[8,5]
@end

# mod.breve - Breve (curved)
@elem mod.breve
zone: x-height
path: p1 p2 p3
p1 = [3,3]
p2 = C([6,6] [9,3])
p3 = [9,3]
close: false
width: 1
anchors: top=[6,3] base=[6,6]
@end

# mod.dot.above - Dot above (single centered dot)
@elem mod.dot.above
zone: x-height
path: p1 p2 p3 p4
p1 = [6,3]
p2 = C([5,3] [5,4])
p3 = C([5,5] [6,5])
p4 = C([7,5] [7,4])
close: true
width: 1
anchors: attach=[6,4]
@end

# mod.ring.above - Ring above (small circle)
@elem mod.ring.above
zone: x-height
path: p1 p2 p3 p4 p5
p1 = [6,2]
p2 = C([4,2] [4,4])
p3 = C([4,6] [6,6])
p4 = C([8,6] [8,4])
p5 = C([8,2] [6,2])
close: true
width: 1
anchors: attach=[6,4]
@end

# mod.ogonek - Ogonek (small hook below)
@elem mod.ogonek
zone: x-height
path: p1 p2 p3
p1 = [6,8]
p2 = C([4,9] [4,10])
p3 = [6,10]
close: false
width: 1
anchors: attach=[6,8] base=[5,10]
@end

# mod.tilde - Small tilde
@elem mod.tilde
zone: x-height
