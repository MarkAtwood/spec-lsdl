# =============================================================================
# SPECIAL CHARACTERS (non-DIA compositions)
# =============================================================================
#
# These characters cannot be expressed as simple DIA compositions.
# They include unique letterforms, compatibility characters, and
# ligature-derived forms.
#
# =============================================================================

# -----------------------------------------------------------------------------
# A with right half ring (compatibility character)
# U+1E9A - Originally a ligature of a + modifier letter right half ring
# -----------------------------------------------------------------------------
ẚ LATIN-SMALL-LETTER-A-WITH-RIGHT-HALF-RING = DIA(a, right-half-ring-above) cp:U+1E9A script:Latn

# -----------------------------------------------------------------------------
# Long S variants (historical/paleographic)
# U+1E9C/1E9D - Used in historical texts
# -----------------------------------------------------------------------------
ẜ LATIN-SMALL-LETTER-LONG-S-WITH-DIAGONAL-STROKE = OVR(ſ, stroke.diag) cp:U+1E9C script:Latn

ẝ LATIN-SMALL-LETTER-LONG-S-WITH-HIGH-STROKE = OVR(ſ, stroke.high) cp:U+1E9D script:Latn

# -----------------------------------------------------------------------------
# Capital sharp S (Eszett)
# U+1E9E - Official uppercase of German ß since 2017
# -----------------------------------------------------------------------------
ẞ LATIN-CAPITAL-LETTER-SHARP-S = FRAME(bowl.upper.cap, crossbar, bowl.lower.cap) cp:U+1E9E script:Latn ortho:Deu

# -----------------------------------------------------------------------------
# Latin small letter delta
# U+1E9F - Used in transliteration, distinct from Greek delta
# -----------------------------------------------------------------------------
ẟ LATIN-SMALL-LETTER-DELTA = FRAME(loop.upper, stem.curved) cp:U+1E9F script:Latn

# -----------------------------------------------------------------------------
# Middle-Welsh letters
# U+1EFA-1EFD - Historical Welsh orthography
# -----------------------------------------------------------------------------
Ỻ LATIN-CAPITAL-LETTER-MIDDLE-WELSH-LL = LIG(L, L) cp:U+1EFA script:Latn ortho:Cym

ỻ LATIN-SMALL-LETTER-MIDDLE-WELSH-LL = LIG(l, l) cp:U+1EFB script:Latn ortho:Cym

Ỽ LATIN-CAPITAL-LETTER-MIDDLE-WELSH-V = FRAME(diagonal.down, diagonal.up) cp:U+1EFC script:Latn ortho:Cym

ỽ LATIN-SMALL-LETTER-MIDDLE-WELSH-V = FRAME(diagonal.down, diagonal.up) cp:U+1EFD script:Latn ortho:Cym

# -----------------------------------------------------------------------------
# Y with loop
# U+1EFE/1EFF - Used in Americanist phonetic notation
# -----------------------------------------------------------------------------
Ỿ LATIN-CAPITAL-LETTER-Y-WITH-LOOP = FRAME(diagonal.down, diagonal.up, loop.lower) cp:U+1EFE script:Latn

ỿ LATIN-SMALL-LETTER-Y-WITH-LOOP = FRAME(diagonal.down, diagonal.up, loop.descender) cp:U+1EFF script:Latn

