@lsdl 1.0

# =============================================================================
# LSDL Latin Extended Additional Character Library (U+1E00-U+1EFF)
# =============================================================================
#
# This file defines characters from the Latin Extended Additional Unicode block.
# This block contains 256 code points, primarily used for:
#   - Vietnamese vowels with tone marks (majority of characters)
#   - Welsh W and Y with accents
#   - Letters with dot below (Indian language transliteration)
#   - Various multi-diacritic combinations
#
# All characters are composed using DIA (Diacritic Attachment) operator with
# base characters and diacritics from the corresponding LSDL libraries.
#
# Organization: grouped by base letter (A through Z)
#
# Dependencies:
#   - basic-latin.lsdl (A-Z, a-z)
#   - latin-extended-b.lsdl (O-horn, U-horn for Vietnamese)
#   - diacritics.lsdl (combining marks)
#
# Language codes (ISO 639-3):
#   Vie = Vietnamese, Cym = Welsh, San = Sanskrit (transliteration)
#
# =============================================================================

# =============================================================================
# A + DIACRITICS
# =============================================================================

Ḁ LATIN-CAPITAL-LETTER-A-WITH-RING-BELOW = DIA(A, ring-below) cp:U+1E00 script:Latn

ḁ LATIN-SMALL-LETTER-A-WITH-RING-BELOW = DIA(a, ring-below) cp:U+1E01 script:Latn

Ạ LATIN-CAPITAL-LETTER-A-WITH-DOT-BELOW = DIA(A, dot-below) cp:U+1EA0 script:Latn ortho:San

ạ LATIN-SMALL-LETTER-A-WITH-DOT-BELOW = DIA(a, dot-below) cp:U+1EA1 script:Latn ortho:San

Ả LATIN-CAPITAL-LETTER-A-WITH-HOOK-ABOVE = DIA(A, hook-above) cp:U+1EA2 script:Latn ortho:Vie

ả LATIN-SMALL-LETTER-A-WITH-HOOK-ABOVE = DIA(a, hook-above) cp:U+1EA3 script:Latn ortho:Vie

Ấ LATIN-CAPITAL-LETTER-A-WITH-CIRCUMFLEX-AND-ACUTE = DIA(Â, acute) cp:U+1EA4 script:Latn

ấ LATIN-SMALL-LETTER-A-WITH-CIRCUMFLEX-AND-ACUTE = DIA(â, acute) cp:U+1EA5 script:Latn

Ầ LATIN-CAPITAL-LETTER-A-WITH-CIRCUMFLEX-AND-GRAVE = DIA(Â, grave) cp:U+1EA6 script:Latn

ầ LATIN-SMALL-LETTER-A-WITH-CIRCUMFLEX-AND-GRAVE = DIA(â, grave) cp:U+1EA7 script:Latn

Ẩ LATIN-CAPITAL-LETTER-A-WITH-CIRCUMFLEX-AND-HOOK-ABOVE = DIA(Â, hook-above) cp:U+1EA8 script:Latn ortho:Vie

ẩ LATIN-SMALL-LETTER-A-WITH-CIRCUMFLEX-AND-HOOK-ABOVE = DIA(â, hook-above) cp:U+1EA9 script:Latn ortho:Vie

Ẫ LATIN-CAPITAL-LETTER-A-WITH-CIRCUMFLEX-AND-TILDE = DIA(Â, tilde) cp:U+1EAA script:Latn

ẫ LATIN-SMALL-LETTER-A-WITH-CIRCUMFLEX-AND-TILDE = DIA(â, tilde) cp:U+1EAB script:Latn

Ậ LATIN-CAPITAL-LETTER-A-WITH-CIRCUMFLEX-AND-DOT-BELOW = DIA(Ạ, circumflex) cp:U+1EAC script:Latn ortho:San

ậ LATIN-SMALL-LETTER-A-WITH-CIRCUMFLEX-AND-DOT-BELOW = DIA(ạ, circumflex) cp:U+1EAD script:Latn ortho:San

Ắ LATIN-CAPITAL-LETTER-A-WITH-BREVE-AND-ACUTE = DIA(DIA(A, breve), acute) cp:U+1EAE script:Latn ortho:Vie

ắ LATIN-SMALL-LETTER-A-WITH-BREVE-AND-ACUTE = DIA(DIA(a, breve), acute) cp:U+1EAF script:Latn ortho:Vie

Ằ LATIN-CAPITAL-LETTER-A-WITH-BREVE-AND-GRAVE = DIA(DIA(A, breve), grave) cp:U+1EB0 script:Latn ortho:Vie

ằ LATIN-SMALL-LETTER-A-WITH-BREVE-AND-GRAVE = DIA(DIA(a, breve), grave) cp:U+1EB1 script:Latn ortho:Vie

Ẳ LATIN-CAPITAL-LETTER-A-WITH-BREVE-AND-HOOK-ABOVE = DIA(DIA(A, breve), hook-above) cp:U+1EB2 script:Latn ortho:Vie

ẳ LATIN-SMALL-LETTER-A-WITH-BREVE-AND-HOOK-ABOVE = DIA(DIA(a, breve), hook-above) cp:U+1EB3 script:Latn ortho:Vie

Ẵ LATIN-CAPITAL-LETTER-A-WITH-BREVE-AND-TILDE = DIA(DIA(A, breve), tilde) cp:U+1EB4 script:Latn ortho:Vie

ẵ LATIN-SMALL-LETTER-A-WITH-BREVE-AND-TILDE = DIA(DIA(a, breve), tilde) cp:U+1EB5 script:Latn ortho:Vie

Ặ LATIN-CAPITAL-LETTER-A-WITH-BREVE-AND-DOT-BELOW = DIA(Ạ, breve) cp:U+1EB6 script:Latn ortho:Vie

ặ LATIN-SMALL-LETTER-A-WITH-BREVE-AND-DOT-BELOW = DIA(ạ, breve) cp:U+1EB7 script:Latn ortho:Vie

