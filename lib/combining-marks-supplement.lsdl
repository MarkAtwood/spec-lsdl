p2 = [4,0]
p3 = [6,2]
p4 = [8,0]
p5 = [9,2]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# latin-small-letter-r-below - Small letter r below
# Unicode: U+1DCA COMBINING LATIN SMALL LETTER R BELOW
# -----------------------------------------------------------------------------
@elem latin-small-letter-r-below
zone: diacritic-below
path: p1 p2 p3
p1 = [5,11]
p2 = [5,9]
p3 = C([5,9] [7,9])
close: false
width: 1
anchors: attach=[6,8]
@end

# -----------------------------------------------------------------------------
# breve-macron - Breve combined with macron
# Unicode: U+1DCB COMBINING BREVE-MACRON
