p2 = [4,9]
p3 = [6,11]
p4 = [8,9]
p5 = [9,10]
close: false
width: 1
anchors: attach=[6,8]
@end

# -----------------------------------------------------------------------------
# is-below - IS abbreviation mark below
# Unicode: U+1DD0 COMBINING IS BELOW
# Medieval ligature abbreviation
