@lsdl 1.0

# =============================================================================
# LSDL Combining Diacritical Marks Supplement Library
# =============================================================================
#
# Complete coverage of Unicode block U+1DC0-1DFF (64 combining marks).
#
# Categories:
#   - Dotted accent marks: dots combined with accents (grave, acute)
#   - Compound tone marks: acute/grave/macron combinations
#   - Ligature marks: medieval manuscript abbreviations
#   - Phonetic modifier marks: IPA and phonetic notation
#   - Superscript letters: small letter forms used as diacritics
#
# Zone assignments:
#   diacritic-above: y=0 to y=2 (above cap-height)
#   diacritic-below: y=8 to y=11 (below baseline into descender)
#   x-height: y=4 to y=8 (for through-marks, centered on base)
#
# All diacritics MUST define an `attach` anchor per Section 15.2.
#
# =============================================================================

# =============================================================================
# DOTTED ACCENT MARKS
# =============================================================================

# -----------------------------------------------------------------------------
# dotted-grave - Grave accent with dot above
# Unicode: U+1DC0 COMBINING DOTTED GRAVE ACCENT
# -----------------------------------------------------------------------------
@elem dotted-grave
zone: diacritic-above
path: p1 p2 p3
p1 = [7,2]
p2 = [5,1]
p3 = [6,0]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# dotted-acute - Acute accent with dot above
# Unicode: U+1DC1 COMBINING DOTTED ACUTE ACCENT
# -----------------------------------------------------------------------------
@elem dotted-acute
zone: diacritic-above
path: p1 p2 p3
p1 = [5,2]
p2 = [7,1]
p3 = [6,0]
close: false
width: 1
anchors: attach=[6,2]
@end

# =============================================================================
# BELOW MARKS
# =============================================================================

# -----------------------------------------------------------------------------
# snake-below - Snake-like wavy line below
# Unicode: U+1DC2 COMBINING SNAKE BELOW
# -----------------------------------------------------------------------------
@elem snake-below
zone: diacritic-below
path: p1 p2 p3 p4 p5
p1 = [3,10]
p2 = C([4,9] [5,10])
p3 = C([6,11] [7,10])
p4 = C([8,9] [9,10])
p5 = [9,10]
close: false
width: 1
anchors: attach=[6,8]
@end

# =============================================================================
# ABOVE MARKS - SUSPENSION AND COMPOUND
# =============================================================================

# -----------------------------------------------------------------------------
# suspension-mark - Medieval suspension mark
# Unicode: U+1DC3 COMBINING SUSPENSION MARK
# Used in medieval manuscripts for abbreviations
# -----------------------------------------------------------------------------
@elem suspension-mark
zone: diacritic-above
path: p1 p2 p3
p1 = [5,1]
p2 = C([5,0] [6,0])
p3 = C([7,0] [7,1])
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# macron-acute - Macron combined with acute
# Unicode: U+1DC4 COMBINING MACRON-ACUTE
# -----------------------------------------------------------------------------
@elem macron-acute
zone: diacritic-above
path: p1 p2 p3 p4
p1 = [4,2]
p2 = [8,2]
p3 = [6,2]
p4 = [8,0]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# grave-macron - Grave followed by macron
# Unicode: U+1DC5 COMBINING GRAVE-MACRON
# -----------------------------------------------------------------------------
@elem grave-macron
zone: diacritic-above
path: p1 p2 p3 p4
p1 = [5,0]
p2 = [3,2]
p3 = [4,2]
p4 = [8,2]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# macron-grave - Macron followed by grave
# Unicode: U+1DC6 COMBINING MACRON-GRAVE
# -----------------------------------------------------------------------------
@elem macron-grave
zone: diacritic-above
path: p1 p2 p3 p4
p1 = [4,2]
p2 = [8,2]
p3 = [9,2]
p4 = [7,0]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# acute-macron - Acute followed by macron
# Unicode: U+1DC7 COMBINING ACUTE-MACRON
# -----------------------------------------------------------------------------
@elem acute-macron
zone: diacritic-above
path: p1 p2 p3 p4
p1 = [3,2]
p2 = [5,0]
p3 = [4,2]
p4 = [8,2]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# grave-acute-grave - Triple tone mark (grave-acute-grave)
# Unicode: U+1DC8 COMBINING GRAVE-ACUTE-GRAVE
# -----------------------------------------------------------------------------
@elem grave-acute-grave
zone: diacritic-above
path: p1 p2 p3 p4 p5
p1 = [4,0]
p2 = [3,2]
p3 = [6,0]
p4 = [9,2]
p5 = [8,0]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# acute-grave-acute - Triple tone mark (acute-grave-acute)
# Unicode: U+1DC9 COMBINING ACUTE-GRAVE-ACUTE
