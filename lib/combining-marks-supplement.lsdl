path: p1 p2 p3 p4 p5
p1 = [3,0]
p2 = C([3,1] [4,1])
p3 = C([5,1] [5,0])
p4 = [6,2]
p5 = [9,2]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# macron-breve - Macron combined with breve
# Unicode: U+1DCC COMBINING MACRON-BREVE
# -----------------------------------------------------------------------------
@elem macron-breve
zone: diacritic-above
path: p1 p2 p3 p4 p5
p1 = [3,2]
p2 = [6,2]
p3 = [7,0]
p4 = C([7,1] [8,1])
p5 = C([9,1] [9,0])
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# double-circumflex-above - Double circumflex (two peaks)
