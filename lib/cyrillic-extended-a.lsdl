@lsdl 1.0

# =============================================================================
# LSDL Cyrillic Extended-A Library (U+2DE0-U+2DFF)
# =============================================================================
#
# Complete coverage of Unicode block Cyrillic Extended-A (32 combining marks).
# These are superscript (combining) versions of Cyrillic letters used in
# Church Slavonic texts for abbreviation marks.
#
# All characters:
#   - Use zone: diacritic-above (positioned above base characters)
#   - Have attach anchor at [6,2] for mark attachment
#   - Are scaled-down versions of their base letter forms
#   - Tagged with script:Cyrl and ortho:OCS (Old Church Slavonic)
#
# =============================================================================

# =============================================================================
# COMBINING CYRILLIC LETTERS (U+2DE0-U+2DFF)
# =============================================================================

# -----------------------------------------------------------------------------
# combining-cyrillic-letter-be
# Unicode: U+2DE0 COMBINING CYRILLIC LETTER BE
# Superscript form of Cyrillic Б - horizontal bar with lower bowl
# -----------------------------------------------------------------------------
@elem combining-cyrillic-letter-be
zone: diacritic-above
path: p1 p2 p3 p4 p5
p1 = [4,0]
p2 = [7,0]
p3 = [4,0]
p4 = [4,2]
p5 = C([4,2] [7,2])
close: false
width: 1
anchors: attach=[6,2]
@end

ⷠ  COMBINING-CYRILLIC-LETTER-BE = combining-cyrillic-letter-be script:Cyrl ortho:OCS
  # Superscript Б used in Church Slavonic abbreviations

# -----------------------------------------------------------------------------
# combining-cyrillic-letter-ve
# Unicode: U+2DE1 COMBINING CYRILLIC LETTER VE
# Superscript form of Cyrillic В - stem with two stacked bowls
# -----------------------------------------------------------------------------
@elem combining-cyrillic-letter-ve
zone: diacritic-above
path: p1 p2 p3 p4 p5 p6
p1 = [4,0]
p2 = [4,2]
p3 = C([4,0] [7,0])
p4 = C([7,1] [4,1])
p5 = C([4,1] [7,1])
p6 = C([7,2] [4,2])
close: false
width: 1
anchors: attach=[6,2]
@end

ⷡ  COMBINING-CYRILLIC-LETTER-VE = combining-cyrillic-letter-ve script:Cyrl ortho:OCS
  # Superscript В used in Church Slavonic abbreviations

# -----------------------------------------------------------------------------
# combining-cyrillic-letter-ghe
# Unicode: U+2DE2 COMBINING CYRILLIC LETTER GHE
# Superscript form of Cyrillic Г - horizontal bar with descending stem
# -----------------------------------------------------------------------------
@elem combining-cyrillic-letter-ghe
zone: diacritic-above
path: p1 p2 p3
p1 = [4,0]
p2 = [8,0]
p3 = [4,0]
close: false
width: 1
anchors: attach=[6,2]
@end

ⷢ  COMBINING-CYRILLIC-LETTER-GHE = combining-cyrillic-letter-ghe script:Cyrl ortho:OCS
  # Superscript Г used in Church Slavonic abbreviations

# -----------------------------------------------------------------------------
