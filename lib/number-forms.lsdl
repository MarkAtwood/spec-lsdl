@lsdl 1.0

# =============================================================================
# LSDL Number Forms Library
# =============================================================================
#
# This file defines characters from the Number Forms Unicode block (U+2150-218F).
#
# Contents (~60 characters):
#   - Vulgar Fractions (U+2150-215F, U+2189): 17 characters
#   - Roman Numerals (U+2160-217F): 32 characters
#   - Latin-1 Fractions (U+00BC-00BE): 3 characters (for completeness)
#
# Note: Since U+2150-218F is outside the standard LITERAL_CHAR ranges,
# all character definitions use @char block form with cp: metadata.
# Placeholder characters from the ASCII range are used for the literal char.
#
# Fraction composition approach:
#   - Numerator: scaled digit positioned in upper portion
#   - Fraction slash: diagonal stroke
#   - Denominator: scaled digit positioned in lower portion
#   - Fractions use FRAME with scaled, shifted digit elements
#
# Roman numeral approach:
#   - Simple compositions using existing Latin letters
#   - Uppercase: I, V, X, L, C, D, M forms
#   - Lowercase: scaled/styled versions
#
# =============================================================================

# =============================================================================
# LOCAL FRACTION ELEMENTS
# =============================================================================

# frac.slash - Fraction slash (solidus) for vulgar fractions
@elem frac.slash
zone: cap
path: p1 p2
p1 = [9,1]
p2 = [3,8]
close: false
width: 1
anchors: top=[9,1] base=[3,8] mid=[6,4]
@end

# frac.slash.short - Shorter fraction slash for tight fractions
@elem frac.slash.short
zone: cap
path: p1 p2
p1 = [8,2]
p2 = [4,7]
close: false
width: 1
anchors: top=[8,2] base=[4,7] mid=[6,4]
@end

# =============================================================================
# FRACTION DIGIT ELEMENTS (scaled for fraction use)
# =============================================================================
# These are locally defined scaled versions of digit forms.
# They don't reference digits.lsdl elements since LSDL has no import mechanism.

# frac.digit.zero - Scaled oval for 0
@elem frac.digit.zero
zone: cap
path: p1 p2 p3 p4 p5
p1 = [4,1]
p2 = C([1,1] [1,3])
p3 = C([1,5] [4,5])
p4 = C([7,5] [7,3])
p5 = C([7,1] [4,1])
close: true
width: 1
anchors: top=[4,1] base=[4,5] mid=[4,3]
@end

# frac.digit.one - Scaled 1 (flag + stem)
@elem frac.digit.one
zone: cap
path: p1 p2 p3
p1 = [2,2]
p2 = [4,1]
p3 = [4,5]
close: false
width: 1
anchors: top=[4,1] base=[4,5] mid=[4,3]
@end

# frac.digit.two - Scaled 2 (arc + stem + bar)
@elem frac.digit.two
zone: cap
path: p1 p2 p3 p4 p5
p1 = [2,2]
p2 = C([2,1] [4,1])
p3 = C([6,1] [6,3])
p4 = [2,5]
p5 = [6,5]
close: false
width: 1
anchors: top=[4,1] base=[4,5] mid=[4,3]
@end

# frac.digit.three - Scaled 3 (two arcs)
@elem frac.digit.three
zone: cap
path: p1 p2 p3 p4 p5
p1 = [2,1]
p2 = C([4,1] [6,1] [6,3])
p3 = [4,3]
p4 = C([6,3] [6,5] [4,5])
p5 = [2,5]
close: false
width: 1
anchors: top=[4,1] base=[4,5] mid=[4,3]
@end

# frac.digit.four - Scaled 4 (stem + diagonal + crossbar)
@elem frac.digit.four
zone: cap
path: p1 p2 p3 p4 p5
p1 = [5,1]
p2 = [5,5]
p3 = [5,3]
p4 = [1,3]
p5 = [1,1]
close: false
width: 1
anchors: top=[5,1] base=[5,5] mid=[5,3]
@end

# frac.digit.five - Scaled 5 (top bar + stem + bottom arc)
@elem frac.digit.five
zone: cap
path: p1 p2 p3 p4 p5
p1 = [6,1]
p2 = [2,1]
p3 = [2,3]
p4 = C([4,3] [6,4])
p5 = C([6,5] [2,5])
close: false
width: 1
anchors: top=[4,1] base=[4,5] mid=[4,3]
@end

# frac.digit.six - Scaled 6 (curved form)
@elem frac.digit.six
zone: cap
path: p1 p2 p3 p4
p1 = [6,1]
p2 = C([2,1] [2,3])
p3 = C([2,5] [6,5])
p4 = C([6,3] [4,3] [2,4])
close: false
width: 1
anchors: top=[4,1] base=[4,5] mid=[4,3]
@end

# frac.digit.seven - Scaled 7 (top bar + diagonal)
@elem frac.digit.seven
zone: cap
path: p1 p2 p3
p1 = [2,1]
p2 = [6,1]
p3 = [3,5]
close: false
width: 1
anchors: top=[4,1] base=[3,5] mid=[4,3]
@end

# frac.digit.eight - Scaled 8 (two bowls)
@elem frac.digit.eight
zone: cap
path: p1 p2 p3 p4 p5 p6 p7 p8
p1 = [4,1]
p2 = C([2,1] [2,2])
p3 = C([2,3] [4,3])
p4 = C([6,3] [6,2])
p5 = C([6,1] [4,1])
p6 = C([2,3] [2,4])
p7 = C([2,5] [4,5])
p8 = C([6,5] [6,4] [6,3])
close: false
width: 1
anchors: top=[4,1] base=[4,5] mid=[4,3]
@end

# frac.digit.nine - Scaled 9 (bowl with descending tail)
@elem frac.digit.nine
zone: cap
path: p1 p2 p3 p4
p1 = [2,5]
p2 = C([6,5] [6,3])
p3 = C([6,1] [2,1])
p4 = C([2,3] [4,3] [6,2])
close: false
width: 1
anchors: top=[4,1] base=[4,5] mid=[4,3]
@end

# =============================================================================
# ROMAN NUMERAL ELEMENTS
# =============================================================================
# Roman numerals use existing letter forms. The uppercase versions are
# distinct characters per Unicode; lowercase are small-cap styled.

# roman.one - Roman numeral I shape (vertical stem)
@elem roman.one
zone: cap
path: p1 p2
p1 = [6,0]
p2 = [6,8]
close: false
width: 1
anchors: top=[6,0] base=[6,8] mid=[6,4]
@end

# roman.five - Roman numeral V shape (vertex)
@elem roman.five
zone: cap
path: p1 p2 p3
p1 = [2,0]
p2 = [6,8]
p3 = [10,0]
close: false
width: 1
anchors: top-left=[2,0] top-right=[10,0] base=[6,8] mid=[6,4]
@end

# roman.ten - Roman numeral X shape (crossed diagonals)
@elem roman.ten
zone: cap
path: p1 p2
p1 = [2,0]
p2 = [10,8]
close: false
width: 1
anchors: top-left=[2,0] base-right=[10,8] mid=[6,4]
@end

# roman.ten.back - Back diagonal for X
@elem roman.ten.back
zone: cap
path: p1 p2
p1 = [10,0]
p2 = [2,8]
close: false
width: 1
anchors: top-right=[10,0] base-left=[2,8] mid=[6,4]
@end

# roman.fifty - Roman numeral L shape (stem with bottom arm)
@elem roman.fifty
zone: cap
path: p1 p2 p3
p1 = [2,0]
p2 = [2,8]
p3 = [10,8]
close: false
width: 1
anchors: top=[2,0] base=[6,8] mid=[2,4]
@end

# roman.hundred - Roman numeral C shape (open arc)
@elem roman.hundred
zone: cap
path: p1 p2 p3
p1 = [10,1]
p2 = C([10,0] [2,0] [2,4])
p3 = C([2,8] [10,8] [10,7])
close: false
width: 1
anchors: top=[6,0] base=[6,8] mid=[2,4]
@end

# roman.fivehundred - Roman numeral D shape (stem with right bowl)
@elem roman.fivehundred
zone: cap
path: p1 p2 p3 p4 p5
p1 = [2,0]
p2 = [2,8]
p3 = [2,0]
p4 = C([10,0] [10,4])
p5 = C([10,8] [2,8])
close: false
width: 1
anchors: top=[6,0] base=[6,8] mid=[6,4]
@end

# roman.thousand - Roman numeral M shape (two stems with apex)
@elem roman.thousand
zone: cap
path: p1 p2 p3 p4 p5
p1 = [2,8]
p2 = [2,0]
p3 = [6,5]
p4 = [10,0]
p5 = [10,8]
close: false
width: 1
anchors: top-left=[2,0] top-right=[10,0] base=[6,8] mid=[6,4]
@end

# =============================================================================
# SMALL ROMAN NUMERAL ELEMENTS (scaled for lowercase)
# =============================================================================

# small.roman.one - Small roman numeral i (scaled)
@elem small.roman.one
build: from_expr
sc(roman.one, sx=8, sy=8)
@end

# small.roman.five - Small roman numeral v (scaled)
@elem small.roman.five
build: from_expr
sc(roman.five, sx=8, sy=8)
@end

# small.roman.ten - Small roman numeral x (scaled)
@elem small.roman.ten
build: from_expr
OVR(sc(roman.ten, sx=8, sy=8), sc(roman.ten.back, sx=8, sy=8))
@end

# small.roman.fifty - Small roman numeral l (scaled)
@elem small.roman.fifty
build: from_expr
sc(roman.fifty, sx=8, sy=8)
@end

# small.roman.hundred - Small roman numeral c (scaled)
@elem small.roman.hundred
build: from_expr
sc(roman.hundred, sx=8, sy=8)
@end

# small.roman.fivehundred - Small roman numeral d (scaled)
@elem small.roman.fivehundred
build: from_expr
sc(roman.fivehundred, sx=8, sy=8)
@end

# small.roman.thousand - Small roman numeral m (scaled)
@elem small.roman.thousand
build: from_expr
sc(roman.thousand, sx=8, sy=8)
@end

# =============================================================================
# VULGAR FRACTIONS (U+2150-215F, U+2189)
# =============================================================================
# Fractions composed with scaled numerator, slash, scaled denominator

# U+2150 VULGAR FRACTION ONE SEVENTH
@char ! VULGAR-FRACTION-ONE-SEVENTH
build: from_expr
FRAME(sh(frac.digit.one, dx=-3, dy=-2), frac.slash, sh(frac.digit.seven, dx=3, dy=2))
cp: U+2150
@end

# U+2151 VULGAR FRACTION ONE NINTH
@char " VULGAR-FRACTION-ONE-NINTH
build: from_expr
FRAME(sh(frac.digit.one, dx=-3, dy=-2), frac.slash, sh(frac.digit.nine, dx=3, dy=2))
cp: U+2151
@end

# U+2152 VULGAR FRACTION ONE TENTH
@char $ VULGAR-FRACTION-ONE-TENTH
build: from_expr
FRAME(sh(frac.digit.one, dx=-4, dy=-2), frac.slash, sh(frac.digit.one, dx=1, dy=2), sh(frac.digit.zero, dx=5, dy=2))
cp: U+2152
@end

# U+2153 VULGAR FRACTION ONE THIRD
@char % VULGAR-FRACTION-ONE-THIRD
build: from_expr
FRAME(sh(frac.digit.one, dx=-3, dy=-2), frac.slash, sh(frac.digit.three, dx=3, dy=2))
cp: U+2153
@end

# U+2154 VULGAR FRACTION TWO THIRDS
@char & VULGAR-FRACTION-TWO-THIRDS
build: from_expr
FRAME(sh(frac.digit.two, dx=-3, dy=-2), frac.slash, sh(frac.digit.three, dx=3, dy=2))
cp: U+2154
@end

# U+2155 VULGAR FRACTION ONE FIFTH
@char ' VULGAR-FRACTION-ONE-FIFTH
build: from_expr
FRAME(sh(frac.digit.one, dx=-3, dy=-2), frac.slash, sh(frac.digit.five, dx=3, dy=2))
cp: U+2155
@end

# U+2156 VULGAR FRACTION TWO FIFTHS
@char + VULGAR-FRACTION-TWO-FIFTHS
build: from_expr
FRAME(sh(frac.digit.two, dx=-3, dy=-2), frac.slash, sh(frac.digit.five, dx=3, dy=2))
cp: U+2156
@end

# U+2157 VULGAR FRACTION THREE FIFTHS
@char - VULGAR-FRACTION-THREE-FIFTHS
build: from_expr
FRAME(sh(frac.digit.three, dx=-3, dy=-2), frac.slash, sh(frac.digit.five, dx=3, dy=2))
cp: U+2157
@end

# U+2158 VULGAR FRACTION FOUR FIFTHS
@char . VULGAR-FRACTION-FOUR-FIFTHS
build: from_expr
FRAME(sh(frac.digit.four, dx=-3, dy=-2), frac.slash, sh(frac.digit.five, dx=3, dy=2))
cp: U+2158
@end

# U+2159 VULGAR FRACTION ONE SIXTH
@char / VULGAR-FRACTION-ONE-SIXTH
build: from_expr
FRAME(sh(frac.digit.one, dx=-3, dy=-2), frac.slash, sh(frac.digit.six, dx=3, dy=2))
cp: U+2159
@end

# U+215A VULGAR FRACTION FIVE SIXTHS
@char 0 VULGAR-FRACTION-FIVE-SIXTHS
build: from_expr
FRAME(sh(frac.digit.five, dx=-3, dy=-2), frac.slash, sh(frac.digit.six, dx=3, dy=2))
cp: U+215A
@end

# U+215B VULGAR FRACTION ONE EIGHTH
@char 1 VULGAR-FRACTION-ONE-EIGHTH
build: from_expr
FRAME(sh(frac.digit.one, dx=-3, dy=-2), frac.slash, sh(frac.digit.eight, dx=3, dy=2))
cp: U+215B
@end

# U+215C VULGAR FRACTION THREE EIGHTHS
@char 2 VULGAR-FRACTION-THREE-EIGHTHS
build: from_expr
FRAME(sh(frac.digit.three, dx=-3, dy=-2), frac.slash, sh(frac.digit.eight, dx=3, dy=2))
cp: U+215C
@end

# U+215D VULGAR FRACTION FIVE EIGHTHS
@char 3 VULGAR-FRACTION-FIVE-EIGHTHS
build: from_expr
FRAME(sh(frac.digit.five, dx=-3, dy=-2), frac.slash, sh(frac.digit.eight, dx=3, dy=2))
cp: U+215D
@end

# U+215E VULGAR FRACTION SEVEN EIGHTHS
@char 4 VULGAR-FRACTION-SEVEN-EIGHTHS
build: from_expr
FRAME(sh(frac.digit.seven, dx=-3, dy=-2), frac.slash, sh(frac.digit.eight, dx=3, dy=2))
cp: U+215E
@end

# U+215F FRACTION NUMERATOR ONE
@char 5 FRACTION-NUMERATOR-ONE
build: from_expr
sh(frac.digit.one, dx=-3, dy=-2)
cp: U+215F
@end

# U+2189 VULGAR FRACTION ZERO THIRDS
@char 6 VULGAR-FRACTION-ZERO-THIRDS
build: from_expr
FRAME(sh(frac.digit.zero, dx=-3, dy=-2), frac.slash, sh(frac.digit.three, dx=3, dy=2))
cp: U+2189
@end

# =============================================================================
# LATIN-1 SUPPLEMENT FRACTIONS (for reference/completeness)
# =============================================================================
# Note: These are in Latin-1 Supplement (U+00BC-00BE), defined here
# for completeness of the fraction set.

# U+00BC VULGAR FRACTION ONE QUARTER
@char 7 VULGAR-FRACTION-ONE-QUARTER
build: from_expr
FRAME(sh(frac.digit.one, dx=-3, dy=-2), frac.slash, sh(frac.digit.four, dx=3, dy=2))
cp: U+00BC
@end

# U+00BD VULGAR FRACTION ONE HALF
@char 8 VULGAR-FRACTION-ONE-HALF
build: from_expr
FRAME(sh(frac.digit.one, dx=-3, dy=-2), frac.slash, sh(frac.digit.two, dx=3, dy=2))
cp: U+00BD
@end

# U+00BE VULGAR FRACTION THREE QUARTERS
@char 9 VULGAR-FRACTION-THREE-QUARTERS
build: from_expr
FRAME(sh(frac.digit.three, dx=-3, dy=-2), frac.slash, sh(frac.digit.four, dx=3, dy=2))
cp: U+00BE
@end

# =============================================================================
# ROMAN NUMERALS - UPPERCASE (U+2160-216F)
# =============================================================================
# Roman numerals I through XII in uppercase form, plus L, C, D, M

# U+2160 ROMAN NUMERAL ONE
@char < ROMAN-NUMERAL-ONE
build: from_expr
roman.one
cp: U+2160
@end

# U+2161 ROMAN NUMERAL TWO
@char > ROMAN-NUMERAL-TWO
build: from_expr
LR(roman.one, roman.one, 6/6)
cp: U+2161
@end

# U+2162 ROMAN NUMERAL THREE
@char ? ROMAN-NUMERAL-THREE
build: from_expr
LR(roman.one, roman.one, roman.one, 4/4/4)
cp: U+2162
@end

# U+2163 ROMAN NUMERAL FOUR
@char @ ROMAN-NUMERAL-FOUR
build: from_expr
LR(roman.one, roman.five, 4/8)
cp: U+2163
@end

# U+2164 ROMAN NUMERAL FIVE
@char A ROMAN-NUMERAL-FIVE
build: from_expr
roman.five
cp: U+2164
@end

# U+2165 ROMAN NUMERAL SIX
@char B ROMAN-NUMERAL-SIX
build: from_expr
LR(roman.five, roman.one, 8/4)
cp: U+2165
@end

# U+2166 ROMAN NUMERAL SEVEN
@char C ROMAN-NUMERAL-SEVEN
build: from_expr
LR(roman.five, roman.one, roman.one, 6/3/3)
cp: U+2166
@end

# U+2167 ROMAN NUMERAL EIGHT
@char D ROMAN-NUMERAL-EIGHT
build: from_expr
LR(roman.five, roman.one, roman.one, roman.one, 5/2/2/3)
cp: U+2167
@end

# U+2168 ROMAN NUMERAL NINE
@char E ROMAN-NUMERAL-NINE
build: from_expr
LR(roman.one, OVR(roman.ten, roman.ten.back), 4/8)
cp: U+2168
@end

# U+2169 ROMAN NUMERAL TEN
@char F ROMAN-NUMERAL-TEN
build: from_expr
OVR(roman.ten, roman.ten.back)
cp: U+2169
@end

# U+216A ROMAN NUMERAL ELEVEN
@char G ROMAN-NUMERAL-ELEVEN
build: from_expr
LR(OVR(roman.ten, roman.ten.back), roman.one, 8/4)
cp: U+216A
@end

# U+216B ROMAN NUMERAL TWELVE
@char H ROMAN-NUMERAL-TWELVE
build: from_expr
LR(OVR(roman.ten, roman.ten.back), roman.one, roman.one, 6/3/3)
cp: U+216B
@end

# U+216C ROMAN NUMERAL FIFTY
@char I ROMAN-NUMERAL-FIFTY
build: from_expr
roman.fifty
cp: U+216C
@end

# U+216D ROMAN NUMERAL ONE HUNDRED
@char J ROMAN-NUMERAL-ONE-HUNDRED
build: from_expr
roman.hundred
cp: U+216D
@end

# U+216E ROMAN NUMERAL FIVE HUNDRED
@char K ROMAN-NUMERAL-FIVE-HUNDRED
build: from_expr
roman.fivehundred
cp: U+216E
@end

# U+216F ROMAN NUMERAL ONE THOUSAND
@char L ROMAN-NUMERAL-ONE-THOUSAND
build: from_expr
roman.thousand
cp: U+216F
@end

# =============================================================================
# ROMAN NUMERALS - LOWERCASE (U+2170-217F)
# =============================================================================
# Small Roman numerals i through xii, plus l, c, d, m (scaled versions)

# U+2170 SMALL ROMAN NUMERAL ONE
@char M SMALL-ROMAN-NUMERAL-ONE
build: from_expr
small.roman.one
cp: U+2170
@end

# U+2171 SMALL ROMAN NUMERAL TWO
@char N SMALL-ROMAN-NUMERAL-TWO
build: from_expr
LR(small.roman.one, small.roman.one, 6/6)
cp: U+2171
@end

# U+2172 SMALL ROMAN NUMERAL THREE
@char O SMALL-ROMAN-NUMERAL-THREE
build: from_expr
LR(small.roman.one, small.roman.one, small.roman.one, 4/4/4)
cp: U+2172
@end

# U+2173 SMALL ROMAN NUMERAL FOUR
@char P SMALL-ROMAN-NUMERAL-FOUR
build: from_expr
LR(small.roman.one, small.roman.five, 4/8)
cp: U+2173
@end

# U+2174 SMALL ROMAN NUMERAL FIVE
@char Q SMALL-ROMAN-NUMERAL-FIVE
build: from_expr
small.roman.five
cp: U+2174
@end

# U+2175 SMALL ROMAN NUMERAL SIX
@char R SMALL-ROMAN-NUMERAL-SIX
build: from_expr
LR(small.roman.five, small.roman.one, 8/4)
cp: U+2175
@end

# U+2176 SMALL ROMAN NUMERAL SEVEN
@char S SMALL-ROMAN-NUMERAL-SEVEN
build: from_expr
LR(small.roman.five, small.roman.one, small.roman.one, 6/3/3)
cp: U+2176
@end

# U+2177 SMALL ROMAN NUMERAL EIGHT
@char T SMALL-ROMAN-NUMERAL-EIGHT
build: from_expr
LR(small.roman.five, small.roman.one, small.roman.one, small.roman.one, 5/2/2/3)
cp: U+2177
@end

# U+2178 SMALL ROMAN NUMERAL NINE
@char U SMALL-ROMAN-NUMERAL-NINE
build: from_expr
LR(small.roman.one, small.roman.ten, 4/8)
cp: U+2178
@end

# U+2179 SMALL ROMAN NUMERAL TEN
@char V SMALL-ROMAN-NUMERAL-TEN
build: from_expr
small.roman.ten
cp: U+2179
@end

# U+217A SMALL ROMAN NUMERAL ELEVEN
@char W SMALL-ROMAN-NUMERAL-ELEVEN
build: from_expr
LR(small.roman.ten, small.roman.one, 8/4)
cp: U+217A
@end

# U+217B SMALL ROMAN NUMERAL TWELVE
@char X SMALL-ROMAN-NUMERAL-TWELVE
build: from_expr
LR(small.roman.ten, small.roman.one, small.roman.one, 6/3/3)
cp: U+217B
@end

# U+217C SMALL ROMAN NUMERAL FIFTY
@char Y SMALL-ROMAN-NUMERAL-FIFTY
build: from_expr
small.roman.fifty
cp: U+217C
@end

# U+217D SMALL ROMAN NUMERAL ONE HUNDRED
@char Z SMALL-ROMAN-NUMERAL-ONE-HUNDRED
build: from_expr
small.roman.hundred
cp: U+217D
@end

# U+217E SMALL ROMAN NUMERAL FIVE HUNDRED
@char [ SMALL-ROMAN-NUMERAL-FIVE-HUNDRED
build: from_expr
small.roman.fivehundred
cp: U+217E
@end

# U+217F SMALL ROMAN NUMERAL ONE THOUSAND
@char ] SMALL-ROMAN-NUMERAL-ONE-THOUSAND
build: from_expr
small.roman.thousand
cp: U+217F
@end

# =============================================================================
# END OF NUMBER FORMS LIBRARY
# =============================================================================
