@elem geo.star.five.black
zone: x-height
path: p1 p2 p3 p4 p5 p6 p7 p8 p9 p10
p1 = [6,0]
p2 = [7,4]
p3 = [12,4]
p4 = [8,7]
p5 = [10,12]
p6 = [6,9]
p7 = [2,12]
p8 = [4,7]
p9 = [0,4]
p10 = [5,4]
close: true
width: 0
anchors: center=[6,6]
@end

