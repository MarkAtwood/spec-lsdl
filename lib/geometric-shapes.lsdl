p2 = C([11,1] [11,6])
p3 = C([11,11] [6,11])
p4 = C([1,11] [1,6])
close: true
width: 0
anchors: top=[6,1] base=[6,11] left=[1,6] right=[11,6] center=[6,6]
@end

