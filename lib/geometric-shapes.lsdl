p1 = [1,6]
p2 = C([1,1] [6,1])
p3 = C([11,1] [11,6])
p4 = [1,6]
close: true
width: 0
anchors: center=[6,3]
@end

# geo.circle.half.bot.black - Circle with bottom half black
@elem geo.circle.half.bot.black
zone: x-height
path: p1 p2 p3 p4
p1 = [1,6]
p2 = [11,6]
p3 = C([11,11] [6,11])
p4 = C([1,11] [1,6])
close: true
width: 0
anchors: center=[6,9]
@end

# geo.circle.dotted - Circle with center dot
@elem geo.circle.dotted
zone: x-height
path: p1 p2 p3 p4
p1 = [6,5]
p2 = C([7,5] [7,6])
p3 = C([7,7] [6,7])
p4 = C([5,7] [5,6])
close: true
width: 0
anchors: center=[6,6]
@end

# geo.circle.small.black - Small filled circle
@elem geo.circle.small.black
zone: x-height
path: p1 p2 p3 p4
p1 = [6,3]
p2 = C([9,3] [9,6])
p3 = C([9,9] [6,9])
p4 = C([3,9] [3,6])
close: true
width: 0
anchors: center=[6,6]
@end

# geo.circle.small.white - Small outline circle
@elem geo.circle.small.white
zone: x-height
path: p1 p2 p3 p4
p1 = [6,3]
p2 = C([9,3] [9,6])
p3 = C([9,9] [6,9])
p4 = C([3,9] [3,6])
close: true
width: 1
anchors: center=[6,6]
@end

# geo.bullseye - Circle with inner ring (bullseye)
@elem geo.bullseye
zone: x-height
path: p1 p2 p3 p4
p1 = [6,4]
p2 = C([8,4] [8,6])
p3 = C([8,8] [6,8])
p4 = C([4,8] [4,6])
close: true
width: 0
anchors: center=[6,6]
@end

# =============================================================================
# STAR ELEMENTS
# =============================================================================

# geo.star.four.black - Four-pointed star filled
@elem geo.star.four.black
zone: x-height
path: p1 p2 p3 p4 p5 p6 p7 p8
p1 = [6,0]
p2 = [7,5]
p3 = [12,6]
p4 = [7,7]
p5 = [6,12]
p6 = [5,7]
p7 = [0,6]
p8 = [5,5]
close: true
width: 0
anchors: center=[6,6]
@end

# geo.star.four.white - Four-pointed star outline
@elem geo.star.four.white
zone: x-height
path: p1 p2 p3 p4 p5 p6 p7 p8
