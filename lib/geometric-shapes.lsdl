p1 = [6,0]
p2 = [7,4]
p3 = [12,4]
p4 = [8,7]
p5 = [10,12]
p6 = [6,9]
p7 = [2,12]
p8 = [4,7]
p9 = [0,4]
p10 = [5,4]
close: true
width: 1
anchors: center=[6,6]
@end

# geo.star.six.black - Six-pointed star (Star of David) filled
@elem geo.star.six.black
zone: x-height
path: p1 p2 p3 p4 p5 p6
p1 = [6,0]
p2 = [9,5]
p3 = [12,5]
p4 = [9,7]
p5 = [6,12]
p6 = [3,7]
close: true
