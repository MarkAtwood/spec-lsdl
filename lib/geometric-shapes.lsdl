p2 = [9,5]
p3 = [12,5]
p4 = [9,7]
p5 = [6,12]
p6 = [3,7]
close: true
width: 1
anchors: center=[6,6]
@end

# =============================================================================
# =============================================================================
# CHARACTER DEFINITIONS
# =============================================================================
#
# Since the Geometric Shapes block (U+25xx) is not in the inline-character
# whitelist in the LSDL parser, we use @char blocks with placeholder ASCII
# characters and cp: metadata to specify the actual Unicode codepoint.
#
# =============================================================================

# U+25A0 BLACK SQUARE
@char ! BLACK-SQUARE
build: from_expr
geo.square.black
cp: U+25A0
@end

# U+25A1 WHITE SQUARE
@char $ WHITE-SQUARE
build: from_expr
geo.square.white
cp: U+25A1
@end

# U+25A2 WHITE SQUARE WITH ROUNDED CORNERS
@char % WHITE-SQUARE-WITH-ROUNDED-CORNERS
build: from_expr
geo.square.rounded.white
cp: U+25A2
@end

# U+25A3 WHITE SQUARE CONTAINING BLACK SMALL SQUARE
@char & WHITE-SQUARE-CONTAINING-BLACK-SMALL-SQUARE
build: from_expr
FRAME(geo.square.white, geo.square.small.black)
cp: U+25A3
@end

# U+25A4 SQUARE WITH HORIZONTAL FILL
@char ' SQUARE-WITH-HORIZONTAL-FILL
build: from_expr
geo.square.black
cp: U+25A4
@end

# U+25A5 SQUARE WITH VERTICAL FILL
@char + SQUARE-WITH-VERTICAL-FILL
build: from_expr
geo.square.black
cp: U+25A5
@end

# U+25A6 SQUARE WITH ORTHOGONAL CROSSHATCH FILL
@char - SQUARE-WITH-ORTHOGONAL-CROSSHATCH-FILL
build: from_expr
geo.square.black
cp: U+25A6
@end

# U+25A7 SQUARE WITH UPPER LEFT TO LOWER RIGHT FILL
@char . SQUARE-WITH-UPPER-LEFT-TO-LOWER-RIGHT-FILL
build: from_expr
geo.square.black
cp: U+25A7
@end

# U+25A8 SQUARE WITH UPPER RIGHT TO LOWER LEFT FILL
@char / SQUARE-WITH-UPPER-RIGHT-TO-LOWER-LEFT-FILL
build: from_expr
geo.square.black
cp: U+25A8
@end

# U+25A9 SQUARE WITH DIAGONAL CROSSHATCH FILL
@char 0 SQUARE-WITH-DIAGONAL-CROSSHATCH-FILL
build: from_expr
geo.square.black
cp: U+25A9
@end

# U+25AA BLACK SMALL SQUARE
@char 1 BLACK-SMALL-SQUARE
build: from_expr
geo.square.small.black
cp: U+25AA
@end

# U+25AB WHITE SMALL SQUARE
@char 2 WHITE-SMALL-SQUARE
build: from_expr
geo.square.small.white
cp: U+25AB
@end

# U+25AC BLACK RECTANGLE
@char 3 BLACK-RECTANGLE
build: from_expr
geo.rect.horiz.black
cp: U+25AC
@end

# U+25AD WHITE RECTANGLE
@char 4 WHITE-RECTANGLE
build: from_expr
geo.rect.horiz.white
cp: U+25AD
@end

# U+25AE BLACK VERTICAL RECTANGLE
@char 5 BLACK-VERTICAL-RECTANGLE
build: from_expr
geo.rect.vert.black
cp: U+25AE
@end

# U+25AF WHITE VERTICAL RECTANGLE
@char 6 WHITE-VERTICAL-RECTANGLE
build: from_expr
geo.rect.vert.white
cp: U+25AF
@end

# U+25B0 BLACK PARALLELOGRAM
@char 7 BLACK-PARALLELOGRAM
build: from_expr
geo.parallelogram.black
cp: U+25B0
@end

# U+25B1 WHITE PARALLELOGRAM
@char 8 WHITE-PARALLELOGRAM
build: from_expr
geo.parallelogram.white
cp: U+25B1
@end

# U+25B2 BLACK UP POINTING TRIANGLE
@char 9 BLACK-UP-POINTING-TRIANGLE
build: from_expr
geo.triangle.up.black
cp: U+25B2
@end

# U+25B3 WHITE UP POINTING TRIANGLE
@char ; WHITE-UP-POINTING-TRIANGLE
build: from_expr
geo.triangle.up.white
cp: U+25B3
@end

# U+25B4 BLACK UP POINTING SMALL TRIANGLE
@char ? BLACK-UP-POINTING-SMALL-TRIANGLE
build: from_expr
geo.triangle.up.small.black
cp: U+25B4
@end

# U+25B5 WHITE UP POINTING SMALL TRIANGLE
@char @ WHITE-UP-POINTING-SMALL-TRIANGLE
build: from_expr
geo.triangle.up.small.white
cp: U+25B5
@end

# U+25B6 BLACK RIGHT POINTING TRIANGLE
@char A BLACK-RIGHT-POINTING-TRIANGLE
build: from_expr
geo.triangle.right.black
