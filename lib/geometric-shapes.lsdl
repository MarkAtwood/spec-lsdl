@lsdl 1.0

# =============================================================================
# LSDL Geometric Shapes Character Library
# =============================================================================
#
# This file defines geometric shape characters from the Geometric Shapes
# block (U+25A0-25FF).
#
# Characters defined (~96 total):
#   - Squares: filled, outline, small variants
#   - Rectangles and parallelograms
#   - Triangles: up/down/left/right, filled and outline
#   - Diamonds: filled and outline
#   - Circles: filled, outline, half-filled variants
#   - Small shape variants
#
# Design notes:
#   - BLACK = filled closed path (close: true, width: 0 for fill)
#   - WHITE = outline only (close: true, width: 1 for stroke)
#   - All shapes centered in the 12x12 grid
#   - Uses @char block format since Geometric Shapes block (U+25xx) is not
#     in the inline-character whitelist in the parser
#
# =============================================================================

# =============================================================================
# SQUARE ELEMENTS
# =============================================================================

# geo.square.black - Filled black square
@elem geo.square.black
zone: x-height
path: p1 p2 p3 p4
p1 = [1,1]
p2 = [11,1]
p3 = [11,11]
p4 = [1,11]
close: true
width: 0
anchors: center=[6,6] top=[6,1] base=[6,11] left=[1,6] right=[11,6]
@end

# geo.square.white - Outline white square
@elem geo.square.white
zone: x-height
path: p1 p2 p3 p4
p1 = [1,1]
p2 = [11,1]
p3 = [11,11]
p4 = [1,11]
close: true
width: 1
anchors: center=[6,6] top=[6,1] base=[6,11] left=[1,6] right=[11,6]
@end

# geo.square.small.black - Small filled black square
@elem geo.square.small.black
zone: x-height
path: p1 p2 p3 p4
p1 = [4,4]
p2 = [8,4]
p3 = [8,8]
p4 = [4,8]
close: true
width: 0
anchors: center=[6,6]
@end

# geo.square.small.white - Small outline white square
@elem geo.square.small.white
zone: x-height
path: p1 p2 p3 p4
p1 = [4,4]
p2 = [8,4]
p3 = [8,8]
p4 = [4,8]
close: true
width: 1
anchors: center=[6,6]
@end

# geo.square.rounded.black - Filled black square with rounded corners
@elem geo.square.rounded.black
zone: x-height
path: p1 p2 p3 p4 p5 p6 p7 p8
p1 = [2,1]
p2 = [10,1]
p3 = C([11,1] [11,2])
p4 = [11,10]
p5 = C([11,11] [10,11])
p6 = [2,11]
p7 = C([1,11] [1,10])
p8 = C([1,1] [2,1])
close: true
width: 0
anchors: center=[6,6]
@end

# geo.square.rounded.white - Outline white square with rounded corners
@elem geo.square.rounded.white
zone: x-height
path: p1 p2 p3 p4 p5 p6 p7 p8
p1 = [2,1]
p2 = [10,1]
p3 = C([11,1] [11,2])
p4 = [11,10]
p5 = C([11,11] [10,11])
p6 = [2,11]
p7 = C([1,11] [1,10])
p8 = C([1,1] [2,1])
close: true
width: 1
anchors: center=[6,6]
@end

