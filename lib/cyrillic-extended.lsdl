ө  CYRILLIC-SMALL-BARRED-O = OVR(bowl.full, stroke.horiz) script:Cyrl ortho:Kaz
  # Small barred o

ӫ  CYRILLIC-SMALL-BARRED-O-DIAERESIS = DIA(ө, diaeresis) script:Cyrl ortho:Kha
  # Small barred o with diaeresis

ӭ  CYRILLIC-SMALL-E-DIAERESIS = DIA(э, diaeresis) script:Cyrl ortho:Ksa
  # Small e with diaeresis

ӯ  CYRILLIC-SMALL-U-MACRON = DIA(у, macron) script:Cyrl ortho:Tjk
  # Small u with macron

ӱ  CYRILLIC-SMALL-U-DIAERESIS = DIA(у, diaeresis) script:Cyrl ortho:Mri
  # Small u with diaeresis

ӳ  CYRILLIC-SMALL-U-DOUBLE-ACUTE = DIA(у, double-acute) script:Cyrl ortho:Chv
  # Small u with double acute

ӵ  CYRILLIC-SMALL-CHE-DIAERESIS = DIA(ч, diaeresis) script:Cyrl ortho:Udm
  # Small che with diaeresis

ӷ  CYRILLIC-SMALL-GHE-DESCENDER = FRAME(г, hook.desc.cyr) script:Cyrl ortho:Abk
  # Small ghe with descender

ӹ  CYRILLIC-SMALL-YERU-DIAERESIS = DIA(ы, diaeresis) script:Cyrl ortho:Mri
  # Small yeru with diaeresis

ӻ  CYRILLIC-SMALL-GHE-STROKE-HOOK = FRAME(ғ, hook.desc.cyr) script:Cyrl
