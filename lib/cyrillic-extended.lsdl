ҏ  CYRILLIC-SMALL-ER-TICK = FRAME(р, tick.cyr) script:Cyrl
  # Small er with tick

ғ  CYRILLIC-SMALL-GHE-STROKE = FRAME(stem, bar.top.x, stroke.mid.cyr) script:Cyrl ortho:Kaz
  # Small ghe with stroke: stem first (stroke order)

ҕ  CYRILLIC-SMALL-GHE-HOOK = FRAME(stem, bar.top.x, hook.desc.cyr) script:Cyrl ortho:Yak
  # Small ghe with hook: stem first (stroke order)

җ  CYRILLIC-SMALL-ZHE-DESCENDER = FRAME(ж, tail.cyr) script:Cyrl ortho:Tat
  # Small zhe with descender

ҙ  CYRILLIC-SMALL-ZE-DESCENDER = FRAME(STACK(arc.top.r, arc.bot.r), tail.cyr) script:Cyrl ortho:Bsh
  # Small ze with descender

қ  CYRILLIC-SMALL-KA-DESCENDER = FRAME(к, hook.desc.cyr) script:Cyrl ortho:Kaz
  # Small ka with descender

ҝ  CYRILLIC-SMALL-KA-VERTICAL-STROKE = FRAME(к, stroke.mid.cyr) script:Cyrl ortho:Aze
  # Small ka with vertical stroke

ҟ  CYRILLIC-SMALL-KA-STROKE = OVR(к, stroke.horiz) script:Cyrl ortho:Abk
  # Small ka with stroke

ҡ  CYRILLIC-SMALL-BASHKIR-KA = FRAME(stem, STACK(arc.top.r, arc.bot.r)) script:Cyrl ortho:Bsh
  # Small Bashkir ka

ң  CYRILLIC-SMALL-EN-DESCENDER = FRAME(н, hook.desc.cyr) script:Cyrl ortho:Kaz
  # Small en with descender

ҥ  CYRILLIC-SMALL-LIGATURE-EN-GHE = LR(н, г) script:Cyrl ortho:Yak
  # Small en-ghe ligature

ҧ  CYRILLIC-SMALL-PE-HOOK = FRAME(п, hook.desc.cyr) script:Cyrl ortho:Abk
  # Small pe with hook

ҩ  CYRILLIC-SMALL-ABKHAZ-HA = FRAME(bowl.full, tail) script:Cyrl ortho:Abk
  # Small Abkhaz ha

ҫ  CYRILLIC-SMALL-ES-DESCENDER = FRAME(с, tail.cyr) script:Cyrl ortho:Chv
  # Small es with descender

ҭ  CYRILLIC-SMALL-TE-DESCENDER = FRAME(т, tail.cyr) script:Cyrl ortho:Abk
  # Small te with descender

ү  CYRILLIC-SMALL-STRAIGHT-U = vertex script:Cyrl ortho:Kaz
  # Small straight u

ұ  CYRILLIC-SMALL-STRAIGHT-U-STROKE = OVR(vertex, stroke.horiz) script:Cyrl ortho:Kaz
  # Small straight u with stroke

ҳ  CYRILLIC-SMALL-HA-DESCENDER = FRAME(х, hook.desc.cyr) script:Cyrl ortho:Uzb
  # Small ha with descender

ҵ  CYRILLIC-SMALL-LIGATURE-TE-TSE = LR(т, ц) script:Cyrl ortho:Abk
  # Small te-tse ligature

ҷ  CYRILLIC-SMALL-CHE-DESCENDER = FRAME(ч, hook.desc.cyr) script:Cyrl ortho:Tjk
  # Small che with descender

ҹ  CYRILLIC-SMALL-CHE-VERTICAL-STROKE = FRAME(ч, stroke.mid.cyr) script:Cyrl ortho:Aze
  # Small che with vertical stroke

һ  CYRILLIC-SMALL-SHHA = FRAME(ascender.l, shoulder) script:Cyrl ortho:Tat
  # Small shha - like Latin h

ҽ  CYRILLIC-SMALL-ABKHAZ-CHE = FRAME(hook.cyr, arc.top) script:Cyrl ortho:Abk
  # Small Abkhaz che

ҿ  CYRILLIC-SMALL-ABKHAZ-CHE-DESCENDER = FRAME(ҽ, hook.desc.cyr) script:Cyrl ortho:Abk
  # Small Abkhaz che with descender

ӏ  CYRILLIC-SMALL-PALOCHKA = stem script:Cyrl ortho:Cau
  # Small palochka

ӂ  CYRILLIC-SMALL-ZHE-BREVE = DIA(ж, breve) script:Cyrl ortho:Mol
  # Small zhe with breve

ӄ  CYRILLIC-SMALL-KA-HOOK = FRAME(к, hook.top) script:Cyrl ortho:Kha
  # Small ka with hook

ӆ  CYRILLIC-SMALL-EL-TAIL = FRAME(л, tail.cyr) script:Cyrl ortho:Ksa
  # Small el with tail

ӈ  CYRILLIC-SMALL-EN-HOOK = FRAME(н, hook.top) script:Cyrl ortho:Kha
  # Small en with hook

ӊ  CYRILLIC-SMALL-EN-TAIL = FRAME(н, tail.cyr) script:Cyrl ortho:Ksa
  # Small en with tail

ӌ  CYRILLIC-SMALL-CHE-HOOK = FRAME(ч, hook.top) script:Cyrl ortho:Kha
  # Small che with hook

ӎ  CYRILLIC-SMALL-EM-TAIL = FRAME(м, tail.cyr) script:Cyrl ortho:Ksa
  # Small em with tail

ӑ  CYRILLIC-SMALL-A-BREVE = DIA(а, breve) script:Cyrl ortho:Chv
  # Small a with breve

ӓ  CYRILLIC-SMALL-A-DIAERESIS = DIA(а, diaeresis) script:Cyrl ortho:Mri
  # Small a with diaeresis

ӕ  CYRILLIC-SMALL-LIGATURE-A-IE = LR(а, е) script:Cyrl ortho:Oss
  # Small a-ie ligature

ӗ  CYRILLIC-SMALL-IE-BREVE = DIA(е, breve) script:Cyrl ortho:Chv
  # Small ie with breve

ә  CYRILLIC-SMALL-SCHWA = bowl.full script:Cyrl ortho:Kaz
  # Small schwa

ӛ  CYRILLIC-SMALL-SCHWA-DIAERESIS = DIA(ә, diaeresis) script:Cyrl ortho:Kha
  # Small schwa with diaeresis

ӝ  CYRILLIC-SMALL-ZHE-DIAERESIS = DIA(ж, diaeresis) script:Cyrl ortho:Udm
  # Small zhe with diaeresis

