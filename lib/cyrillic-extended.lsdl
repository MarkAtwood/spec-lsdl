ҁ  CYRILLIC-SMALL-KOPPA = STACK(arc.top, arc.bot, tail) script:Cyrl ortho:OCS
  # Small koppa

ҋ  CYRILLIC-SMALL-SHORT-I-TAIL = FRAME(и, tail.cyr) script:Cyrl
