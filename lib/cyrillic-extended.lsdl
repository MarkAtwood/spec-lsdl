@lsdl 1.0

# =============================================================================
# LSDL Extended Cyrillic Library (U+0480-04FF)
# =============================================================================
#
# Extended Cyrillic characters used for non-Slavic languages written in
# Cyrillic script (Kazakh, Uzbek, Turkmen, Tajik, Abkhaz, Chuvash, etc.)
#
# Many of these are base letters with hooks, tails, bars, or other modifiers.
#
# =============================================================================

# @import cyrillic.lsdl
# @import elements-base.lsdl

# =============================================================================
# CASE MAPPINGS
# =============================================================================

# Extended Cyrillic (U+0480-04FF)
# Note: Ґ/ґ defined in cyrillic.lsdl (Ukrainian extension)
@case Ҁ ҁ
@case Ҋ ҋ
@case Ҍ ҍ
@case Ҏ ҏ
@case Ғ ғ
@case Ҕ ҕ
@case Җ җ
@case Ҙ ҙ
@case Қ қ
@case Ҝ ҝ
@case Ҟ ҟ
@case Ҡ ҡ
@case Ң ң
@case Ҥ ҥ
@case Ҧ ҧ
@case Ҩ ҩ
@case Ҫ ҫ
@case Ҭ ҭ
@case Ү ү
@case Ұ ұ
@case Ҳ ҳ
@case Ҵ ҵ
@case Ҷ ҷ
@case Ҹ ҹ
@case Һ һ
@case Ҽ ҽ
@case Ҿ ҿ
@case Ӏ ӏ
@case Ӂ ӂ
@case Ӄ ӄ
@case Ӆ ӆ
@case Ӈ ӈ
@case Ӊ ӊ
@case Ӌ ӌ
@case Ӎ ӎ
@case Ӑ ӑ
@case Ӓ ӓ
@case Ӕ ӕ
@case Ӗ ӗ
@case Ә ә
@case Ӛ ӛ
@case Ӝ ӝ
@case Ӟ ӟ
@case Ӡ ӡ
@case Ӣ ӣ
@case Ӥ ӥ
@case Ӧ ӧ
@case Ө ө
@case Ӫ ӫ
@case Ӭ ӭ
@case Ӯ ӯ
@case Ӱ ӱ
@case Ӳ ӳ
@case Ӵ ӵ
@case Ӷ ӷ
@case Ӹ ӹ
@case Ӻ ӻ
@case Ӽ ӽ
@case Ӿ ӿ

# =============================================================================
# CYRILLIC-SPECIFIC EXTENDED ELEMENTS
# =============================================================================

# -----------------------------------------------------------------------------
# soft-sign.base - Base form for Ь and component of Ъ, Ы
# (Copied from cyrillic.lsdl for standalone validation)
# -----------------------------------------------------------------------------
@elem soft-sign.base
zone: x-height
path: p1 p2 p3 p4
p1 = [2,4]
p2 = [2,8]
p3 = C([2,8] [8,8])
p4 = C([8,6] [2,6])
close: true
width: 1
anchors: top=[2,4] base=[2,8] attach=[5,7]
  mark-above=[2,3] mark-below=[5,9]
@end

# -----------------------------------------------------------------------------
# tick.cyr - Upturn tick (for Ukrainian Ґ)
# (Copied from cyrillic.lsdl for standalone validation)
# -----------------------------------------------------------------------------
@elem tick.cyr
zone: cap
path: p1 p2
p1 = [10,2]
p2 = [12,0]
close: false
width: 1
anchors: attach=[10,2] top=[12,0]
@end

# -----------------------------------------------------------------------------
# hook.desc.cyr - Descending hook (for Қ, Ң, etc.)
# -----------------------------------------------------------------------------
@elem hook.desc.cyr
zone: descender
path: p1 p2 p3
p1 = [6,8]
p2 = [6,10]
p3 = C([6,10] [4,10])
close: false
width: 1
anchors: attach=[6,8] base=[4,10]
@end

# -----------------------------------------------------------------------------
# stroke.mid.cyr - Middle horizontal stroke (for Ғ, Ҳ, etc.)
# -----------------------------------------------------------------------------
@elem stroke.mid.cyr
zone: cap
path: p1 p2
p1 = [0,4]
p2 = [4,4]
close: false
width: 1
anchors: mid=[2,4]
@end

# =============================================================================
# EXTENDED CYRILLIC CAPITAL LETTERS
# =============================================================================

Ҁ  CYRILLIC-CAPITAL-KOPPA = STACK(arc.top.cap, arc.bot.cap, tail) script:Cyrl ortho:OCS
  # Koppa - archaic, like C with tail

Ҋ  CYRILLIC-CAPITAL-SHORT-I-TAIL = FRAME(И, tail.cyr) script:Cyrl
  # Short I with tail (Kildin Sami)

Ҍ  CYRILLIC-CAPITAL-SEMISOFT = FRAME(soft-sign.base, stroke.mid.cyr) script:Cyrl
  # Semisoft sign (Kildin Sami)

Ҏ  CYRILLIC-CAPITAL-ER-TICK = FRAME(Р, tick.cyr) script:Cyrl
  # Er with tick (Kildin Sami)

Ғ  CYRILLIC-CAPITAL-GHE-STROKE = FRAME(stem.l, bar.top, stroke.mid.cyr) script:Cyrl ortho:Kaz
  # Ghe with middle stroke: stem first (stroke order)

Ҕ  CYRILLIC-CAPITAL-GHE-HOOK = FRAME(stem.l, bar.top, hook.desc.cyr) script:Cyrl ortho:Yak
  # Ghe with hook: stem first (stroke order)

Җ  CYRILLIC-CAPITAL-ZHE-DESCENDER = FRAME(Ж, tail.cyr) script:Cyrl ortho:Tat
  # Zhe with descender (Tatar, Bashkir)

Ҙ  CYRILLIC-CAPITAL-ZE-DESCENDER = FRAME(STACK(arc.top.cap.r, arc.bot.cap.r), tail.cyr) script:Cyrl ortho:Bsh
  # Ze with descender (Bashkir)

Қ  CYRILLIC-CAPITAL-KA-DESCENDER = FRAME(К, hook.desc.cyr) script:Cyrl ortho:Kaz
  # Ka with descender (Kazakh, Uzbek, Uyghur)

Ҝ  CYRILLIC-CAPITAL-KA-VERTICAL-STROKE = FRAME(К, stroke.mid.cyr) script:Cyrl ortho:Aze
  # Ka with vertical stroke (Azerbaijani)

Ҟ  CYRILLIC-CAPITAL-KA-STROKE = OVR(К, stroke.horiz) script:Cyrl ortho:Abk
  # Ka with stroke (Abkhaz)

Ҡ  CYRILLIC-CAPITAL-BASHKIR-KA = FRAME(stem.l, STACK(arc.top.cap.r, arc.bot.cap.r)) script:Cyrl ortho:Bsh
  # Bashkir Ka - unique form

Ң  CYRILLIC-CAPITAL-EN-DESCENDER = FRAME(Н, hook.desc.cyr) script:Cyrl ortho:Kaz
  # En with descender (Kazakh, Kyrgyz, Tatar)

Ҥ  CYRILLIC-CAPITAL-LIGATURE-EN-GHE = LR(Н, Г) script:Cyrl ortho:Yak
  # En-Ghe ligature (Yakut)

Ҧ  CYRILLIC-CAPITAL-PE-HOOK = FRAME(П, hook.desc.cyr) script:Cyrl ortho:Abk
  # Pe with hook (Abkhaz)

Ҩ  CYRILLIC-CAPITAL-ABKHAZ-HA = FRAME(bowl.cap, tail) script:Cyrl ortho:Abk
  # Abkhaz Ha - O with tail

Ҫ  CYRILLIC-CAPITAL-ES-DESCENDER = FRAME(С, tail.cyr) script:Cyrl ortho:Chv
  # Es with descender (Chuvash, Bashkir)

Ҭ  CYRILLIC-CAPITAL-TE-DESCENDER = FRAME(Т, tail.cyr) script:Cyrl ortho:Abk
  # Te with descender (Abkhaz)

Ү  CYRILLIC-CAPITAL-STRAIGHT-U = vertex.cap script:Cyrl ortho:Kaz
  # Straight U (Kazakh, Kyrgyz, Mongolian)

Ұ  CYRILLIC-CAPITAL-STRAIGHT-U-STROKE = OVR(vertex.cap, stroke.horiz) script:Cyrl ortho:Kaz
  # Straight U with stroke (Kazakh)

Ҳ  CYRILLIC-CAPITAL-HA-DESCENDER = FRAME(Х, hook.desc.cyr) script:Cyrl ortho:Uzb
  # Ha with descender (Uzbek, Tajik)

Ҵ  CYRILLIC-CAPITAL-LIGATURE-TE-TSE = LR(Т, Ц) script:Cyrl ortho:Abk
  # Te-Tse ligature (Abkhaz)

Ҷ  CYRILLIC-CAPITAL-CHE-DESCENDER = FRAME(Ч, hook.desc.cyr) script:Cyrl ortho:Tjk
  # Che with descender (Tajik, Abkhaz)

Ҹ  CYRILLIC-CAPITAL-CHE-VERTICAL-STROKE = FRAME(Ч, stroke.mid.cyr) script:Cyrl ortho:Aze
  # Che with vertical stroke (Azerbaijani)

Һ  CYRILLIC-CAPITAL-SHHA = FRAME(stem.l, shoulder, stem.r) script:Cyrl ortho:Tat
  # Shha - like Latin H (Tatar, Bashkir, Kazakh)

Ҽ  CYRILLIC-CAPITAL-ABKHAZ-CHE = FRAME(hook.cyr, arc.top.cap) script:Cyrl ortho:Abk
  # Abkhaz Che - variant form

Ҿ  CYRILLIC-CAPITAL-ABKHAZ-CHE-DESCENDER = FRAME(Ҽ, hook.desc.cyr) script:Cyrl ortho:Abk
  # Abkhaz Che with descender

Ӏ  CYRILLIC-LETTER-PALOCHKA = stem.l script:Cyrl ortho:Cau
  # Palochka - modifier letter for Caucasian languages

Ӂ  CYRILLIC-CAPITAL-ZHE-BREVE = DIA(Ж, breve) script:Cyrl ortho:Mol
  # Zhe with breve (Moldovan)

Ӄ  CYRILLIC-CAPITAL-KA-HOOK = FRAME(К, hook.top) script:Cyrl ortho:Kha
  # Ka with hook (Khanty)

Ӆ  CYRILLIC-CAPITAL-EL-TAIL = FRAME(Л, tail.cyr) script:Cyrl ortho:Ksa
  # El with tail (Kildin Sami)

Ӈ  CYRILLIC-CAPITAL-EN-HOOK = FRAME(Н, hook.top) script:Cyrl ortho:Kha
  # En with hook (Khanty, Chukchi)

Ӊ  CYRILLIC-CAPITAL-EN-TAIL = FRAME(Н, tail.cyr) script:Cyrl ortho:Ksa
  # En with tail (Kildin Sami)

Ӌ  CYRILLIC-CAPITAL-CHE-HOOK = FRAME(Ч, hook.top) script:Cyrl ortho:Kha
  # Che with hook (Khanty)

Ӎ  CYRILLIC-CAPITAL-EM-TAIL = FRAME(М, tail.cyr) script:Cyrl ortho:Ksa
  # Em with tail (Kildin Sami)

Ӑ  CYRILLIC-CAPITAL-A-BREVE = DIA(А, breve) script:Cyrl ortho:Chv
  # A with breve (Chuvash)

Ӓ  CYRILLIC-CAPITAL-A-DIAERESIS = DIA(А, diaeresis) script:Cyrl ortho:Mri
  # A with diaeresis (Mari)

Ӕ  CYRILLIC-CAPITAL-LIGATURE-A-IE = LR(А, Е) script:Cyrl ortho:Oss
  # A-Ie ligature (Ossetian) - like Latin AE

Ӗ  CYRILLIC-CAPITAL-IE-BREVE = DIA(Е, breve) script:Cyrl ortho:Chv
  # Ie with breve (Chuvash)

Ә  CYRILLIC-CAPITAL-SCHWA = bowl.cap script:Cyrl ortho:Kaz
  # Schwa (Kazakh, Tatar, Bashkir) - rotated E form

Ӛ  CYRILLIC-CAPITAL-SCHWA-DIAERESIS = DIA(Ә, diaeresis) script:Cyrl ortho:Kha
  # Schwa with diaeresis (Khanty)

Ӝ  CYRILLIC-CAPITAL-ZHE-DIAERESIS = DIA(Ж, diaeresis) script:Cyrl ortho:Udm
  # Zhe with diaeresis (Udmurt)

Ӟ  CYRILLIC-CAPITAL-ZE-DIAERESIS = DIA(З, diaeresis) script:Cyrl ortho:Udm
  # Ze with diaeresis (Udmurt)

Ӡ  CYRILLIC-CAPITAL-ABKHAZ-DZE = FRAME(STACK(arc.top.cap.r, arc.bot.cap.r), tail) script:Cyrl ortho:Abk
  # Abkhaz Dze - Ze with tail variant

Ӣ  CYRILLIC-CAPITAL-I-MACRON = DIA(И, macron) script:Cyrl ortho:Tjk
  # I with macron (Tajik)

Ӥ  CYRILLIC-CAPITAL-I-DIAERESIS = DIA(И, diaeresis) script:Cyrl ortho:Udm
  # I with diaeresis (Udmurt)

Ӧ  CYRILLIC-CAPITAL-O-DIAERESIS = DIA(О, diaeresis) script:Cyrl ortho:Kom
  # O with diaeresis (Komi, Mari)

Ө  CYRILLIC-CAPITAL-BARRED-O = OVR(bowl.cap, stroke.horiz) script:Cyrl ortho:Kaz
  # Barred O (Kazakh, Kyrgyz, Mongolian)

Ӫ  CYRILLIC-CAPITAL-BARRED-O-DIAERESIS = DIA(Ө, diaeresis) script:Cyrl ortho:Kha
  # Barred O with diaeresis

Ӭ  CYRILLIC-CAPITAL-E-DIAERESIS = DIA(Э, diaeresis) script:Cyrl ortho:Ksa
  # E with diaeresis (Kildin Sami)

Ӯ  CYRILLIC-CAPITAL-U-MACRON = DIA(У, macron) script:Cyrl ortho:Tjk
  # U with macron (Tajik)

Ӱ  CYRILLIC-CAPITAL-U-DIAERESIS = DIA(У, diaeresis) script:Cyrl ortho:Mri
  # U with diaeresis (Mari, Altai)

Ӳ  CYRILLIC-CAPITAL-U-DOUBLE-ACUTE = DIA(У, double-acute) script:Cyrl ortho:Chv
  # U with double acute (Chuvash)

Ӵ  CYRILLIC-CAPITAL-CHE-DIAERESIS = DIA(Ч, diaeresis) script:Cyrl ortho:Udm
  # Che with diaeresis (Udmurt)

Ӷ  CYRILLIC-CAPITAL-GHE-DESCENDER = FRAME(Г, hook.desc.cyr) script:Cyrl ortho:Abk
  # Ghe with descender

Ӹ  CYRILLIC-CAPITAL-YERU-DIAERESIS = DIA(Ы, diaeresis) script:Cyrl ortho:Mri
  # Yeru with diaeresis (Mari)

Ӻ  CYRILLIC-CAPITAL-GHE-STROKE-HOOK = FRAME(Ғ, hook.desc.cyr) script:Cyrl
  # Ghe with stroke and hook

Ӽ  CYRILLIC-CAPITAL-HA-HOOK = FRAME(Х, hook.top) script:Cyrl ortho:Kha
  # Ha with hook (Khanty)

Ӿ  CYRILLIC-CAPITAL-HA-STROKE = OVR(Х, stroke.horiz) script:Cyrl ortho:Kha
  # Ha with stroke (Khanty)

# =============================================================================
# EXTENDED CYRILLIC SMALL LETTERS
