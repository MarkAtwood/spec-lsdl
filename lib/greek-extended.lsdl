@lsdl 1.0

# =============================================================================
# LSDL Greek Extended Character Library (U+1F00-U+1FFF)
# =============================================================================
#
# This file defines characters from the Greek Extended Unicode block,
# used for polytonic Greek with breathing marks and accents.
#
# Diacritics used (from diacritics.lsdl):
#   - comma-above (psili): smooth breathing
#   - reversed-comma-above (dasia): rough breathing
#   - acute (oxia): acute accent
#   - grave (varia): grave accent
#   - greek-perispomeni: circumflex accent
#   - greek-ypogegrammeni: iota subscript (lowercase)
#   - breve (vrachy): short vowel mark
#   - macron: long vowel mark
#   - diaeresis (dialytika): diaeresis
#
# Local aliases for readability:
#   psili = comma-above (smooth breathing)
#   dasia = reversed-comma-above (rough breathing)
#   oxia = acute
#   varia = grave
#   perispomeni = greek-perispomeni
#   ypogegrammeni = greek-ypogegrammeni
#   prosgegrammeni = greek-ypogegrammeni (capital form, same element)
#   vrachy = breve
#   dialytika = diaeresis
#
# Composition patterns:
#   - Single diacritic: DIA(base, mark)
#   - Double diacritics: DIA2(base, mark1, mark2)
#   - Triple diacritics: DIA(DIA2(base, mark1, mark2), mark3)
#
# Organization:
#   - Alpha with breathing/accents (U+1F00-U+1F0F)
#   - Epsilon with breathing/accents (U+1F10-U+1F1D)
#   - Eta with breathing/accents (U+1F20-U+1F2F)
#   - Iota with breathing/accents (U+1F30-U+1F3F)
#   - Omicron with breathing/accents (U+1F40-U+1F4D)
#   - Upsilon with breathing/accents (U+1F50-U+1F5F)
#   - Omega with breathing/accents (U+1F60-U+1F6F)
#   - Vowels with varia/oxia only (U+1F70-U+1F7D)
#   - Alpha/Eta/Omega with breathing and ypogegrammeni (U+1F80-U+1FAF)
#   - Alpha extended forms (U+1FB0-U+1FBC)
#   - Standalone diacritics (U+1FBD-U+1FC1)
#   - Eta extended forms (U+1FC2-U+1FCC)
#   - Diacritic combinations (U+1FCD-U+1FCF)
#   - Iota extended forms (U+1FD0-U+1FDB)
#   - Diacritic combinations (U+1FDD-U+1FDF)
#   - Upsilon extended forms (U+1FE0-U+1FEC)
#   - Diacritic combinations (U+1FED-U+1FEF)
#   - Omega extended forms (U+1FF2-U+1FFC)
#   - Standalone diacritics (U+1FFD-U+1FFE)
#
# =============================================================================

# =============================================================================
# LOCAL ELEMENT ALIASES
# =============================================================================
#
# These aliases provide polytonic-specific names for the diacritics.
# The underlying elements are defined in diacritics.lsdl.
#
# =============================================================================

# Breathing marks
@elem psili
zone: diacritic-above
path: p1 p2 p3
p1 = [6,0]
p2 = C([6,0] [6,1])
p3 = [6,2]
close: false
width: 1
anchors: attach=[6,2]
@end

@elem dasia
zone: diacritic-above
path: p1 p2 p3
p1 = [6,0]
p2 = C([6,0] [6,1])
p3 = [6,2]
close: false
width: 1
anchors: attach=[6,2]
@end

# Accent marks (aliases to standard diacritics)
@elem oxia
zone: diacritic-above
path: p1 p2
p1 = [5,2]
p2 = [7,0]
close: false
width: 1
anchors: attach=[6,2]
@end

@elem varia
zone: diacritic-above
path: p1 p2
p1 = [7,2]
p2 = [5,0]
close: false
width: 1
anchors: attach=[6,2]
@end

@elem perispomeni
zone: diacritic-above
path: p1 p2 p3
p1 = [4,2]
p2 = C([4,0] [6,0])
p3 = C([8,0] [8,2])
close: false
width: 1
anchors: attach=[6,2]
@end

@elem ypogegrammeni
zone: diacritic-below
path: p1 p2
p1 = [6,9]
p2 = [6,11]
close: false
width: 1
anchors: attach=[6,8]
@end

@elem vrachy
zone: diacritic-above
path: p1 p2 p3
p1 = [4,0]
p2 = C([4,2] [6,2])
p3 = C([8,2] [8,0])
close: false
width: 1
anchors: attach=[6,2]
@end

@elem dialytika
zone: diacritic-above
path: p1 p2 p3 p4
p1 = [4,1]
p2 = C([4,1] [4,2])
p3 = C([4,2] [4,2])
p4 = C([4,2] [4,2])
close: true
width: 1
anchors: attach=[6,2]
@end

# Combined diacritics for standalone marks
@elem psili-varia
zone: diacritic-above
path: p1 p2 p3 p4
p1 = [6,0]
p2 = C([6,0] [6,1])
p3 = [5,2]
p4 = [3,0]
close: false
width: 1
anchors: attach=[6,2]
@end

@elem psili-oxia
zone: diacritic-above
path: p1 p2 p3 p4
p1 = [6,0]
p2 = C([6,0] [6,1])
p3 = [7,2]
p4 = [9,0]
close: false
width: 1
anchors: attach=[6,2]
@end

@elem psili-perispomeni
zone: diacritic-above
path: p1 p2 p3 p4 p5
p1 = [6,0]
p2 = C([6,0] [6,1])
p3 = [6,2]
p4 = C([4,0] [6,0])
p5 = C([8,0] [8,2])
close: false
width: 1
anchors: attach=[6,2]
@end

@elem dasia-varia
zone: diacritic-above
path: p1 p2 p3 p4
p1 = [6,0]
p2 = C([6,0] [6,1])
p3 = [5,2]
p4 = [3,0]
close: false
width: 1
anchors: attach=[6,2]
@end

@elem dasia-oxia
zone: diacritic-above
path: p1 p2 p3 p4
p1 = [6,0]
p2 = C([6,0] [6,1])
p3 = [7,2]
p4 = [9,0]
close: false
width: 1
anchors: attach=[6,2]
@end

@elem dasia-perispomeni
zone: diacritic-above
path: p1 p2 p3 p4 p5
p1 = [6,0]
p2 = C([6,0] [6,1])
p3 = [6,2]
p4 = C([4,0] [6,0])
p5 = C([8,0] [8,2])
close: false
width: 1
anchors: attach=[6,2]
@end

@elem dialytika-varia
zone: diacritic-above
path: p1 p2 p3 p4 p5
p1 = [4,1]
p2 = C([4,1] [4,2])
p3 = [8,1]
p4 = [7,2]
p5 = [5,0]
close: false
width: 1
anchors: attach=[6,2]
@end

@elem dialytika-oxia
zone: diacritic-above
path: p1 p2 p3 p4 p5
p1 = [4,1]
p2 = C([4,1] [4,2])
p3 = [8,1]
p4 = [5,2]
p5 = [7,0]
close: false
width: 1
anchors: attach=[6,2]
@end

@elem dialytika-perispomeni
zone: diacritic-above
path: p1 p2 p3 p4 p5 p6
p1 = [4,1]
p2 = C([4,1] [4,2])
p3 = [8,1]
p4 = [4,2]
p5 = C([4,0] [6,0])
p6 = C([8,0] [8,2])
close: false
width: 1
anchors: attach=[6,2]
@end

# =============================================================================
# CASE MAPPINGS
# =============================================================================

# Alpha with breathing marks
@case Ἀ ἀ
@case Ἁ ἁ
@case Ἂ ἂ
@case Ἃ ἃ
@case Ἄ ἄ
@case Ἅ ἅ
@case Ἆ ἆ
@case Ἇ ἇ

# Epsilon with breathing marks
@case Ἐ ἐ
@case Ἑ ἑ
@case Ἒ ἒ
@case Ἓ ἓ
@case Ἔ ἔ
@case Ἕ ἕ

# Eta with breathing marks
@case Ἠ ἠ
@case Ἡ ἡ
@case Ἢ ἢ
@case Ἣ ἣ
@case Ἤ ἤ
@case Ἥ ἥ
@case Ἦ ἦ
@case Ἧ ἧ

# Iota with breathing marks
@case Ἰ ἰ
@case Ἱ ἱ
@case Ἲ ἲ
@case Ἳ ἳ
@case Ἴ ἴ
@case Ἵ ἵ
@case Ἶ ἶ
@case Ἷ ἷ

# Omicron with breathing marks
@case Ὀ ὀ
@case Ὁ ὁ
@case Ὂ ὂ
@case Ὃ ὃ
@case Ὄ ὄ
@case Ὅ ὅ

# Upsilon with breathing marks (capital only has dasia)
@case Ὑ ὑ
@case Ὓ ὓ
@case Ὕ ὕ
@case Ὗ ὗ

# Omega with breathing marks
@case Ὠ ὠ
@case Ὡ ὡ
@case Ὢ ὢ
@case Ὣ ὣ
@case Ὤ ὤ
@case Ὥ ὥ
@case Ὦ ὦ
@case Ὧ ὧ

# Alpha with varia/oxia
@case Ὰ ὰ
@case Ά ά

# Epsilon with varia/oxia
@case Ὲ ὲ
@case Έ έ

# Eta with varia/oxia
@case Ὴ ὴ
@case Ή ή

# Iota with varia/oxia
@case Ὶ ὶ
@case Ί ί

# Omicron with varia/oxia
@case Ὸ ὸ
@case Ό ό

# Upsilon with varia/oxia
@case Ὺ ὺ
@case Ύ ύ

# Omega with varia/oxia
@case Ὼ ὼ
@case Ώ ώ

# Alpha with breathing and ypogegrammeni/prosgegrammeni
@case ᾈ ᾀ
@case ᾉ ᾁ
@case ᾊ ᾂ
@case ᾋ ᾃ
@case ᾌ ᾄ
@case ᾍ ᾅ
@case ᾎ ᾆ
@case ᾏ ᾇ

# Eta with breathing and ypogegrammeni/prosgegrammeni
@case ᾘ ᾐ
@case ᾙ ᾑ
@case ᾚ ᾒ
@case ᾛ ᾓ
@case ᾜ ᾔ
@case ᾝ ᾕ
@case ᾞ ᾖ
@case ᾟ ᾗ

# Omega with breathing and ypogegrammeni/prosgegrammeni
@case ᾨ ᾠ
@case ᾩ ᾡ
@case ᾪ ᾢ
@case ᾫ ᾣ
@case ᾬ ᾤ
@case ᾭ ᾥ
@case ᾮ ᾦ
@case ᾯ ᾧ

# Alpha with vrachy/macron
@case Ᾰ ᾰ
@case Ᾱ ᾱ

# Alpha with prosgegrammeni
@case ᾼ ᾳ

# Eta with prosgegrammeni
@case ῌ ῃ

# Iota with vrachy/macron
@case Ῐ ῐ
@case Ῑ ῑ

# Upsilon with vrachy/macron
@case Ῠ ῠ
@case Ῡ ῡ

# Rho with dasia
@case Ῥ ῥ

# Omega with prosgegrammeni
@case ῼ ῳ

# =============================================================================
# ALPHA WITH BREATHING MARKS (U+1F00-U+1F0F)
# =============================================================================

# Alpha with psili (smooth breathing)
ἀ  GREEK-SMALL-ALPHA-PSILI = DIA(α, psili) script:Grek

# Alpha with dasia (rough breathing)
ἁ  GREEK-SMALL-ALPHA-DASIA = DIA(α, dasia) script:Grek

# Alpha with psili and varia
ἂ  GREEK-SMALL-ALPHA-PSILI-VARIA = DIA2(α, psili, varia) script:Grek

# Alpha with dasia and varia
ἃ  GREEK-SMALL-ALPHA-DASIA-VARIA = DIA2(α, dasia, varia) script:Grek

# Alpha with psili and oxia
ἄ  GREEK-SMALL-ALPHA-PSILI-OXIA = DIA2(α, psili, oxia) script:Grek

# Alpha with dasia and oxia
ἅ  GREEK-SMALL-ALPHA-DASIA-OXIA = DIA2(α, dasia, oxia) script:Grek

# Alpha with psili and perispomeni
ἆ  GREEK-SMALL-ALPHA-PSILI-PERISPOMENI = DIA2(α, psili, perispomeni) script:Grek

# Alpha with dasia and perispomeni
ἇ  GREEK-SMALL-ALPHA-DASIA-PERISPOMENI = DIA2(α, dasia, perispomeni) script:Grek

# Capital alpha with psili
Ἀ  GREEK-CAPITAL-ALPHA-PSILI = DIA(Α, psili) script:Grek

# Capital alpha with dasia
Ἁ  GREEK-CAPITAL-ALPHA-DASIA = DIA(Α, dasia) script:Grek

# Capital alpha with psili and varia
Ἂ  GREEK-CAPITAL-ALPHA-PSILI-VARIA = DIA2(Α, psili, varia) script:Grek

# Capital alpha with dasia and varia
Ἃ  GREEK-CAPITAL-ALPHA-DASIA-VARIA = DIA2(Α, dasia, varia) script:Grek

# Capital alpha with psili and oxia
Ἄ  GREEK-CAPITAL-ALPHA-PSILI-OXIA = DIA2(Α, psili, oxia) script:Grek

# Capital alpha with dasia and oxia
Ἅ  GREEK-CAPITAL-ALPHA-DASIA-OXIA = DIA2(Α, dasia, oxia) script:Grek

# Capital alpha with psili and perispomeni
Ἆ  GREEK-CAPITAL-ALPHA-PSILI-PERISPOMENI = DIA2(Α, psili, perispomeni) script:Grek

# Capital alpha with dasia and perispomeni
Ἇ  GREEK-CAPITAL-ALPHA-DASIA-PERISPOMENI = DIA2(Α, dasia, perispomeni) script:Grek

# =============================================================================
# EPSILON WITH BREATHING MARKS (U+1F10-U+1F1D)
# =============================================================================

# Epsilon with psili
ἐ  GREEK-SMALL-EPSILON-PSILI = DIA(ε, psili) script:Grek

# Epsilon with dasia
ἑ  GREEK-SMALL-EPSILON-DASIA = DIA(ε, dasia) script:Grek

# Epsilon with psili and varia
ἒ  GREEK-SMALL-EPSILON-PSILI-VARIA = DIA2(ε, psili, varia) script:Grek

# Epsilon with dasia and varia
ἓ  GREEK-SMALL-EPSILON-DASIA-VARIA = DIA2(ε, dasia, varia) script:Grek

# Epsilon with psili and oxia
ἔ  GREEK-SMALL-EPSILON-PSILI-OXIA = DIA2(ε, psili, oxia) script:Grek

# Epsilon with dasia and oxia
ἕ  GREEK-SMALL-EPSILON-DASIA-OXIA = DIA2(ε, dasia, oxia) script:Grek

# Capital epsilon with psili
Ἐ  GREEK-CAPITAL-EPSILON-PSILI = DIA(Ε, psili) script:Grek

# Capital epsilon with dasia
Ἑ  GREEK-CAPITAL-EPSILON-DASIA = DIA(Ε, dasia) script:Grek

# Capital epsilon with psili and varia
Ἒ  GREEK-CAPITAL-EPSILON-PSILI-VARIA = DIA2(Ε, psili, varia) script:Grek

# Capital epsilon with dasia and varia
Ἓ  GREEK-CAPITAL-EPSILON-DASIA-VARIA = DIA2(Ε, dasia, varia) script:Grek

# Capital epsilon with psili and oxia
Ἔ  GREEK-CAPITAL-EPSILON-PSILI-OXIA = DIA2(Ε, psili, oxia) script:Grek

# Capital epsilon with dasia and oxia
Ἕ  GREEK-CAPITAL-EPSILON-DASIA-OXIA = DIA2(Ε, dasia, oxia) script:Grek

# =============================================================================
# ETA WITH BREATHING MARKS (U+1F20-U+1F2F)
# =============================================================================

# Eta with psili
ἠ  GREEK-SMALL-ETA-PSILI = DIA(η, psili) script:Grek

# Eta with dasia
ἡ  GREEK-SMALL-ETA-DASIA = DIA(η, dasia) script:Grek

# Eta with psili and varia
ἢ  GREEK-SMALL-ETA-PSILI-VARIA = DIA2(η, psili, varia) script:Grek

# Eta with dasia and varia
ἣ  GREEK-SMALL-ETA-DASIA-VARIA = DIA2(η, dasia, varia) script:Grek

# Eta with psili and oxia
ἤ  GREEK-SMALL-ETA-PSILI-OXIA = DIA2(η, psili, oxia) script:Grek

# Eta with dasia and oxia
ἥ  GREEK-SMALL-ETA-DASIA-OXIA = DIA2(η, dasia, oxia) script:Grek

# Eta with psili and perispomeni
ἦ  GREEK-SMALL-ETA-PSILI-PERISPOMENI = DIA2(η, psili, perispomeni) script:Grek

# Eta with dasia and perispomeni
ἧ  GREEK-SMALL-ETA-DASIA-PERISPOMENI = DIA2(η, dasia, perispomeni) script:Grek

# Capital eta with psili
Ἠ  GREEK-CAPITAL-ETA-PSILI = DIA(Η, psili) script:Grek

# Capital eta with dasia
Ἡ  GREEK-CAPITAL-ETA-DASIA = DIA(Η, dasia) script:Grek

# Capital eta with psili and varia
Ἢ  GREEK-CAPITAL-ETA-PSILI-VARIA = DIA2(Η, psili, varia) script:Grek

# Capital eta with dasia and varia
Ἣ  GREEK-CAPITAL-ETA-DASIA-VARIA = DIA2(Η, dasia, varia) script:Grek

# Capital eta with psili and oxia
Ἤ  GREEK-CAPITAL-ETA-PSILI-OXIA = DIA2(Η, psili, oxia) script:Grek

# Capital eta with dasia and oxia
Ἥ  GREEK-CAPITAL-ETA-DASIA-OXIA = DIA2(Η, dasia, oxia) script:Grek

# Capital eta with psili and perispomeni
Ἦ  GREEK-CAPITAL-ETA-PSILI-PERISPOMENI = DIA2(Η, psili, perispomeni) script:Grek

# Capital eta with dasia and perispomeni
Ἧ  GREEK-CAPITAL-ETA-DASIA-PERISPOMENI = DIA2(Η, dasia, perispomeni) script:Grek

# =============================================================================
# IOTA WITH BREATHING MARKS (U+1F30-U+1F3F)
# =============================================================================

# Iota with psili
ἰ  GREEK-SMALL-IOTA-PSILI = DIA(ι, psili) script:Grek

# Iota with dasia
ἱ  GREEK-SMALL-IOTA-DASIA = DIA(ι, dasia) script:Grek

# Iota with psili and varia
ἲ  GREEK-SMALL-IOTA-PSILI-VARIA = DIA2(ι, psili, varia) script:Grek

# Iota with dasia and varia
ἳ  GREEK-SMALL-IOTA-DASIA-VARIA = DIA2(ι, dasia, varia) script:Grek

# Iota with psili and oxia
ἴ  GREEK-SMALL-IOTA-PSILI-OXIA = DIA2(ι, psili, oxia) script:Grek

# Iota with dasia and oxia
ἵ  GREEK-SMALL-IOTA-DASIA-OXIA = DIA2(ι, dasia, oxia) script:Grek

# Iota with psili and perispomeni
ἶ  GREEK-SMALL-IOTA-PSILI-PERISPOMENI = DIA2(ι, psili, perispomeni) script:Grek

# Iota with dasia and perispomeni
ἷ  GREEK-SMALL-IOTA-DASIA-PERISPOMENI = DIA2(ι, dasia, perispomeni) script:Grek

# Capital iota with psili
Ἰ  GREEK-CAPITAL-IOTA-PSILI = DIA(Ι, psili) script:Grek

# Capital iota with dasia
Ἱ  GREEK-CAPITAL-IOTA-DASIA = DIA(Ι, dasia) script:Grek

# Capital iota with psili and varia
Ἲ  GREEK-CAPITAL-IOTA-PSILI-VARIA = DIA2(Ι, psili, varia) script:Grek

# Capital iota with dasia and varia
Ἳ  GREEK-CAPITAL-IOTA-DASIA-VARIA = DIA2(Ι, dasia, varia) script:Grek

# Capital iota with psili and oxia
Ἴ  GREEK-CAPITAL-IOTA-PSILI-OXIA = DIA2(Ι, psili, oxia) script:Grek

# Capital iota with dasia and oxia
Ἵ  GREEK-CAPITAL-IOTA-DASIA-OXIA = DIA2(Ι, dasia, oxia) script:Grek

# Capital iota with psili and perispomeni
Ἶ  GREEK-CAPITAL-IOTA-PSILI-PERISPOMENI = DIA2(Ι, psili, perispomeni) script:Grek

# Capital iota with dasia and perispomeni
Ἷ  GREEK-CAPITAL-IOTA-DASIA-PERISPOMENI = DIA2(Ι, dasia, perispomeni) script:Grek

# =============================================================================
# OMICRON WITH BREATHING MARKS (U+1F40-U+1F4D)
# =============================================================================

# Omicron with psili
ὀ  GREEK-SMALL-OMICRON-PSILI = DIA(ο, psili) script:Grek

# Omicron with dasia
ὁ  GREEK-SMALL-OMICRON-DASIA = DIA(ο, dasia) script:Grek

# Omicron with psili and varia
ὂ  GREEK-SMALL-OMICRON-PSILI-VARIA = DIA2(ο, psili, varia) script:Grek

# Omicron with dasia and varia
ὃ  GREEK-SMALL-OMICRON-DASIA-VARIA = DIA2(ο, dasia, varia) script:Grek

# Omicron with psili and oxia
ὄ  GREEK-SMALL-OMICRON-PSILI-OXIA = DIA2(ο, psili, oxia) script:Grek

# Omicron with dasia and oxia
ὅ  GREEK-SMALL-OMICRON-DASIA-OXIA = DIA2(ο, dasia, oxia) script:Grek

# Capital omicron with psili
Ὀ  GREEK-CAPITAL-OMICRON-PSILI = DIA(Ο, psili) script:Grek

# Capital omicron with dasia
Ὁ  GREEK-CAPITAL-OMICRON-DASIA = DIA(Ο, dasia) script:Grek

# Capital omicron with psili and varia
Ὂ  GREEK-CAPITAL-OMICRON-PSILI-VARIA = DIA2(Ο, psili, varia) script:Grek

# Capital omicron with dasia and varia
Ὃ  GREEK-CAPITAL-OMICRON-DASIA-VARIA = DIA2(Ο, dasia, varia) script:Grek

# Capital omicron with psili and oxia
Ὄ  GREEK-CAPITAL-OMICRON-PSILI-OXIA = DIA2(Ο, psili, oxia) script:Grek

# Capital omicron with dasia and oxia
Ὅ  GREEK-CAPITAL-OMICRON-DASIA-OXIA = DIA2(Ο, dasia, oxia) script:Grek

# =============================================================================
# UPSILON WITH BREATHING MARKS (U+1F50-U+1F5F)
# =============================================================================
#
# Note: Capital upsilon only has dasia forms (no psili) in classical Greek
# because upsilon was always aspirated at word-initial position.
#
# =============================================================================

# Upsilon with psili
ὐ  GREEK-SMALL-UPSILON-PSILI = DIA(υ, psili) script:Grek

# Upsilon with dasia
ὑ  GREEK-SMALL-UPSILON-DASIA = DIA(υ, dasia) script:Grek

# Upsilon with psili and varia
ὒ  GREEK-SMALL-UPSILON-PSILI-VARIA = DIA2(υ, psili, varia) script:Grek

# Upsilon with dasia and varia
ὓ  GREEK-SMALL-UPSILON-DASIA-VARIA = DIA2(υ, dasia, varia) script:Grek

# Upsilon with psili and oxia
ὔ  GREEK-SMALL-UPSILON-PSILI-OXIA = DIA2(υ, psili, oxia) script:Grek

# Upsilon with dasia and oxia
ὕ  GREEK-SMALL-UPSILON-DASIA-OXIA = DIA2(υ, dasia, oxia) script:Grek

# Upsilon with psili and perispomeni
ὖ  GREEK-SMALL-UPSILON-PSILI-PERISPOMENI = DIA2(υ, psili, perispomeni) script:Grek

# Upsilon with dasia and perispomeni
ὗ  GREEK-SMALL-UPSILON-DASIA-PERISPOMENI = DIA2(υ, dasia, perispomeni) script:Grek

# Capital upsilon with dasia (no psili form exists)
Ὑ  GREEK-CAPITAL-UPSILON-DASIA = DIA(Υ, dasia) script:Grek

# Capital upsilon with dasia and varia
Ὓ  GREEK-CAPITAL-UPSILON-DASIA-VARIA = DIA2(Υ, dasia, varia) script:Grek

# Capital upsilon with dasia and oxia
Ὕ  GREEK-CAPITAL-UPSILON-DASIA-OXIA = DIA2(Υ, dasia, oxia) script:Grek

# Capital upsilon with dasia and perispomeni
Ὗ  GREEK-CAPITAL-UPSILON-DASIA-PERISPOMENI = DIA2(Υ, dasia, perispomeni) script:Grek

# =============================================================================
# OMEGA WITH BREATHING MARKS (U+1F60-U+1F6F)
# =============================================================================

# Omega with psili
ὠ  GREEK-SMALL-OMEGA-PSILI = DIA(ω, psili) script:Grek

# Omega with dasia
