@lsdl 1.0

# =============================================================================
# LSDL Superscripts and Subscripts Library
# =============================================================================
#
# This file defines superscript and subscript characters from the Unicode
# Superscripts and Subscripts block (U+2070-209F).
#
# Characters defined: 28
#   - Superscripts (13): U+2070, U+2074-U+207F (U+00B9, U+00B2, U+00B3 in Latin-1)
#   - Subscripts (15): U+2080-U+208E
#
# Approach:
#   - Superscripts: scale to ~58% (sx=7, sy=7) and shift up (dy=-1)
#   - Subscripts: scale to ~58% (sx=7, sy=7) and shift down (dy=5)
#   - Base forms reference digits.lsdl and ascii-punctuation.lsdl elements
#
# =============================================================================

# =============================================================================
# SUPERSCRIPTS (U+2070-207F)
# =============================================================================

U+2070 SUPERSCRIPT-ZERO = sh(sc(bowl.cap, sx=7, sy=7), dx=2, dy=-1) cp:U+2070

# U+00B9 SUPERSCRIPT-ONE - defined in Latin-1 Supplement (reference only)
# U+00B2 SUPERSCRIPT-TWO - defined in Latin-1 Supplement (reference only)
# U+00B3 SUPERSCRIPT-THREE - defined in Latin-1 Supplement (reference only)

U+2074 SUPERSCRIPT-FOUR = sh(sc(FRAME(digit.stem.four, digit.diag.four, digit.crossbar.four), sx=7, sy=7), dx=2, dy=-1) cp:U+2074

U+2075 SUPERSCRIPT-FIVE = sh(sc(FRAME(digit.bar.top.five, digit.stem.five, digit.arc.bot.five), sx=7, sy=7), dx=2, dy=-1) cp:U+2075

U+2076 SUPERSCRIPT-SIX = sh(sc(digit.curve.six, sx=7, sy=7), dx=2, dy=-1) cp:U+2076

U+2077 SUPERSCRIPT-SEVEN = sh(sc(FRAME(bar.top, diagonal.l), sx=7, sy=7), dx=2, dy=-1) cp:U+2077

U+2078 SUPERSCRIPT-EIGHT = sh(sc(STACK(digit.bowl.upper.eight, digit.bowl.lower.eight), sx=7, sy=7), dx=2, dy=-1) cp:U+2078

U+2079 SUPERSCRIPT-NINE = sh(sc(digit.curve.nine, sx=7, sy=7), dx=2, dy=-1) cp:U+2079

U+207A SUPERSCRIPT-PLUS-SIGN = sh(sc(OVR(punct.plus.vert, punct.plus.horiz), sx=7, sy=7), dx=2, dy=-1) cp:U+207A

U+207B SUPERSCRIPT-MINUS = sh(sc(punct.hyphen, sx=7, sy=7), dx=2, dy=-1) cp:U+207B

U+207C SUPERSCRIPT-EQUALS-SIGN = sh(sc(STACK(punct.equals.top, punct.equals.bot), sx=7, sy=7), dx=2, dy=-1) cp:U+207C

U+207D SUPERSCRIPT-LEFT-PARENTHESIS = sh(sc(punct.paren.left, sx=7, sy=7), dx=2, dy=-1) cp:U+207D

U+207E SUPERSCRIPT-RIGHT-PARENTHESIS = sh(sc(punct.paren.right, sx=7, sy=7), dx=2, dy=-1) cp:U+207E

U+207F SUPERSCRIPT-LATIN-SMALL-LETTER-N = sh(sc(FRAME(stem, shoulder), sx=7, sy=7), dx=2, dy=-1) cp:U+207F

# =============================================================================
# SUBSCRIPTS (U+2080-208E)
# =============================================================================

U+2080 SUBSCRIPT-ZERO = sh(sc(bowl.cap, sx=7, sy=7), dx=2, dy=5) cp:U+2080

U+2081 SUBSCRIPT-ONE = sh(sc(FRAME(flag.cap, stem.r), sx=7, sy=7), dx=2, dy=5) cp:U+2081

U+2082 SUBSCRIPT-TWO = sh(sc(FRAME(digit.arc.top.two, digit.stem.two, bar.bot.cap), sx=7, sy=7), dx=2, dy=5) cp:U+2082

U+2083 SUBSCRIPT-THREE = sh(sc(STACK(digit.arc.upper.three, digit.arc.lower.three), sx=7, sy=7), dx=2, dy=5) cp:U+2083

U+2084 SUBSCRIPT-FOUR = sh(sc(FRAME(digit.stem.four, digit.diag.four, digit.crossbar.four), sx=7, sy=7), dx=2, dy=5) cp:U+2084

U+2085 SUBSCRIPT-FIVE = sh(sc(FRAME(digit.bar.top.five, digit.stem.five, digit.arc.bot.five), sx=7, sy=7), dx=2, dy=5) cp:U+2085

U+2086 SUBSCRIPT-SIX = sh(sc(digit.curve.six, sx=7, sy=7), dx=2, dy=5) cp:U+2086

U+2087 SUBSCRIPT-SEVEN = sh(sc(FRAME(bar.top, diagonal.l), sx=7, sy=7), dx=2, dy=5) cp:U+2087

U+2088 SUBSCRIPT-EIGHT = sh(sc(STACK(digit.bowl.upper.eight, digit.bowl.lower.eight), sx=7, sy=7), dx=2, dy=5) cp:U+2088

U+2089 SUBSCRIPT-NINE = sh(sc(digit.curve.nine, sx=7, sy=7), dx=2, dy=5) cp:U+2089

U+208A SUBSCRIPT-PLUS-SIGN = sh(sc(OVR(punct.plus.vert, punct.plus.horiz), sx=7, sy=7), dx=2, dy=5) cp:U+208A

U+208B SUBSCRIPT-MINUS = sh(sc(punct.hyphen, sx=7, sy=7), dx=2, dy=5) cp:U+208B

U+208C SUBSCRIPT-EQUALS-SIGN = sh(sc(STACK(punct.equals.top, punct.equals.bot), sx=7, sy=7), dx=2, dy=5) cp:U+208C

U+208D SUBSCRIPT-LEFT-PARENTHESIS = sh(sc(punct.paren.left, sx=7, sy=7), dx=2, dy=5) cp:U+208D

U+208E SUBSCRIPT-RIGHT-PARENTHESIS = sh(sc(punct.paren.right, sx=7, sy=7), dx=2, dy=5) cp:U+208E

# =============================================================================
# END OF SUPERSCRIPTS AND SUBSCRIPTS LIBRARY
# =============================================================================
