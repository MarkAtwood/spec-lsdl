p1 = [2,4]
p2 = [2,8]
p3 = [6,6]
p4 = [10,8]
p5 = [10,4]
close: false
width: 1
anchors: top=[6,4] base=[6,8]
@end

# -----------------------------------------------------------------------------
# reversed-dze - Mirrored Dze form
# -----------------------------------------------------------------------------
@elem reversed-dze.cap
zone: cap
path: p1 p2 p3 p4 p5
p1 = [2,0]
p2 = C([2,2] [6,3])
p3 = [6,4]
p4 = C([6,5] [10,6])
p5 = [10,8]
close: false
width: 1
anchors: top=[6,0] base=[6,8] mark-above=[6,0]
@end

@elem reversed-dze.x
