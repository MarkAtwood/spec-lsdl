p2 = [6,4]
p3 = [12,8]
p4 = [2,6]
p5 = [10,6]
p6 = [6,4]
close: false
width: 1
anchors: top=[6,4] base=[6,8]
@end

# -----------------------------------------------------------------------------
# blended-yus - Intermediate Yus form
