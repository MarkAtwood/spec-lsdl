# =============================================================================
# MODIFIER LETTERS AND PUNCTUATION (U+A673-A67F, U+A69C-A69D)
# =============================================================================
# These are not letters with case pairs but belong to this block.

# U+A673 Slavonic Asterisk - punctuation mark
꙳  SLAVONIC-ASTERISK = FRAME(diagonal.x, diagonal.x.rev, stroke.horiz) script:Cyrl ortho:OCS
  # Asterisk used in Slavonic manuscripts

# U+A67E Cyrillic Kavyka - punctuation mark
꙾  CYRILLIC-KAVYKA = comma.shape script:Cyrl ortho:OCS
  # Kavyka - comma-like punctuation

# U+A67F Cyrillic Payerok - modifier letter (indicates omission)
ꙿ  CYRILLIC-PAYEROK = arc.top script:Cyrl ortho:OCS
  # Payerok - modifier indicating letter omission

# U+A69C Modifier letter Cyrillic Hard Sign
ꚜ  MODIFIER-LETTER-CYRILLIC-HARD-SIGN = neutral-yer.x script:Cyrl ortho:OCS
  # Superscript hard sign modifier

# U+A69D Modifier letter Cyrillic Soft Sign
ꚝ  MODIFIER-LETTER-CYRILLIC-SOFT-SIGN = soft-sign.base script:Cyrl ortho:OCS
  # Superscript soft sign modifier

# =============================================================================
# COMBINING MARKS (U+A66F-A67D, U+A69E-A69F)
# =============================================================================
# Note: Combining marks are diacritics, not base letters.
# They are defined here for completeness but typically used via DIA operator.
#
# U+A66F COMBINING CYRILLIC VZMET - titlo-like mark
# U+A670 COMBINING CYRILLIC TEN MILLIONS SIGN
# U+A671 COMBINING CYRILLIC HUNDRED MILLIONS SIGN
# U+A672 COMBINING CYRILLIC THOUSAND MILLIONS SIGN
# U+A674 COMBINING CYRILLIC LETTER UKRAINIAN IE
# U+A675 COMBINING CYRILLIC LETTER I
# U+A676 COMBINING CYRILLIC LETTER YI
# U+A677 COMBINING CYRILLIC LETTER U
# U+A678 COMBINING CYRILLIC LETTER HARD SIGN
# U+A679 COMBINING CYRILLIC LETTER YERU
# U+A67A COMBINING CYRILLIC LETTER SOFT SIGN
# U+A67B COMBINING CYRILLIC LETTER OMEGA
# U+A67C COMBINING CYRILLIC KAVYKA
# U+A67D COMBINING CYRILLIC PAYEROK
# U+A69E COMBINING CYRILLIC LETTER EF
# U+A69F COMBINING CYRILLIC LETTER IOTIFIED E
#
# These combining marks would require diacritic element definitions.
# For now, they are documented but not rendered as base characters.

# =============================================================================
# END OF CYRILLIC EXTENDED-B LIBRARY
# =============================================================================
