@lsdl 1.0

# =============================================================================
# LSDL Cyrillic Extended-B Library (U+A640-A69F)
# =============================================================================
#
# Old Church Slavonic and historical Cyrillic characters.
# This block contains 96 code points used in medieval manuscripts,
# liturgical texts, and scholarly editions of historical Slavic documents.
#
# Key letterforms:
#   - Zemlya (Ꙁ/ꙁ) - alternative form of Ze
#   - Dzelo (Ꙃ/ꙃ) - historical Dz sound
#   - Reversed Ze (Ꙅ/ꙅ) - mirrored form
#   - Iota (Ꙇ/ꙇ) - Greek-derived vowel
#   - Djerv (Ꙉ/ꙉ) - South Slavic consonant
#   - Monograph Uk (Ꙋ/ꙋ) - single-letter form of digraph
#   - Yat variants (Ꙗ/ꙗ) - iotified forms
#   - Little Yus / Big Yus variants - nasal vowels
#   - Fita / Izhitsa variants
#
# All characters tagged with script:Cyrl and ortho:OCS (Old Church Slavonic)
#
# =============================================================================

# =============================================================================
# CASE MAPPINGS (U+A640-A69F)
# =============================================================================

@case Ꙁ ꙁ
@case Ꙃ ꙃ
@case Ꙅ ꙅ
@case Ꙇ ꙇ
@case Ꙉ ꙉ
@case Ꙋ ꙋ
@case Ꙍ ꙍ
@case Ꙏ ꙏ
@case Ꙑ ꙑ
@case Ꙓ ꙓ
@case Ꙕ ꙕ
@case Ꙗ ꙗ
@case Ꙙ ꙙ
@case Ꙛ ꙛ
@case Ꙝ ꙝ
@case Ꙟ ꙟ
@case Ꙡ ꙡ
@case Ꙣ ꙣ
@case Ꙥ ꙥ
@case Ꙧ ꙧ
@case Ꙩ ꙩ
@case Ꙫ ꙫ
@case Ꙭ ꙭ
@case Ꚁ ꚁ
@case Ꚃ ꚃ
@case Ꚅ ꚅ
@case Ꚇ ꚇ
@case Ꚉ ꚉ
@case Ꚋ ꚋ
@case Ꚍ ꚍ
@case Ꚏ ꚏ
@case Ꚑ ꚑ
@case Ꚓ ꚓ
@case Ꚕ ꚕ
@case Ꚗ ꚗ
@case Ꚙ ꚙ
@case Ꚛ ꚛ

# =============================================================================
# LOCAL ELEMENT DEFINITIONS
# =============================================================================

# -----------------------------------------------------------------------------
# zemlya.stroke - Z-like stroke for Zemlya letter
# Distinctive s-curve form different from standard Ze
# -----------------------------------------------------------------------------
@elem zemlya.stroke
zone: cap
path: p1 p2 p3 p4 p5
p1 = [2,0]
p2 = [10,0]
p3 = [2,8]
p4 = [10,8]
p5 = [10,8]
close: false
width: 1
anchors: top=[6,0] base=[6,8] mark-above=[6,0]
@end

@elem zemlya.stroke.x
zone: x-height
path: p1 p2 p3 p4
p1 = [2,4]
p2 = [10,4]
p3 = [2,8]
p4 = [10,8]
close: false
width: 1
anchors: top=[6,4] base=[6,8]
@end

# -----------------------------------------------------------------------------
# dzelo.form - Unique form for Dzelo (like reversed S with tail)
# -----------------------------------------------------------------------------
@elem dzelo.cap
zone: cap
path: p1 p2 p3 p4 p5 p6
p1 = [10,0]
p2 = C([2,0] [2,2])
p3 = [6,4]
p4 = C([10,6] [10,8])
p5 = [2,8]
p6 = [2,10]
close: false
width: 1
anchors: top=[6,0] base=[2,10] mark-above=[6,0]
@end

@elem dzelo.x
zone: x-height
path: p1 p2 p3 p4 p5
p1 = [10,4]
p2 = C([2,4] [2,5])
p3 = [6,6]
p4 = C([10,7] [10,8])
p5 = [2,8]
close: false
width: 1
anchors: top=[6,4] base=[6,8]
@end

# -----------------------------------------------------------------------------
# reversed-ze.cap - Left-facing Ze curves (mirror of standard Ze)
# -----------------------------------------------------------------------------
@elem reversed-ze.cap
zone: cap
path: p1 p2 p3 p4 p5
p1 = [10,0]
p2 = C([10,0] [6,0])
p3 = C([2,2] [2,4])
p4 = C([2,6] [6,8])
p5 = C([10,8] [10,8])
close: false
width: 1
anchors: top=[6,0] base=[6,8] mark-above=[6,0]
@end

@elem reversed-ze.x
zone: x-height
path: p1 p2 p3 p4 p5
p1 = [10,4]
p2 = C([10,4] [6,4])
p3 = C([2,5] [2,6])
p4 = C([2,7] [6,8])
p5 = C([10,8] [10,8])
close: false
width: 1
anchors: top=[6,4] base=[6,8]
@end

# -----------------------------------------------------------------------------
# djerv.form - Unique South Slavic letter form
# Like soft sign with diagonal stroke through it
# -----------------------------------------------------------------------------
@elem djerv.cap
zone: cap
path: p1 p2 p3 p4 p5
p1 = [4,0]
p2 = [4,8]
p3 = C([4,8] [10,8])
p4 = C([10,5] [4,5])
p5 = [10,0]
close: false
width: 1
anchors: top=[4,0] base=[4,8] mark-above=[4,0]
@end

@elem djerv.x
zone: x-height
path: p1 p2 p3 p4 p5
p1 = [4,4]
p2 = [4,8]
p3 = C([4,8] [10,8])
p4 = C([10,6] [4,6])
p5 = [10,4]
close: false
width: 1
anchors: top=[4,4] base=[4,8]
@end

# -----------------------------------------------------------------------------
# monograph-uk - Single letter form of Uk digraph
# Combines O and Y-like forms into single glyph
# -----------------------------------------------------------------------------
@elem monograph-uk.cap
zone: cap
path: p1 p2 p3 p4 p5 p6 p7
p1 = [2,0]
p2 = C([0,0] [0,4])
p3 = C([0,8] [2,8])
p4 = [6,4]
p5 = [10,8]
p6 = C([12,4] [10,0])
p7 = [10,0]
close: false
width: 1
anchors: top=[6,0] base=[6,8] mark-above=[6,0]
@end

@elem monograph-uk.x
zone: x-height
path: p1 p2 p3 p4 p5 p6
p1 = [2,4]
p2 = C([0,4] [0,6])
p3 = C([0,8] [2,8])
p4 = [6,6]
p5 = [10,8]
p6 = C([12,6] [10,4])
close: false
width: 1
anchors: top=[6,4] base=[6,8]
@end

# -----------------------------------------------------------------------------
# broad-omega - Wide omega form for OCS
# -----------------------------------------------------------------------------
@elem broad-omega.cap
zone: cap
path: p1 p2 p3 p4 p5 p6 p7
p1 = [0,0]
p2 = [0,6]
p3 = C([0,8] [3,8])
p4 = [6,6]
p5 = C([9,8] [12,8])
p6 = [12,6]
p7 = [12,0]
close: false
width: 1
anchors: top=[6,0] base=[6,8] mark-above=[6,0]
@end

@elem broad-omega.x
zone: x-height
path: p1 p2 p3 p4 p5 p6 p7
p1 = [0,4]
p2 = [0,7]
p3 = C([0,8] [3,8])
p4 = [6,7]
p5 = C([9,8] [12,8])
p6 = [12,7]
p7 = [12,4]
close: false
width: 1
anchors: top=[6,4] base=[6,8]
@end

# -----------------------------------------------------------------------------
# yat-iotified - Iotified Yat letter form
# I + yat ligature for OCS
# -----------------------------------------------------------------------------
@elem soft-sign.base
zone: x-height
path: p1 p2 p3 p4
p1 = [2,4]
p2 = [2,8]
p3 = C([2,8] [8,8])
p4 = C([8,6] [2,6])
close: true
width: 1
anchors: top=[2,4] base=[2,8] attach=[5,7]
  mark-above=[2,3] mark-below=[5,9]
@end

@elem yat.cap
zone: cap
path: p1 p2 p3 p4 p5 p6
p1 = [6,0]
p2 = [6,8]
p3 = C([6,8] [10,8])
p4 = C([10,6] [6,6])
p5 = [2,0]
p6 = [10,0]
close: false
width: 1
anchors: top=[6,0] base=[6,8] mark-above=[6,0]
@end

@elem yat.x
zone: x-height
path: p1 p2 p3 p4 p5 p6
p1 = [6,4]
p2 = [6,8]
p3 = C([6,8] [10,8])
p4 = C([10,6] [6,6])
p5 = [4,4]
p6 = [8,4]
close: false
width: 1
anchors: top=[6,4] base=[6,8]
@end

# -----------------------------------------------------------------------------
# neutral-yer - Historical reduced vowel
# -----------------------------------------------------------------------------
@elem neutral-yer.cap
zone: cap
path: p1 p2 p3 p4
p1 = [2,0]
p2 = [2,8]
p3 = C([2,8] [8,8])
p4 = C([8,4] [2,4])
close: false
width: 1
anchors: top=[2,0] base=[2,8] mark-above=[2,0]
@end

@elem neutral-yer.x
zone: x-height
path: p1 p2 p3 p4
p1 = [2,4]
p2 = [2,8]
p3 = C([2,8] [8,8])
p4 = C([8,6] [2,6])
close: false
width: 1
anchors: top=[2,4] base=[2,8]
@end

