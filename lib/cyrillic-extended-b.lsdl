path: p1 p2 p3 p4 p5
p1 = [0,8]
p2 = [6,0]
p3 = [12,8]
p4 = [2,4]
p5 = [10,4]
close: false
width: 1
anchors: top=[6,0] base=[6,8] mark-above=[6,0]
@end

@elem little-yus.x
