path: p1 p2 p3 p4 p5
p1 = [2,4]
p2 = C([2,5] [6,5])
p3 = [6,6]
p4 = C([6,7] [10,7])
p5 = [10,8]
close: false
width: 1
anchors: top=[6,4] base=[6,8]
@end

# -----------------------------------------------------------------------------
# iotified-a - Iotified A form
# -----------------------------------------------------------------------------
@elem iotified-a.cap
zone: cap
path: p1 p2 p3 p4 p5 p6 p7
p1 = [0,0]
p2 = [0,8]
p3 = [4,8]
p4 = C([4,8] [10,8])
p5 = C([10,6] [4,6])
p6 = [4,0]
p7 = [4,8]
close: false
width: 1
anchors: top=[2,0] base=[4,8] mark-above=[2,0]
@end

@elem iotified-a.x
zone: x-height
path: p1 p2 p3 p4 p5 p6 p7
p1 = [0,4]
p2 = [0,8]
p3 = [4,8]
p4 = C([4,8] [10,8])
p5 = C([10,6] [4,6])
p6 = [4,4]
p7 = [4,8]
close: false
width: 1
anchors: top=[2,4] base=[4,8]
@end

# -----------------------------------------------------------------------------
# crossed-o - O with cross inside
# -----------------------------------------------------------------------------
@elem crossed-o.cap
zone: cap
path: p1 p2 p3 p4 p5 p6 p7 p8 p9
p1 = [6,0]
p2 = C([12,0] [12,4])
p3 = C([12,8] [6,8])
p4 = C([0,8] [0,4])
p5 = C([0,0] [6,0])
p6 = [6,8]
p7 = [6,0]
p8 = [0,4]
p9 = [12,4]
close: false
width: 1
anchors: top=[6,0] base=[6,8] mark-above=[6,0]
@end

@elem crossed-o.x
zone: x-height
path: p1 p2 p3 p4 p5 p6 p7 p8 p9
p1 = [6,4]
p2 = C([12,4] [12,6])
p3 = C([12,8] [6,8])
p4 = C([0,8] [0,6])
p5 = C([0,4] [6,4])
p6 = [6,8]
p7 = [6,4]
p8 = [0,6]
p9 = [12,6]
close: false
width: 1
anchors: top=[6,4] base=[6,8]
@end

# -----------------------------------------------------------------------------
# monocular-o - O with single dot inside
# -----------------------------------------------------------------------------
@elem monocular-o.cap
zone: cap
path: p1 p2 p3 p4 p5 p6
p1 = [6,0]
p2 = C([12,0] [12,4])
p3 = C([12,8] [6,8])
p4 = C([0,8] [0,4])
p5 = C([0,0] [6,0])
p6 = [6,4]
close: false
width: 1
anchors: top=[6,0] base=[6,8] mark-above=[6,0]
@end

# -----------------------------------------------------------------------------
# binocular-o - O with two dots inside
# -----------------------------------------------------------------------------
@elem binocular-o.cap
zone: cap
path: p1 p2 p3 p4 p5 p6 p7
p1 = [6,0]
p2 = C([12,0] [12,4])
p3 = C([12,8] [6,8])
p4 = C([0,8] [0,4])
p5 = C([0,0] [6,0])
p6 = [4,4]
p7 = [8,4]
close: false
width: 1
anchors: top=[6,0] base=[6,8] mark-above=[6,0]
@end

# -----------------------------------------------------------------------------
# multiocular-o - O with multiple dots/eyes (rare symbol)
# -----------------------------------------------------------------------------
@elem multiocular-o.cap
zone: cap
path: p1 p2 p3 p4 p5 p6 p7 p8 p9
p1 = [6,0]
p2 = C([12,0] [12,4])
p3 = C([12,8] [6,8])
p4 = C([0,8] [0,4])
p5 = C([0,0] [6,0])
p6 = [4,3]
p7 = [8,3]
p8 = [4,5]
p9 = [8,5]
close: false
width: 1
anchors: top=[6,0] base=[6,8] mark-above=[6,0]
@end

# -----------------------------------------------------------------------------
# stem.l - Left-positioned stem (for capital letters)
# -----------------------------------------------------------------------------
@elem stem.l
zone: cap
path: p1 p2
p1 = [2,0]
p2 = [2,8]
close: false
width: 1
anchors: top=[2,0] base=[2,8] mid=[2,4]
  arm.right=[4,4] mark-above=[2,0] mark-below=[2,9]
  top-serif=[2,0] bot-serif=[2,8]
@end

# -----------------------------------------------------------------------------
# stem.r - Right-positioned stem (for capital letters)
# -----------------------------------------------------------------------------
@elem stem.r
zone: cap
path: p1 p2
p1 = [10,0]
p2 = [10,8]
close: false
width: 1
anchors: top=[10,0] base=[10,8] mid=[10,4]
  arm.left=[8,4] mark-above=[10,0] mark-below=[10,9]
  top-serif=[10,0] bot-serif=[10,8]
@end

# -----------------------------------------------------------------------------
# stem - Vertical straight stroke for x-height
# -----------------------------------------------------------------------------
@elem stem
zone: x-height
path: p1 p2
p1 = [6,4]
p2 = [6,8]
close: false
width: 1
anchors: top=[6,4] base=[6,8] mid=[6,6]
  arm.left=[0,6] arm.right=[12,6]
  mark-above=[6,3] mark-below=[6,9]
  top-serif=[6,3] bot-serif=[6,9]
@end

# -----------------------------------------------------------------------------
# crossbar.cap - Capital-height crossbar
# -----------------------------------------------------------------------------
@elem crossbar.cap
zone: cap
path: p1 p2
p1 = [2,4]
p2 = [10,4]
close: false
width: 1
anchors: left=[2,4] right=[10,4] mid=[6,4]
@end

# -----------------------------------------------------------------------------
# crossbar - X-height crossbar
# -----------------------------------------------------------------------------
@elem crossbar
zone: x-height
path: p1 p2
p1 = [2,6]
p2 = [10,6]
close: false
width: 1
anchors: left=[2,6] right=[10,6] mid=[6,6]
@end

# -----------------------------------------------------------------------------
# iota.cap - Iota form (Greek-derived)
# -----------------------------------------------------------------------------
@elem iota.cap
zone: cap
path: p1 p2
p1 = [6,0]
p2 = [6,8]
close: false
width: 1
anchors: top=[6,0] base=[6,8] mark-above=[6,0]
@end

@elem iota.x
zone: x-height
path: p1 p2
p1 = [6,4]
p2 = [6,8]
close: false
width: 1
anchors: top=[6,4] base=[6,8]
@end

# -----------------------------------------------------------------------------
# tittle - Dot above for lowercase letters
# -----------------------------------------------------------------------------
@elem tittle
zone: x-height
path: p1 p2 p3 p4
p1 = [6,2]
p2 = C([7,2] [7,3])
p3 = C([7,4] [6,4])
p4 = C([5,4] [5,3])
close: true
width: 1
anchors: attach=[6,3] base=[6,4]
  mark-above=[6,1]
@end

# -----------------------------------------------------------------------------
# el-tail - L with tail extension
# -----------------------------------------------------------------------------
@elem el-tail.cap
zone: cap
path: p1 p2 p3 p4
p1 = [0,8]
p2 = [6,0]
p3 = [12,8]
p4 = [12,10]
close: false
width: 1
anchors: top=[6,0] base=[12,10] mark-above=[6,0]
@end

@elem el-tail.x
zone: x-height
path: p1 p2 p3 p4
p1 = [0,8]
p2 = [6,4]
p3 = [12,8]
p4 = [12,10]
close: false
width: 1
anchors: top=[6,4] base=[12,10]
@end

# -----------------------------------------------------------------------------
# tail.cyr - Cyrillic descending tail
# -----------------------------------------------------------------------------
@elem tail.cyr
zone: descender
path: p1 p2 p3
p1 = [10,8]
p2 = [10,10]
p3 = [8,10]
close: false
width: 1
anchors: attach=[10,8] base=[10,10]
@end

# -----------------------------------------------------------------------------
# hook.desc.cyr - Descending hook
# -----------------------------------------------------------------------------
@elem hook.desc.cyr
zone: descender
path: p1 p2 p3
p1 = [6,8]
p2 = [6,10]
p3 = C([6,10] [4,10])
close: false
width: 1
anchors: attach=[6,8] base=[4,10]
@end

# -----------------------------------------------------------------------------
# e-iotified - E with preceding I-element
# -----------------------------------------------------------------------------
@elem e-iotified.cap
zone: cap
path: p1 p2 p3 p4 p5 p6
p1 = [0,0]
p2 = [0,8]
p3 = [10,4]
p4 = C([10,0] [6,0])
p5 = [4,4]
p6 = C([4,8] [10,8])
close: false
width: 1
anchors: top=[2,0] base=[6,8] mark-above=[2,0]
@end

@elem e-iotified.x
zone: x-height
path: p1 p2 p3 p4 p5 p6
p1 = [0,4]
p2 = [0,8]
p3 = [10,6]
p4 = C([10,4] [6,4])
p5 = [4,6]
p6 = C([4,8] [10,8])
close: false
width: 1
anchors: top=[2,4] base=[6,8]
@end

# -----------------------------------------------------------------------------
# ha-hook - Ha with descending hook
# -----------------------------------------------------------------------------
@elem ha-hook.cap
zone: cap
path: p1 p2 p3 p4 p5
p1 = [0,0]
p2 = [12,8]
p3 = [12,0]
p4 = [0,8]
p5 = [6,10]
close: false
width: 1
anchors: top=[6,0] base=[6,10] mark-above=[6,0]
@end

@elem ha-hook.x
zone: x-height
path: p1 p2 p3 p4 p5
p1 = [0,4]
p2 = [12,8]
p3 = [12,4]
p4 = [0,8]
p5 = [6,10]
close: false
width: 1
anchors: top=[6,4] base=[6,10]
@end

# =============================================================================
# CYRILLIC EXTENDED-B CAPITAL LETTERS (U+A640-A69E odd code points)
# =============================================================================

Ꙁ  CYRILLIC-CAPITAL-ZEMLYA = zemlya.stroke script:Cyrl ortho:OCS
  # Zemlya - alternate form of Ze, z-like shape

Ꙃ  CYRILLIC-CAPITAL-DZELO = dzelo.cap script:Cyrl ortho:OCS
  # Dzelo - historical letter for /dz/ sound

Ꙅ  CYRILLIC-CAPITAL-REVERSED-DZE = reversed-ze.cap script:Cyrl ortho:OCS
  # Reversed Dze - mirrored S-like form

Ꙇ  CYRILLIC-CAPITAL-IOTA = iota.cap script:Cyrl ortho:OCS
  # Iota - Greek-derived vowel, simple vertical stroke

Ꙉ  CYRILLIC-CAPITAL-DJERV = djerv.cap script:Cyrl ortho:OCS
  # Djerv - South Slavic letter for /dj/ sound

Ꙋ  CYRILLIC-CAPITAL-MONOGRAPH-UK = monograph-uk.cap script:Cyrl ortho:OCS
  # Monograph Uk - single-letter form of Uk digraph

Ꙍ  CYRILLIC-CAPITAL-BROAD-OMEGA = broad-omega.cap script:Cyrl ortho:OCS
  # Broad Omega - wide omega variant

Ꙏ  CYRILLIC-CAPITAL-NEUTRAL-YER = neutral-yer.cap script:Cyrl ortho:OCS
  # Neutral Yer - reduced vowel form

Ꙑ  CYRILLIC-CAPITAL-YERU-BACK-YER = FRAME(soft-sign.base, stem.r) script:Cyrl ortho:OCS
  # Yeru with back yer - historical yery variant

Ꙓ  CYRILLIC-CAPITAL-IOTIFIED-YAT = LR(stem.l, yat.cap) script:Cyrl ortho:OCS
  # Iotified Yat - I + Yat ligature

Ꙕ  CYRILLIC-CAPITAL-REVERSED-YU = FRAME(stem.r, crossbar.cap, LR(bowl.l.upper.cap, bowl.l.upper.cap)) script:Cyrl ortho:OCS
  # Reversed Yu - mirrored form

Ꙗ  CYRILLIC-CAPITAL-IOTIFIED-A = iotified-a.cap script:Cyrl ortho:OCS
  # Iotified A - I + A ligature, common in OCS

Ꙙ  CYRILLIC-CAPITAL-CLOSED-LITTLE-YUS = closed-little-yus.cap script:Cyrl ortho:OCS
  # Closed Little Yus - variant with closed top

Ꙛ  CYRILLIC-CAPITAL-BLENDED-YUS = blended-yus.cap script:Cyrl ortho:OCS
  # Blended Yus - intermediate yus form

Ꙝ  CYRILLIC-CAPITAL-IOTIFIED-CLOSED-LITTLE-YUS = LR(stem.l, closed-little-yus.cap) script:Cyrl ortho:OCS
  # Iotified Closed Little Yus - I + closed little yus

Ꙟ  CYRILLIC-CAPITAL-YN = yn.cap script:Cyrl ortho:OCS
  # Yn - historical letter form

Ꙡ  CYRILLIC-CAPITAL-REVERSED-TSE = FRAME(stem.l, crossbar.cap, stem.r, hook.desc.cyr) script:Cyrl ortho:OCS
  # Reversed Tse - mirrored tse form

Ꙣ  CYRILLIC-CAPITAL-SOFT-DE = FRAME(djerv.cap, hook.desc.cyr) script:Cyrl ortho:OCS
  # Soft De - palatalized de variant

Ꙥ  CYRILLIC-CAPITAL-SOFT-EL = el-tail.cap script:Cyrl ortho:OCS
  # Soft El - El with tail modification

Ꙧ  CYRILLIC-CAPITAL-SOFT-EM = FRAME(stem.l, vertex.cap.inv, stem.r, hook.desc.cyr) script:Cyrl ortho:OCS
  # Soft Em - Em with tail modification

Ꙩ  CYRILLIC-CAPITAL-MONOCULAR-O = monocular-o.cap script:Cyrl ortho:OCS
  # Monocular O - O with single eye/dot

Ꙫ  CYRILLIC-CAPITAL-BINOCULAR-O = binocular-o.cap script:Cyrl ortho:OCS
  # Binocular O - O with two eyes/dots

Ꙭ  CYRILLIC-CAPITAL-DOUBLE-MONOCULAR-O = LR(monocular-o.cap, monocular-o.cap) script:Cyrl ortho:OCS
  # Double Monocular O - two monocular O forms joined

# U+A66E is CYRILLIC-LETTER-MULTIOCULAR-O (caseless)
ꙮ  CYRILLIC-LETTER-MULTIOCULAR-O = multiocular-o.cap script:Cyrl ortho:OCS
  # Multiocular O - O with many eyes (rare liturgical symbol)

# U+A670-A67D are combining marks, not letters
# U+A67E is CYRILLIC-KAVYKA (modifier letter)
# U+A67F is CYRILLIC-PAYEROK (modifier letter)

Ꚁ  CYRILLIC-CAPITAL-DWE = FRAME(djerv.cap, broad-omega.cap) script:Cyrl ortho:OCS
  # Dwe - historical letter

Ꚃ  CYRILLIC-CAPITAL-DZWE = FRAME(dzelo.cap, broad-omega.cap) script:Cyrl ortho:OCS
  # Dzwe - historical letter

Ꚅ  CYRILLIC-CAPITAL-ZHWE = FRAME(stem.l, STACK(leg.cap, leg.cap.rev), stem.r, broad-omega.cap) script:Cyrl ortho:OCS
  # Zhwe - historical letter

Ꚇ  CYRILLIC-CAPITAL-CCHE = FRAME(hook.cyr, stem.r, stem.r) script:Cyrl ortho:OCS
  # Cche - double che form

Ꚉ  CYRILLIC-CAPITAL-DZZE = FRAME(dzelo.cap, dzelo.cap) script:Cyrl ortho:OCS
  # Dzze - doubled dzelo

Ꚋ  CYRILLIC-CAPITAL-TE-MIDDLE-HOOK = FRAME(bar.top, stem.l, hook.desc.cyr) script:Cyrl ortho:OCS
  # Te with middle hook - variant te form

Ꚍ  CYRILLIC-CAPITAL-TWE = FRAME(FRAME(bar.top, stem.l), broad-omega.cap) script:Cyrl ortho:OCS
  # Twe - historical letter

Ꚏ  CYRILLIC-CAPITAL-TSWE = FRAME(stem.l, crossbar.cap, stem.r, tail.cyr, broad-omega.cap) script:Cyrl ortho:OCS
  # Tswe - historical letter

Ꚑ  CYRILLIC-CAPITAL-TSSE = FRAME(FRAME(bar.top, stem.l), FRAME(stem.r, crossbar.cap, stem.r, tail.cyr)) script:Cyrl ortho:OCS
  # Tsse - te and tse-tse ligature

Ꚓ  CYRILLIC-CAPITAL-TCHE = FRAME(FRAME(bar.top, stem.l), FRAME(hook.cyr, stem.r)) script:Cyrl ortho:OCS
  # Tche - te and che ligature

Ꚕ  CYRILLIC-CAPITAL-HWE = ha-hook.cap script:Cyrl ortho:OCS
  # Hwe - ha with hook

Ꚗ  CYRILLIC-CAPITAL-SHWE = FRAME(stem.l, crossbar.cap, stem.l, stem.r, broad-omega.cap) script:Cyrl ortho:OCS
  # Shwe - sha with omega

Ꚙ  CYRILLIC-CAPITAL-DOUBLE-O = LR(crossed-o.cap, crossed-o.cap) script:Cyrl ortho:OCS
  # Double O - two crossed O forms

Ꚛ  CYRILLIC-CAPITAL-CROSSED-O = crossed-o.cap script:Cyrl ortho:OCS
  # Crossed O - O with internal cross

