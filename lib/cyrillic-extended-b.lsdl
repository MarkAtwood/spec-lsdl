@elem blended-yus.cap
zone: cap
path: p1 p2 p3 p4 p5 p6
p1 = [0,8]
p2 = [6,0]
p3 = [12,8]
p4 = [2,4]
p5 = [10,4]
p6 = [6,8]
close: false
width: 1
anchors: top=[6,0] base=[6,8] mark-above=[6,0]
@end

@elem blended-yus.x
zone: x-height
path: p1 p2 p3 p4 p5 p6
p1 = [0,8]
p2 = [6,4]
p3 = [12,8]
p4 = [2,6]
p5 = [10,6]
p6 = [6,8]
close: false
width: 1
anchors: top=[6,4] base=[6,8]
@end

# -----------------------------------------------------------------------------
# yn - Historical letter form
# -----------------------------------------------------------------------------
@elem yn.cap
zone: cap
path: p1 p2 p3 p4 p5
p1 = [2,0]
p2 = [2,8]
p3 = [6,4]
p4 = [10,8]
p5 = [10,0]
close: false
width: 1
anchors: top=[6,0] base=[6,8] mark-above=[6,0]
@end

@elem yn.x
