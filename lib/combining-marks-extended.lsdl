@lsdl 1.0

# =============================================================================
# LSDL Combining Diacritical Marks Extended Library
# =============================================================================
#
# Coverage of Unicode block U+1AB0-1AFF (31 combining marks).
#
# Categories:
#   - Combining doubled marks: marks that appear doubled
#   - Combining overlay marks: marks that overlay the base character
#   - Medieval manuscript marks: historical scribal abbreviations
#
# Zone assignments:
#   diacritic-above: y=0 to y=2 (above cap-height)
#   diacritic-below: y=8 to y=11 (below baseline into descender)
#   x-height: y=4 to y=8 (for through-marks, centered on base)
#
# All diacritics MUST define an `attach` anchor per Section 15.2.
#
# =============================================================================

# =============================================================================
# COMBINING DOUBLED CIRCUMFLEX ACCENT
# =============================================================================

# -----------------------------------------------------------------------------
# combining-doubled-circumflex-accent - Double hat shape above
# Unicode: U+1AB0 COMBINING DOUBLED CIRCUMFLEX ACCENT
# Used in medieval manuscripts
# -----------------------------------------------------------------------------
@elem combining-doubled-circumflex-accent
zone: diacritic-above
path: p1 p2 p3 p4 p5
p1 = [3,2]
p2 = [4,0]
p3 = [5,2]
p4 = [6,0]
p5 = [7,2]
close: false
width: 1
anchors: attach=[6,2]
@end

# =============================================================================
# COMBINING DIACRITICAL MARK (U+1AB1-1ABE)
# =============================================================================

# -----------------------------------------------------------------------------
# combining-diaeresis-ring - Diaeresis with ring
# Unicode: U+1AB1 COMBINING DIAERESIS-RING
# Medieval scribal mark
# -----------------------------------------------------------------------------
@elem combining-diaeresis-ring
zone: diacritic-above
path: p1 p2 p3 p4
p1 = [6,0]
p2 = C([8,0] [8,1])
p3 = C([8,2] [6,2])
p4 = C([4,2] [4,1])
close: true
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# combining-infinity - Infinity symbol above
# Unicode: U+1AB2 COMBINING INFINITY
# Medieval scribal mark
# -----------------------------------------------------------------------------
@elem combining-infinity
zone: diacritic-above
path: p1 p2 p3 p4 p5 p6
p1 = [3,1]
p2 = C([3,0] [4,0])
p3 = C([5,0] [6,1])
p4 = C([7,2] [8,2])
p5 = C([9,2] [9,1])
p6 = C([9,0] [8,0])
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# combining-downwards-arrow - Downward arrow above
# Unicode: U+1AB3 COMBINING DOWNWARDS ARROW
# Medieval scribal mark
# -----------------------------------------------------------------------------
@elem combining-downwards-arrow
zone: diacritic-above
path: p1 p2 p3 p4 p5
p1 = [6,0]
p2 = [6,2]
p3 = [5,1]
p4 = [6,2]
p5 = [7,1]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# combining-triple-dot - Three dots in triangle above
# Unicode: U+1AB4 COMBINING TRIPLE DOT
# Medieval scribal mark
# -----------------------------------------------------------------------------
@elem combining-triple-dot
zone: diacritic-above
path: p1 p2 p3 p4
p1 = [6,0]
p2 = C([6,0] [6,0])
p3 = C([6,0] [6,0])
p4 = C([6,0] [6,0])
close: true
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# combining-x-x-below - Double X below
# Unicode: U+1AB5 COMBINING X-X BELOW
# Medieval scribal mark
# -----------------------------------------------------------------------------
@elem combining-x-x-below
zone: diacritic-below
path: p1 p2
p1 = [4,9]
p2 = [6,11]
close: false
width: 1
anchors: attach=[6,8]
@end

# -----------------------------------------------------------------------------
# combining-wiggly-line-below - Wiggly line below
