p1 = [4,9]
p2 = C([4,11] [6,11])
p3 = C([8,11] [8,9])
close: false
width: 1
anchors: attach=[6,8]
@end

# -----------------------------------------------------------------------------
# combining-double-open-mark-below - Double open mark below
# Unicode: U+1AB8 COMBINING DOUBLE OPEN MARK BELOW
# Medieval scribal mark
# -----------------------------------------------------------------------------
@elem combining-double-open-mark-below
zone: diacritic-below
path: p1 p2 p3 p4 p5
p1 = [3,9]
p2 = C([3,10] [4,10])
p3 = C([5,10] [5,9])
p4 = C([6,10] [7,10])
p5 = C([8,10] [8,9])
close: false
width: 1
anchors: attach=[6,8]
@end

# -----------------------------------------------------------------------------
# combining-light-centralization-stroke-below - Light stroke below
# Unicode: U+1AB9 COMBINING LIGHT CENTRALIZATION STROKE BELOW
# IPA diacritic
# -----------------------------------------------------------------------------
@elem combining-light-centralization-stroke-below
