# Medieval scribal mark
# -----------------------------------------------------------------------------
@elem combining-wiggly-line-below
zone: diacritic-below
path: p1 p2 p3 p4 p5
p1 = [3,10]
p2 = [4,9]
p3 = [5,10]
p4 = [6,9]
p5 = [7,10]
close: false
width: 1
anchors: attach=[6,8]
@end

# -----------------------------------------------------------------------------
# combining-open-mark-below - Open mark below
# Unicode: U+1AB7 COMBINING OPEN MARK BELOW
# Medieval scribal mark
# -----------------------------------------------------------------------------
@elem combining-open-mark-below
zone: diacritic-below
