p1 = [4,0]
p2 = C([3,1] [4,2])
p3 = [4,2]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# combining-parentheses-below - Parentheses below
# Unicode: U+1ABD COMBINING PARENTHESES BELOW
# Medieval scribal mark
# -----------------------------------------------------------------------------
@elem combining-parentheses-below
zone: diacritic-below
path: p1 p2 p3
p1 = [5,9]
p2 = C([4,10] [5,11])
p3 = [5,11]
close: false
width: 1
anchors: attach=[6,8]
@end

# -----------------------------------------------------------------------------
# combining-parentheses-overlay - Parentheses overlay
# Unicode: U+1ABE COMBINING PARENTHESES OVERLAY
# Combines parentheses through base character
# -----------------------------------------------------------------------------
@elem combining-parentheses-overlay
zone: x-height
path: p1 p2 p3
p1 = [4,4]
p2 = C([3,6] [4,8])
p3 = [4,8]
close: false
width: 1
anchors: attach=[6,6]
@end

