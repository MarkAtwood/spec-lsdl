@end

# -----------------------------------------------------------------------------
# combining-parentheses-above - Parentheses above
# Unicode: U+1ABB COMBINING PARENTHESES ABOVE
# Medieval scribal mark
# -----------------------------------------------------------------------------
@elem combining-parentheses-above
zone: diacritic-above
path: p1 p2 p3
p1 = [5,0]
p2 = C([4,1] [5,2])
p3 = [5,2]
close: false
width: 1
anchors: attach=[6,2]
@end

# -----------------------------------------------------------------------------
# combining-double-parentheses-above - Double parentheses above
# Unicode: U+1ABC COMBINING DOUBLE PARENTHESES ABOVE
# Medieval scribal mark
# -----------------------------------------------------------------------------
@elem combining-double-parentheses-above
zone: diacritic-above
