@lsdl 1.0

# Transforms test: sc, sh, sk operators and @style blocks

# ============================================================
# Element Definitions
# ============================================================

@elem stem
zone: x-height
path: p1 p2
p1 = [6,4]
p2 = [6,8]
width: 1
anchors: top=[6,4] base=[6,8] mid=[6,6]
  mark-above=[6,3] mark-below=[6,9]
@end

@elem bowl
zone: x-height
path: p1 p2 p3 p4
p1 = [6,4]
p2 = C([12,4] [12,8])
p3 = [6,8]
p4 = C([0,8] [0,4])
close: true
width: 1
anchors: attach=[6,6] mark-above=[6,3] mark-below=[6,9]
@end

@elem ascender
zone: ascender
path: p1 p2
p1 = [6,1]
p2 = [6,8]
width: 1
anchors: top=[6,1] base=[6,8] mid=[6,4]
  mark-above=[6,0] mark-below=[6,9]
@end

@elem bowl.r
zone: x-height
path: p1 p2 p3
p1 = [6,4]
p2 = C([12,4] [12,8])
p3 = [6,8]
close: true
width: 1
anchors: attach=[6,6] mark-above=[8,3] mark-below=[8,9]
@end

@elem bowl.l
zone: x-height
path: p1 p2 p3
p1 = [6,4]
p2 = C([0,4] [0,8])
p3 = [6,8]
close: true
width: 1
anchors: attach=[6,6] mark-above=[4,3] mark-below=[4,9]
@end

@elem crossbar
zone: x-height
path: p1 p2
p1 = [2,6]
p2 = [10,6]
width: 1
anchors: left=[2,6] right=[10,6] mid=[6,6]
@end

@elem arc.top
zone: x-height
path: p1 p2 p3
p1 = [10,6]
p2 = C([10,4] [6,4])
p3 = [2,6]
width: 1
anchors: left=[2,6] right=[10,6] top=[6,4]
@end

@elem arc.bot
zone: x-height
path: p1 p2 p3
p1 = [2,6]
p2 = C([2,8] [6,8])
p3 = [10,8]
width: 1
anchors: left=[2,6] right=[10,8] base=[6,8]
@end

@elem dot
zone: x-height
path: p1
p1 = [6,6]
width: 1
anchors: attach=[6,6]
@end

@elem shoulder
zone: x-height
path: p1 p2 p3
p1 = [2,4]
p2 = C([2,8] [6,8])
p3 = [10,8]
width: 1
anchors: attach=[2,4] top=[2,4] base=[10,8]
@end

@elem acute
zone: diacritic-above
path: p1 p2
p1 = [5,1]
p2 = [7,0]
width: 1
anchors: attach=[6,2]
@end

# ============================================================
# Style Blocks
# ============================================================

# Italic style - applies horizontal skew
@style italic
transform: sk(*, kx=2, ky=0)
@end

# Bold approximation - scales up
@style bold
transform: sc(*, sx=14, sy=12)
@end

# Condensed style - horizontally compressed
@style condensed
transform: sc(*, sx=9, sy=12)
@end

# Extended style - horizontally expanded
@style extended
transform: sc(*, sx=15, sy=12)
@end

# Compound style: italic + condensed
@style italic-condensed
transform: sk(sc(*, sx=9, sy=12), kx=2, ky=0)
@end

# Compound style: bold + extended
@style bold-extended
transform: sc(sc(*, sx=15, sy=12), sx=14, sy=12)
@end

# Superscript style
@style superscript
transform: sh(sc(*, sx=8, sy=8), dx=2, dy=-4)
@end

# Subscript style
@style subscript
transform: sh(sc(*, sx=8, sy=8), dx=2, dy=4)
@end

# ============================================================
# Base Characters
# ============================================================

a  LATIN-SMALL-A = LR(bowl.l, stem, 8/4) script:Latn
b  LATIN-SMALL-B = STACK(ascender, bowl.r) script:Latn
e  LATIN-SMALL-E = FRAME(arc.top, crossbar, arc.bot) script:Latn
n  LATIN-SMALL-N = LR(stem, shoulder, 4/8) script:Latn
o  LATIN-SMALL-O = bowl script:Latn

# ============================================================
# sc (Scale) Transform Examples - as @elem blocks
# ============================================================

# Scaled down bowl (2/3 size)
@elem o.small
build: from_expr
sc(bowl, sx=8, sy=8)
@end

# Scaled up bowl (150%)
@elem o.large
build: from_expr
sc(bowl, sx=18, sy=18)
@end

# Horizontally condensed
@elem o.narrow
build: from_expr
sc(bowl, sx=8, sy=12)
@end

# Vertically condensed
@elem o.flat
build: from_expr
sc(bowl, sx=12, sy=8)
@end

# Non-uniform scaling
@elem o.stretched
build: from_expr
sc(bowl, sx=16, sy=10)
@end

# ============================================================
# sh (Shift) Transform Examples
# ============================================================

# Shifted dot (for tittle position)
@elem dot.raised
build: from_expr
sh(dot, dx=0, dy=-2)
@end

# Shifted to the right
@elem dot.right
build: from_expr
sh(dot, dx=3, dy=0)
@end

# Shifted down and left
@elem dot.lowleft
build: from_expr
sh(dot, dx=-2, dy=2)
@end

# Negative shift
@elem dot.upleft
build: from_expr
sh(dot, dx=-2, dy=-3)
@end

# ============================================================
# sk (Skew) Transform Examples
# ============================================================

# Italic lean (standard)
@elem o.italic
build: from_expr
sk(bowl, kx=2, ky=0)
@end

# Reverse italic
@elem o.backslant
build: from_expr
sk(bowl, kx=-2, ky=0)
@end

# Vertical skew
@elem o.vskew
build: from_expr
sk(bowl, kx=0, ky=1)
@end

# Combined horizontal and vertical skew
@elem o.doubleskew
build: from_expr
sk(bowl, kx=1, ky=1)
@end

# ============================================================
# Nested Transforms
# ============================================================

# Scale then shift
@elem o.scaledshifted
build: from_expr
sh(sc(bowl, sx=8, sy=8), dx=2, dy=-2)
@end

# Scale then skew (italic small)
@elem o.smallitalic
build: from_expr
sk(sc(bowl, sx=9, sy=9), kx=2, ky=0)
@end

# All three transforms
@elem o.complex
build: from_expr
sh(sk(sc(bowl, sx=10, sy=10), kx=1, ky=0), dx=1, dy=-1)
@end

# Deeply nested
@elem o.deep
build: from_expr
sc(sh(sk(sc(bowl, sx=10, sy=10), kx=1, ky=0), dx=1, dy=0), sx=11, sy=11)
@end

# ============================================================
# Transforms on Compositions
# ============================================================

# Italic b (composition with skew)
@elem b.italic
build: from_expr
sk(STACK(ascender, bowl.r), kx=2, ky=0)
@end

# Scaled composition
@elem e.small
build: from_expr
sc(FRAME(arc.top, crossbar, arc.bot), sx=8, sy=8)
@end

# Shifted composition
@elem n.shifted
build: from_expr
sh(LR(stem, shoulder, 4/8), dx=1, dy=0)
@end

# Transform on DIA composition
@elem eacuteitalic
build: from_expr
sk(DIA(e, acute), kx=2, ky=0)
@end

# ============================================================
# Boundary Value Tests (Parameter Limits)
# ============================================================

# Maximum positive values
@elem o.maxscale
build: from_expr
sc(bowl, sx=24, sy=24)
@end

# Minimum (negative) values
@elem o.shiftedfar
build: from_expr
sh(bowl, dx=-12, dy=-12)
@end

# Zero scale axis (degenerate)
@elem o.flatzero
build: from_expr
sc(bowl, sx=12, sy=1)
@end

# Maximum skew
@elem o.maxskew
build: from_expr
sk(bowl, kx=24, ky=0)
@end

# Negative skew boundary
@elem o.negskew
build: from_expr
sk(bowl, kx=-12, ky=-12)
@end
